---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

const items = [
  {
    title: 'WHO WE ARE',
    description: 'We are the first IEEE Nanotechnology Council Student Branch in Ecuador, driven by curiosity and passion for science.',
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`
  },
  {
    title: 'OUR MISSION',
    description: 'To promote nanotechnology education, interdisciplinary research, and community service across Latin America.',
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>`
  },
  {
    title: 'OUR VISION',
    description: 'To be a leading student chapter in nanotechnology innovation, academic publications, and scientific outreach.',
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`
  },
  {
    title: 'OUR GOALS',
    description: 'Inspire, connect, and empower students to solve global technological challenges through nanoscale engineering.',
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg>`
  },
  {
    title: 'OUR COMMUNITY',
    description: 'A diverse and passionate community driving scientific change together across Yachay Tech and IEEE Region 9.',
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>`
  }
];
---

<section class="summary-section" aria-label="Institutional Summary">
  <div class="container">
    <div class="summary-grid">
      {items.map((item) => (
        <a href={getHref('/about/')} class="summary-card">
          <div class="icon-wrapper" set:html={item.icon} />
          <h3 class="summary-title">{item.title}</h3>
          <p class="summary-desc">{item.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .summary-section {
    background-color: var(--color-white);
    padding: 3rem 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }

  .summary-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.25rem 0.85rem;
    text-decoration: none;
    color: inherit;
    border-right: 1px solid var(--color-border-light);
    transition: transform 0.2s ease, background-color 0.2s ease;
    border-radius: var(--border-radius-sm);
  }

  .summary-card:last-child {
    border-right: none;
  }

  .summary-card:hover {
    background-color: var(--color-bg-light);
    transform: translateY(-2px);
  }

  .icon-wrapper {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: rgba(5, 135, 189, 0.1);
    color: var(--color-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .summary-card:hover .icon-wrapper {
    background-color: var(--color-cyan);
    color: var(--color-white);
  }

  .summary-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: var(--color-navy);
    letter-spacing: 0.5px;
    margin-bottom: 0.5rem;
  }

  .summary-desc {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  @media (max-width: 1024px) {
    .summary-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .summary-card {
      border-right: none;
      border-bottom: 1px solid var(--color-border-light);
    }
  }

  @media (max-width: 640px) {
    .summary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
