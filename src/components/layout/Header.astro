---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const ntcLogo = `${baseUrl}/assets/logos/ieee-ntc-official-trimmed.png`;

function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

function isActive(path: string) {
  const normalizedCurrent = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
  if (path === '/' && (normalizedCurrent === '/' || normalizedCurrent === `${baseUrl}/`)) return true;
  return path !== '/' && normalizedCurrent.includes(path);
}

const navLinks = [
  { name: 'Home', path: '/' },
  { name: 'About Us', path: '/about/' },
  { name: 'Directive', path: '/directive/' },
  { 
    name: 'Activities', 
    path: '/events/', 
    hasDropdown: true,
    dropdownItems: [
      { name: 'Upcoming Events', path: '/events/#upcoming' },
      { name: 'Past Events', path: '/events/#past' },
      { name: 'Calendar View', path: '/events/#calendar' }
    ]
  },
  { name: 'Projects', path: '/projects/' },
  { name: 'Opportunities', path: '/opportunities/' },
  { name: 'Gallery', path: '/gallery/' },
  { name: 'News', path: '/news/' },
  { name: 'Contact', path: '/contact/' }
];
---

<header class="site-header" id="main-header">
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <div class="site-container header-inner">
    <!-- Geometric White Logo Panel using Extracted Official NTC Logo -->
    <a
      class="brand-panel"
      href={getHref('/')}
      aria-label="IEEE Nanotechnology Council Yachay Tech Home"
    >
      <span class="brand-panel__surface">
        <img
          class="brand-panel__logo"
          src={ntcLogo}
          alt="IEEE Nanotechnology Council"
          width="420"
          height="112"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </span>

      <span
        class="brand-panel__accent"
        aria-hidden="true"
      ></span>
    </a>

    <!-- Primary Navigation Bar -->
    <nav class="desktop-navigation" aria-label="Primary navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li class={`nav-item ${link.hasDropdown ? 'has-dropdown' : ''}`}>
            {link.hasDropdown ? (
              <div class="dropdown-wrapper">
                <a 
                  href={getHref(link.path)} 
                  class="nav-link"
                  aria-current={isActive(link.path) ? 'page' : undefined}
                  aria-expanded="false"
                  aria-haspopup="true"
                  id="events-dropdown-btn"
                >
                  {link.name}
                  <svg class="dropdown-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                    <path d="M7 10l5 5 5-5z" fill="currentColor"/>
                  </svg>
                </a>
                <ul class="dropdown-menu" aria-labelledby="events-dropdown-btn" role="menu">
                  {link.dropdownItems?.map((item) => (
                    <li role="none">
                      <a href={getHref(item.path)} class="dropdown-item" role="menuitem">
                        {item.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <a 
                href={getHref(link.path)} 
                class="nav-link"
                aria-current={isActive(link.path) ? 'page' : undefined}
              >
                {link.name}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button 
      class="mobile-menu-toggle" 
      id="mobile-toggle-btn" 
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav-drawer"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-drawer" id="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-drawer-header">
      <img src={ntcLogo} alt="IEEE NTC Logo" width="240" height="60" />
      <button class="mobile-close-btn" id="mobile-close-btn" aria-label="Close navigation menu">
        &times;
      </button>
    </div>

    <nav class="mobile-nav" aria-label="Mobile Navigation">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => (
          <li class="mobile-nav-item">
            <a href={getHref(link.path)} class="mobile-nav-link">
              {link.name}
            </a>
            {link.hasDropdown && (
              <ul class="mobile-subnav-list">
                {link.dropdownItems?.map((item) => (
                  <li>
                    <a href={getHref(item.path)} class="mobile-subnav-link">
                      • {item.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    height: 74px;
    min-height: 74px;
    background: #061b31;
    border-bottom: 1px solid #0587bd;
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 9999;
    padding: 10px 16px;
    background: #ffffff;
    color: #071c34;
    border: 2px solid #0587bd;
    transform: translateY(-160%);
    transition: transform 160ms ease;
    font-weight: 700;
    text-decoration: none;
    border-radius: 4px;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .header-inner {
    height: 74px;
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 2vw, 48px);
  }

  /* Geometric White Logo Panel & Accent */
  .brand-panel {
    position: relative;
    display: block;
    flex: 0 0 360px;
    width: 360px;
    height: 68px;
    text-decoration: none;
  }

  .brand-panel__surface {
    position: absolute;
    inset: 0 15px 0 0;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 8px 58px 8px 20px;
    background: #ffffff;
    clip-path: polygon(
      0 0,
      100% 0,
      calc(100% - 28px) 100%,
      0 100%
    );
  }

  .brand-panel__accent {
    position: absolute;
    top: 0;
    right: 0;
    width: 34px;
    height: 68px;
    background: #0587bd;
    clip-path: polygon(
      45% 0,
      100% 0,
      55% 100%,
      0 100%
    );
  }

  .brand-panel__logo {
    display: block;
    width: 275px;
    max-width: 100%;
    height: 50px;
    object-fit: contain;
    object-position: left center;
  }

  /* Desktop Navigation */
  .desktop-navigation {
    min-width: 0;
    display: flex;
    justify-content: flex-end;
  }

  .nav-list {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(14px, 1.4vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-item {
    display: flex;
    align-items: center;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    min-height: 44px;
    color: #ffffff;
    font-family: "Open Sans", var(--font-body);
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #0587bd;
  }

  .nav-link[aria-current="page"] {
    color: #0587bd;
  }

  .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 2px;
    background: #0587bd;
    border-radius: 1px;
  }

  /* Dropdown Menu */
  .has-dropdown {
    position: relative;
  }

  .dropdown-wrapper {
    position: relative;
  }

  .dropdown-icon {
    transition: transform 0.2s ease;
  }

  .has-dropdown:hover .dropdown-icon,
  .has-dropdown:focus-within .dropdown-icon {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    min-width: 210px;
    background-color: #061b31;
    border: 1px solid rgba(5, 135, 189, 0.35);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    list-style: none;
    padding: 0.5rem 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    z-index: 1100;
  }

  .has-dropdown:hover .dropdown-menu,
  .has-dropdown:focus-within .dropdown-menu,
  .dropdown-menu.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(4px);
  }

  .dropdown-item {
    display: block;
    padding: 0.6rem 1.2rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .dropdown-item:hover,
  .dropdown-item:focus {
    background-color: #0587bd;
    color: #ffffff;
  }

  /* Mobile Toggle & Drawer */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 32px;
    height: 22px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1050;
    justify-self: end;
  }

  .hamburger-bar {
    width: 100%;
    height: 3px;
    background-color: #ffffff;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 300px;
    max-width: 85vw;
    height: 100vh;
    background-color: #061b31;
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.5);
    z-index: 2000;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-drawer.open {
    transform: translateX(0);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mobile-close-btn {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 2.2rem;
    line-height: 1;
    cursor: pointer;
  }

  .mobile-nav {
    padding: 1.5rem;
    overflow-y: auto;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0;
    margin: 0;
  }

  .mobile-nav-link {
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    display: block;
    transition: color 0.2s ease;
  }

  .mobile-nav-link:hover {
    color: #0587bd;
  }

  .mobile-subnav-list {
    list-style: none;
    padding-left: 1rem;
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-subnav-link {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    text-decoration: none;
  }

  /* Responsive Breakpoint: 1140px & Mobile */
  @media (max-width: 1140px) {
    .desktop-navigation {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .brand-panel {
      width: 235px;
      height: 56px;
      flex-basis: 235px;
    }

    .brand-panel__logo {
      width: 180px;
      height: 41px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileBtn = document.getElementById('mobile-toggle-btn');
    const mobileDrawer = document.getElementById('mobile-nav-drawer');
    const mobileClose = document.getElementById('mobile-close-btn');

    function openMobileMenu() {
      mobileDrawer?.classList.add('open');
      mobileDrawer?.setAttribute('aria-hidden', 'false');
      mobileBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
      mobileDrawer?.classList.remove('open');
      mobileDrawer?.setAttribute('aria-hidden', 'true');
      mobileBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    mobileBtn?.addEventListener('click', openMobileMenu);
    mobileClose?.addEventListener('click', closeMobileMenu);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMobileMenu();
      }
    });
  });
</script>
