---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const ntcLogo = `${baseUrl}/assets/logos/ieee-ntc-official-trimmed.png`;

function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

function isActive(path: string) {
  const normalizedCurrent = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
  if (path === '/' && (normalizedCurrent === '/' || normalizedCurrent === `${baseUrl}/`)) return true;
  return path !== '/' && normalizedCurrent.includes(path);
}

const navLinks = [
  { name: 'Inicio', path: '/' },
  { 
    name: 'Nosotros', 
    path: '/about/', 
    hasDropdown: true,
    dropdownItems: [
      { name: 'Sobre Nosotros', path: '/about/' },
      { name: 'Directiva Fundadora', path: '/directive/' }
    ]
  },
  { 
    name: 'Actividades', 
    path: '/events/', 
    hasDropdown: true,
    dropdownItems: [
      { name: 'Próximos Eventos', path: '/events/#upcoming' },
      { name: 'Eventos Pasados', path: '/events/#past' },
      { name: 'Calendario', path: '/events/#calendar' }
    ]
  },
  { name: 'Proyectos', path: '/projects/' },
  { name: 'Oportunidades', path: '/opportunities/' },
  { 
    name: 'Medios', 
    path: '/gallery/', 
    hasDropdown: true,
    dropdownItems: [
      { name: 'Galería de Fotos', path: '/gallery/' },
      { name: 'Noticias y Prensa', path: '/news/' }
    ]
  },
  { name: 'Contacto', path: '/contact/' }
];
---

<header class="site-header" id="main-header">
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  <div class="site-container header-inner">
    <!-- Geometric White Logo Panel with Exact Parallel Slant & Cyan Accent -->
    <a
      class="brand-panel"
      href={getHref('/')}
      aria-label="IEEE Nanotechnology Council Yachay Tech Inicio"
    >
      <svg class="brand-panel__bg" viewBox="0 0 760 74" preserveAspectRatio="none" aria-hidden="true">
        <!-- White surface from 0 up to 700px at top, slanting 30px to 670px at bottom -->
        <polygon points="0,0 700,0 670,74 0,74" fill="#ffffff" />
        <!-- Cyan accent stripe with exact 6px gap (706-718 at top, 676-688 at bottom) -->
        <polygon points="706,0 718,0 688,74 676,74" fill="#0587bd" />
      </svg>

      <span class="brand-panel__logo-wrapper">
        <img
          class="brand-panel__logo"
          src={ntcLogo}
          alt="IEEE Nanotechnology Council"
          width="420"
          height="112"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </span>
    </a>

    <!-- Primary Navigation Bar (Clean, Spaced & Uncluttered) -->
    <nav class="desktop-navigation" aria-label="Navegación principal">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li class={`nav-item ${link.hasDropdown ? 'has-dropdown' : ''}`}>
            {link.hasDropdown ? (
              <div class="dropdown-wrapper">
                <a 
                  href={getHref(link.path)} 
                  class="nav-link"
                  aria-current={isActive(link.path) ? 'page' : undefined}
                  aria-expanded="false"
                  aria-haspopup="true"
                  id={`dropdown-${link.name.toLowerCase()}`}
                >
                  <span>{link.name}</span>
                  <svg class="dropdown-icon" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
                    <path d="M7 10l5 5 5-5z" fill="currentColor"/>
                  </svg>
                </a>
                <ul class="dropdown-menu" aria-labelledby={`dropdown-${link.name.toLowerCase()}`} role="menu">
                  {link.dropdownItems?.map((item) => (
                    <li role="none">
                      <a href={getHref(item.path)} class="dropdown-item" role="menuitem">
                        {item.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <a 
                href={getHref(link.path)} 
                class="nav-link"
                aria-current={isActive(link.path) ? 'page' : undefined}
              >
                <span>{link.name}</span>
              </a>
            )}
          </li>
        ))}
      </ul>

      <!-- Language Selector Pill (Desktop) -->
      <div class="lang-switcher" id="lang-switcher-desktop">
        <button class="lang-btn active" data-lang="es" aria-label="Cambiar idioma a Español">ES</button>
        <span class="lang-divider">|</span>
        <button class="lang-btn" data-lang="en" aria-label="Switch language to English">EN</button>
      </div>
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button 
      class="mobile-menu-toggle" 
      id="mobile-toggle-btn" 
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-nav-drawer"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-drawer" id="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-drawer-header">
      <img src={ntcLogo} alt="IEEE NTC Logo" width="240" height="60" />
      <button class="mobile-close-btn" id="mobile-close-btn" aria-label="Cerrar menú de navegación">
        &times;
      </button>
    </div>

    <!-- Language Selector Pill (Mobile) -->
    <div class="mobile-lang-box">
      <span class="mobile-lang-title">Idioma / Language:</span>
      <div class="lang-switcher" id="lang-switcher-mobile">
        <button class="lang-btn active" data-lang="es" aria-label="Español">ES</button>
        <span class="lang-divider">|</span>
        <button class="lang-btn" data-lang="en" aria-label="English">EN</button>
      </div>
    </div>

    <nav class="mobile-nav" aria-label="Navegación Móvil">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => (
          <li class="mobile-nav-item">
            <a href={getHref(link.path)} class="mobile-nav-link">
              {link.name}
            </a>
            {link.hasDropdown && (
              <ul class="mobile-subnav-list">
                {link.dropdownItems?.map((item) => (
                  <li>
                    <a href={getHref(item.path)} class="mobile-subnav-link">
                      • {item.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    height: 74px;
    min-height: 74px;
    background: #061b31;
    border-bottom: 1px solid #0587bd;
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .skip-link {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 9999;
    padding: 10px 16px;
    background: #ffffff;
    color: #071c34;
    border: 2px solid #0587bd;
    transform: translateY(-160%);
    transition: transform 160ms ease;
    font-weight: 700;
    text-decoration: none;
    border-radius: 4px;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .header-inner {
    height: 74px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(16px, 2.5vw, 40px);
    width: 100%;
  }

  /* Geometric White Logo Panel with Exact Parallel Slant & Cyan Accent */
  .brand-panel {
    position: relative;
    display: flex;
    align-items: center;
    flex: 0 0 310px;
    width: 310px;
    height: 74px;
    text-decoration: none;
    overflow: visible;
  }

  .brand-panel__bg {
    position: absolute;
    top: 0;
    left: -450px;
    width: 760px;
    height: 74px;
    pointer-events: none;
    z-index: 1;
    display: block;
  }

  .brand-panel__logo-wrapper {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    height: 74px;
    padding-left: 10px;
  }

  .brand-panel__logo {
    display: block;
    width: 215px;
    max-width: 100%;
    height: 48px;
    object-fit: contain;
    object-position: left center;
  }

  /* Desktop Navigation */
  .desktop-navigation {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex: 1;
    gap: clamp(12px, 1.8vw, 24px);
  }

  /* Language Switcher Pill Widget */
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    background: rgba(7, 28, 52, 0.85);
    border: 1px solid rgba(5, 135, 189, 0.45);
    border-radius: 18px;
    padding: 3px 6px;
    gap: 4px;
    flex-shrink: 0;
  }

  .lang-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    padding: 2px 7px;
    border-radius: 12px;
    transition: all 0.2s ease;
    font-family: inherit;
    line-height: 1.2;
  }

  .lang-btn:hover {
    color: #ffffff;
  }

  .lang-btn.active {
    background-color: #0587bd;
    color: #ffffff;
    box-shadow: 0 0 8px rgba(5, 135, 189, 0.5);
  }

  .lang-divider {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.72rem;
    user-select: none;
  }

  .mobile-lang-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid rgba(5, 135, 189, 0.2);
    margin-bottom: 8px;
  }

  .mobile-lang-title {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 600;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(6px, 1.2vw, 18px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 8px 10px;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
    transition: color 150ms ease;
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: #0587bd;
    border-bottom-color: #0587bd;
  }

  .dropdown-wrapper {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 210px;
    background-color: #061b31;
    border: 1px solid rgba(5, 135, 189, 0.5);
    border-radius: 8px;
    padding: 8px 0;
    list-style: none;
    margin: 0;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms;
    z-index: 1100;
    backdrop-filter: blur(8px);
  }

  .dropdown-wrapper:hover .dropdown-menu,
  .dropdown-wrapper:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-item {
    display: block;
    padding: 9px 18px;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.84rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .dropdown-item:hover {
    background-color: rgba(5, 135, 189, 0.2);
    color: #0587bd;
  }

  .dropdown-icon {
    transition: transform 150ms ease;
  }

  .dropdown-wrapper:hover .dropdown-icon {
    transform: rotate(180deg);
  }

  /* Mobile Menu Toggle */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 10;
  }

  .hamburger-bar {
    width: 100%;
    height: 3px;
    background-color: #ffffff;
    border-radius: 2px;
    transition: all 150ms ease;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: -100%;
    width: 300px;
    height: 100vh;
    background-color: #061b31;
    z-index: 2000;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition: right 300ms cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.5);
    overflow-y: auto;
  }

  .mobile-drawer.is-open {
    right: 0;
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(5, 135, 189, 0.3);
  }

  .mobile-drawer-header img {
    background: #ffffff;
    padding: 4px 8px;
    border-radius: 4px;
    height: 38px;
    width: auto;
  }

  .mobile-close-btn {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mobile-nav-link {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.98rem;
    font-weight: 600;
    display: block;
    padding: 6px 0;
  }

  .mobile-subnav-list {
    list-style: none;
    padding-left: 16px;
    margin: 4px 0 8px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mobile-subnav-link {
    color: #0587bd;
    text-decoration: none;
    font-size: 0.86rem;
  }

  @media (max-width: 1024px) {
    .desktop-navigation {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .brand-panel {
      width: 250px;
      flex: 0 0 250px;
    }

    .brand-panel__logo {
      width: 175px;
      height: 38px;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-toggle-btn');
  const closeBtn = document.getElementById('mobile-close-btn');
  const drawer = document.getElementById('mobile-nav-drawer');

  function openMenu() {
    drawer?.classList.add('is-open');
    drawer?.setAttribute('aria-hidden', 'false');
    toggleBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    drawer?.classList.remove('is-open');
    drawer?.setAttribute('aria-hidden', 'true');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggleBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
</script>
