---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const ntcLogoLight = `${baseUrl}/assets/logos/ieee-ntc-yachay-light.png`;
const ntcLogoDark = `${baseUrl}/assets/logos/ieee-ntc-yachay-dark.png`;

function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

function isActive(path: string) {
  const normalizedCurrent = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
  if (path === '/' && (normalizedCurrent === '/' || normalizedCurrent === `${baseUrl}/`)) return true;
  return path !== '/' && normalizedCurrent.includes(path);
}

const navLinks = [
  { name: 'Home', path: '/' },
  { 
    name: 'About', 
    path: '/about/', 
    hasDropdown: true,
    dropdownItems: [
      { name: 'About Us', path: '/about/' },
      { name: 'Founding Board', path: '/directive/' }
    ]
  },
  { 
    name: 'Activities', 
    path: '/events/', 
    hasDropdown: true,
    dropdownItems: [
      { name: 'Upcoming Events', path: '/events/#upcoming' },
      { name: 'Past Events', path: '/events/#past' },
      { name: 'Academic Calendar', path: '/events/#calendar' }
    ]
  },
  { name: 'Projects', path: '/projects/' },
  { name: 'Opportunities', path: '/opportunities/' },
  { 
    name: 'Media', 
    path: '/gallery/', 
    hasDropdown: true,
    dropdownItems: [
      { name: 'Photo Gallery', path: '/gallery/' },
      { name: 'News & Press', path: '/news/' }
    ]
  },
  { name: 'Contact', path: '/contact/' }
];
---

<header class="site-header" id="main-header">
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <div class="site-container header-inner">
    <!-- Geometric Logo Panel with Exact Parallel Slant & Cyan Accent -->
    <a
      class="brand-panel"
      href={getHref('/')}
      aria-label="IEEE Nanotechnology Council Yachay Tech Home"
    >
      <svg class="brand-panel__bg" viewBox="0 0 760 74" preserveAspectRatio="none" aria-hidden="true">
        <!-- Surface polygon: white in light mode, deep space navy in dark mode -->
        <polygon points="0,0 700,0 670,74 0,74" fill="#ffffff" />
        <!-- Cyan accent stripe with exact 6px gap (706-718 at top, 676-688 at bottom) -->
        <polygon points="706,0 718,0 688,74 676,74" fill="#0587bd" />
      </svg>

      <span class="brand-panel__logo-wrapper">
        <img
          class="brand-panel__logo brand-panel__logo-light"
          src={ntcLogoLight}
          alt="IEEE Nanotechnology Council Yachay Tech"
          width="420"
          height="112"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <img
          class="brand-panel__logo brand-panel__logo-dark"
          src={ntcLogoDark}
          alt="IEEE Nanotechnology Council Yachay Tech"
          width="420"
          height="112"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </span>
    </a>

    <!-- Primary Navigation Bar (Clean, Spaced & Uncluttered) -->
    <nav class="desktop-navigation" aria-label="Primary navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li class={`nav-item ${link.hasDropdown ? 'has-dropdown' : ''}`}>
            {link.hasDropdown ? (
              <div class="dropdown-wrapper">
                <a 
                  href={getHref(link.path)} 
                  class="nav-link"
                  aria-current={isActive(link.path) ? 'page' : undefined}
                  aria-expanded="false"
                  aria-haspopup="true"
                  id={`dropdown-${link.name.toLowerCase()}`}
                >
                  <span>{link.name}</span>
                  <svg class="dropdown-icon" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
                    <path d="M7 10l5 5 5-5z" fill="currentColor"/>
                  </svg>
                </a>
                <ul class="dropdown-menu" aria-labelledby={`dropdown-${link.name.toLowerCase()}`} role="menu">
                  {link.dropdownItems?.map((item) => (
                    <li role="none">
                      <a href={getHref(item.path)} class="dropdown-item" role="menuitem">
                        {item.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <a 
                href={getHref(link.path)} 
                class="nav-link"
                aria-current={isActive(link.path) ? 'page' : undefined}
              >
                {link.name}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Animated Dark/Light Theme Switcher & Mobile Toggle) -->
    <div class="header-actions">
      <button 
        class="theme-toggle-btn" 
        id="theme-toggle-btn" 
        aria-label="Switch between dark and light mode"
        title="Toggle Dark / Light Theme"
      >
        <span class="theme-toggle-track">
          <!-- Sun Icon (Light Mode Active) -->
          <svg class="theme-icon sun-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <!-- Moon Icon (Dark Mode Active) -->
          <svg class="theme-icon moon-icon" viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span class="theme-toggle-thumb"></span>
        </span>
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button 
        class="mobile-menu-toggle" 
        id="mobile-toggle-btn" 
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-drawer" id="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-drawer-header">
      <img src={ntcLogoLight} alt="IEEE NTC Logo" width="240" height="60" class="mobile-logo-light" />
      <img src={ntcLogoDark} alt="IEEE NTC Logo" width="240" height="60" class="mobile-logo-dark" />
      <button class="mobile-close-btn" id="mobile-close-btn" aria-label="Close navigation menu">
        &times;
      </button>
    </div>

    <nav class="mobile-nav" aria-label="Mobile navigation">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => (
          <li class="mobile-nav-item">
            <a href={getHref(link.path)} class="mobile-nav-link">
              {link.name}
            </a>
            {link.hasDropdown && (
              <ul class="mobile-subnav-list">
                {link.dropdownItems?.map((item) => (
                  <li>
                    <a href={getHref(item.path)} class="mobile-subnav-link">
                      • {item.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: var(--color-cyan);
    color: #ffffff;
    padding: 0.5rem 1rem;
    font-weight: 700;
    z-index: 10000;
    border-radius: var(--border-radius-sm);
    transition: top 0.2s ease;
  }
  .skip-link:focus {
    top: 1rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background-color: var(--color-navy);
    box-shadow: var(--shadow-header);
    border-bottom: 2px solid var(--color-cyan);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  :global(html[data-theme="dark"]) .site-header {
    background-color: #071626;
    border-bottom: 2px solid #00A3E0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 74px;
    height: 74px;
    position: relative;
    padding-top: 0;
    padding-bottom: 0;
  }

  .brand-panel {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 74px;
    width: 440px;
    text-decoration: none;
    flex-shrink: 0;
    overflow: visible;
  }

  .brand-panel__bg {
    position: absolute;
    top: 0;
    left: -150px;
    width: 610px;
    height: 74px;
    z-index: 1;
    pointer-events: none;
  }

  .brand-panel__logo-wrapper {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    height: 100%;
    padding-left: 0;
    width: 100%;
  }

  .brand-panel__logo {
    display: block;
    height: 60px;
    width: auto;
    max-width: 380px;
    object-fit: contain;
  }

  .desktop-navigation {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.15rem;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.55rem 0.8rem;
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.2px;
    text-decoration: none;
    border-radius: var(--border-radius-sm);
    transition: color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: #ffffff;
    background-color: rgba(5, 135, 189, 0.25);
  }

  .nav-link[aria-current="page"] {
    color: var(--color-cyan);
    font-weight: 700;
  }

  .dropdown-wrapper {
    position: relative;
  }

  .dropdown-icon {
    transition: transform 0.2s ease;
  }

  .dropdown-wrapper:hover .dropdown-icon {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 210px;
    background-color: var(--color-navy);
    border: 1px solid var(--color-cyan);
    border-radius: var(--border-radius-sm);
    box-shadow: var(--shadow-hover);
    list-style: none;
    padding: 0.5rem 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.2s ease;
    z-index: 100;
  }

  .dropdown-wrapper:hover .dropdown-menu,
  .dropdown-wrapper:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-item {
    display: block;
    padding: 0.6rem 1.2rem;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .dropdown-item:hover {
    color: #ffffff;
    background-color: var(--color-cyan);
    padding-left: 1.4rem;
  }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    flex-direction: column;
    gap: 5px;
    z-index: 1001;
  }

  .hamburger-bar {
    width: 24px;
    height: 2.5px;
    background-color: #ffffff;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-drawer {
    display: none;
  }

  @media (max-width: 1080px) {
    .desktop-navigation {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .brand-panel {
      width: 320px;
    }

    .brand-panel__bg {
      width: 440px;
    }

    .brand-panel__logo {
      height: 48px;
      max-width: 260px;
    }

    .mobile-drawer {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      right: -100%;
      width: min(85vw, 360px);
      height: 100vh;
      background-color: var(--color-navy);
      border-left: 2px solid var(--color-cyan);
      box-shadow: -5px 0 25px rgba(0, 0, 0, 0.5);
      z-index: 2000;
      transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      padding: 1.5rem;
      overflow-y: auto;
    }

    .mobile-drawer.open {
      right: 0;
    }

    .mobile-drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      margin-bottom: 1.25rem;
    }

    .mobile-drawer-header img {
      max-height: 40px;
      width: auto;
      object-fit: contain;
    }

    .mobile-close-btn {
      background: none;
      border: none;
      color: #ffffff;
      font-size: 2rem;
      cursor: pointer;
      line-height: 1;
      padding: 0 0.5rem;
    }

    .mobile-nav-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .mobile-nav-link {
      display: block;
      color: #ffffff;
      font-size: 1.1rem;
      font-weight: 600;
      padding: 0.65rem 0.5rem;
      text-decoration: none;
      border-radius: var(--border-radius-sm);
      transition: background 0.2s ease, color 0.2s ease;
    }

    .mobile-nav-link:hover {
      background: rgba(5, 135, 189, 0.2);
      color: var(--color-cyan);
    }

    .mobile-subnav-list {
      list-style: none;
      padding: 0.25rem 0 0.5rem 1.25rem;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .mobile-subnav-link {
      display: block;
      color: rgba(255, 255, 255, 0.75);
      font-size: 0.95rem;
      text-decoration: none;
      padding: 0.35rem 0;
      transition: color 0.2s ease;
    }

    .mobile-subnav-link:hover {
      color: var(--color-cyan);
    }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    z-index: 10;
  }

  /* Animated Interactive Theme Mode Switcher */
  .theme-toggle-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    outline: none;
    user-select: none;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .theme-toggle-btn:hover {
    transform: scale(1.08);
  }

  .theme-toggle-btn:active {
    transform: scale(0.94);
  }

  .theme-toggle-track {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 58px;
    height: 30px;
    background: rgba(4, 96, 142, 0.35);
    border: 1.5px solid var(--color-cyan);
    border-radius: 20px;
    padding: 0 6px;
    position: relative;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.3), 0 0 10px rgba(5, 135, 189, 0.25);
    transition: background 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .theme-icon {
    z-index: 1;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.35s ease, color 0.35s ease;
  }

  .sun-icon {
    color: #ffd166;
    opacity: 1;
    transform: rotate(0deg) scale(1);
    filter: drop-shadow(0 0 4px rgba(255, 209, 102, 0.6));
  }

  .moon-icon {
    color: #94a3b8;
    opacity: 0.35;
    transform: rotate(-30deg) scale(0.85);
  }

  .theme-toggle-thumb {
    position: absolute;
    top: 3px;
    left: 4px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ffffff 0%, #e2e8f0 100%);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.35s ease, box-shadow 0.35s ease;
    z-index: 2;
  }

  /* Active Dark Mode Dynamic Animation Styles */
  :global(html[data-theme="dark"]) .theme-toggle-track {
    background: rgba(7, 28, 52, 0.85);
    border-color: #00A3E0;
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.6), 0 0 14px rgba(0, 163, 224, 0.45);
  }

  :global(html[data-theme="dark"]) .theme-toggle-thumb {
    transform: translateX(26px);
    background: linear-gradient(135deg, #0587bd 0%, #00A3E0 100%);
    box-shadow: 0 0 10px rgba(5, 135, 189, 0.7);
  }

  :global(html[data-theme="dark"]) .sun-icon {
    opacity: 0.3;
    transform: rotate(90deg) scale(0.75);
    color: #64748b;
    filter: none;
  }

  :global(html[data-theme="dark"]) .moon-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1.1);
    color: #ffffff;
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.9));
  }

  /* Logo Light & Dark Mode Visibility */
  .brand-panel__logo-light {
    display: block;
  }
  .brand-panel__logo-dark {
    display: none;
  }
  .mobile-logo-light {
    display: block;
    height: 48px;
    width: auto;
    object-fit: contain;
  }
  .mobile-logo-dark {
    display: none;
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  :global(html[data-theme="dark"]) .brand-panel__bg polygon:first-child {
    fill: #0c2340 !important;
  }
  :global(html[data-theme="dark"]) .brand-panel__logo-light {
    display: none !important;
  }
  :global(html[data-theme="dark"]) .brand-panel__logo-dark {
    display: block !important;
  }
  :global(html[data-theme="dark"]) .mobile-logo-light {
    display: none !important;
  }
  :global(html[data-theme="dark"]) .mobile-logo-dark {
    display: block !important;
  }

  @media (max-width: 480px) {
    .brand-panel {
      width: 250px;
    }
    .brand-panel__bg {
      width: 340px;
    }
    .brand-panel__logo {
      height: 40px;
      max-width: 200px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Mobile Drawer Toggle
    const toggleBtn = document.getElementById('mobile-toggle-btn');
    const closeBtn = document.getElementById('mobile-close-btn');
    const drawer = document.getElementById('mobile-nav-drawer');

    function openDrawer() {
      if (drawer) {
        drawer.classList.add('open');
        drawer.setAttribute('aria-hidden', 'false');
        toggleBtn?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeDrawer() {
      if (drawer) {
        drawer.classList.remove('open');
        drawer.setAttribute('aria-hidden', 'true');
        toggleBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    }

    toggleBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);

    // Close drawer when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (drawer && drawer.classList.contains('open')) {
        if (!drawer.contains(target) && !toggleBtn?.contains(target)) {
          closeDrawer();
        }
      }
    });

    // Close drawer on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer?.classList.contains('open')) {
        closeDrawer();
      }
    });

    // Animated Dark / Light Mode Switcher
    const themeBtn = document.getElementById('theme-toggle-btn');
    if (themeBtn) {
      function syncThemeButtonLabel() {
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        themeBtn?.setAttribute('aria-label', `Currently in ${currentTheme} mode. Click to switch.`);
      }

      syncThemeButtonLabel();

      themeBtn.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', nextTheme);
        localStorage.setItem('theme', nextTheme);
        syncThemeButtonLabel();
      });
    }
  });
</script>
