          <a href="https://instagram.com/ieee.ntc.yt" target="_blank" rel="noopener noreferrer">@ieee.ntc.yt</a>
        </li>
      </ul>
    </div>

    <!-- Column 5: Call to Action Badge -->
    <div class="footer-cta-badge">
      <div class="cta-badge-inner">
        <p class="badge-tag">BE PART OF THE FUTURE.</p>
        <p class="badge-title">BE PART OF IEEE NTC.</p>
        <a href={getHref('/contact/')} class="btn btn-primary badge-btn">
          JOIN US TODAY!
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <p class="copyright">
        © 2026 IEEE Nanotechnology Council – Yachay Tech University Branch. All rights reserved.
      </p>
      <div class="footer-legal">
        <a href={getHref('/about/')}>IEEE Identity</a>
        <span>•</span>
        <a href={getHref('/contact/')}>Terms & Privacy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-navy);
    color: var(--color-white);
    padding-top: 3.5rem;
    border-top: 4px solid var(--color-cyan);
    margin-top: auto;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.2fr 1.5fr;
    gap: 2rem;
    padding-bottom: 3rem;
  }

  .footer-logo-img {
    height: 48px;
    width: auto;
    margin-bottom: 1rem;
  }

  .footer-tagline {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.5;
    margin-bottom: 1.25rem;
    max-width: 320px;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--color-white);
    border-radius: 50%;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .social-icon:hover {
    background-color: var(--color-cyan);
    transform: translateY(-2px);
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    letter-spacing: 1px;
    color: var(--color-cyan);
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: flex-column;
    gap: 0.4rem;
  }

  .footer-list a {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-list a:hover {
    color: var(--color-cyan);
  }

  .contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .contact-list svg {
    color: var(--color-cyan);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .contact-list a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }

  .contact-list a:hover {
    color: var(--color-cyan);
  }

  /* CTA Badge box right */
  .footer-cta-badge {
    display: flex;
    align-items: center;
  }

  .cta-badge-inner {
    background: linear-gradient(145deg, rgba(5, 137, 189, 0.2) 0%, rgba(38, 64, 97, 0.6) 100%);
    border: 1px solid var(--color-cyan);
    border-radius: var(--border-radius-md);
    padding: 1.5rem;
    text-align: center;
    width: 100%;
  }

  .badge-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--color-cyan);
  }

  .badge-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-white);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .badge-btn {
    width: 100%;
    font-size: 0.85rem;
    padding: 0.6rem 1rem;
  }

  /* Footer Bottom */
  .footer-bottom {
    background-color: rgba(0, 0, 0, 0.3);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.25rem 0;
  }

  .footer-bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-legal {
    display: flex;
    gap: 0.5rem;
  }

  .footer-legal a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
  }

  .footer-legal a:hover {
    color: var(--color-cyan);
  }

  @media (max-width: 1024px) {
    .footer-container {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .footer-cta-badge {
      grid-column: span 3;
    }
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
    }
    .footer-cta-badge {
      grid-column: span 1;
    }
    .footer-bottom-container {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
