---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<footer class="site-footer">
  <div class="container footer-container">
    <!-- Column 1: Brand & Socials -->
    <div class="footer-brand">
      <a href={getHref('/')} class="footer-logo-link">
        <img src={getHref('/assets/logos/ieee_nano_logo.svg')} alt="IEEE Nanotechnology Council Yachay Tech Logo" width="320" height="60" class="footer-logo-img" />
      </a>
      <p class="footer-tagline">
        Empowering student innovation, research excellence, and technological leadership in nanotechnology at Yachay Tech University.
      </p>

      <div class="social-links" aria-label="Social Media Links">
        <a href="https://instagram.com/ieee.ntc.yt" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram">
