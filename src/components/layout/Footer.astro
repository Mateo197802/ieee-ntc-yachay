---
import { siteConfig } from '@/config/site';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<footer class="site-footer">
  <div class="site-container footer-main">
    <!-- Column 1: Identity & Brand Panel -->
    <div class="footer-column brand-column">
      <div class="footer-brand-panel-wrapper">
        <a href={getHref('/')} class="footer-brand-panel" aria-label="IEEE Nanotechnology Council Home">
          <img 
            src={getHref('/assets/logos/ieee-ntc-official-trimmed.png')} 
            alt="IEEE Nanotechnology Council Logo" 
            width="280" 
            height="50" 
            class="footer-logo-img" 
          />
        </a>
        <div class="footer-brand-cyan-accent" aria-hidden="true"></div>
      </div>

      <p class="footer-description">
        The IEEE Nanotechnology Council Student Chapter at Yachay Tech University connects students through nanotechnology education, research, innovation, and scientific outreach.
      </p>

      <div class="social-links-row" aria-label="Social Media Links">
        <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
      </div>
    </div>

    <!-- Column 2: Quick Links -->
    <div class="footer-column">
      <h3 class="footer-title">QUICK LINKS</h3>
      <ul class="footer-list">
        <li><a href={getHref('/')} class="footer-link">Home</a></li>
        <li><a href={getHref('/about/')} class="footer-link">About Us</a></li>
        <li><a href={getHref('/events/')} class="footer-link">Activities</a></li>
        <li><a href={getHref('/projects/')} class="footer-link">Projects</a></li>
        <li><a href={getHref('/opportunities/')} class="footer-link">Opportunities</a></li>
        <li><a href={getHref('/gallery/')} class="footer-link">Gallery</a></li>
        <li><a href={getHref('/news/')} class="footer-link">News</a></li>
        <li><a href={getHref('/directive/')} class="footer-link">Directive</a></li>
        <li><a href={getHref('/contact/')} class="footer-link">Contact</a></li>
      </ul>
    </div>

    <!-- Column 3: IEEE & Academic Resources -->
    <div class="footer-column">
      <h3 class="footer-title">IEEE & ACADEMIC RESOURCES</h3>
      <ul class="footer-list">
        <li>
          <a href={siteConfig.externalResources.ieeeNano} target="_blank" rel="noopener noreferrer" class="footer-link external-link">
            IEEE Nanotechnology Council
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" class="ext-icon" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6v2H5v12h12v-6h2v6c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z"/></svg>
          </a>
        </li>
        <li>
          <a href={siteConfig.externalResources.ieeeLananoOfficial} target="_blank" rel="noopener noreferrer" class="footer-link external-link">
            IEEE LANANO Official
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" class="ext-icon" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6v2H5v12h12v-6h2v6c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z"/></svg>
          </a>
        </li>
        <li>
          <a href={siteConfig.externalResources.ieeeXploreProceedings} target="_blank" rel="noopener noreferrer" class="footer-link external-link">
            IEEE Xplore Proceedings
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" class="ext-icon" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6v2H5v12h12v-6h2v6c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z"/></svg>
          </a>
        </li>
        <li>
          <a href={siteConfig.externalResources.yachayTech} target="_blank" rel="noopener noreferrer" class="footer-link external-link">
            Yachay Tech University
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" class="ext-icon" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6v2H5v12h12v-6h2v6c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z"/></svg>
          </a>
        </li>
        <li>
          <a href={siteConfig.externalResources.lananoProgram} target="_blank" rel="noopener noreferrer" class="footer-link external-link">
            IEEE LANANO 2026 Program
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" class="ext-icon" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6v2H5v12h12v-6h2v6c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z"/></svg>
          </a>
        </li>
      </ul>
    </div>

    <!-- Column 4: Contact Us -->
    <div class="footer-column footer-contact">
      <h3 class="footer-title">CONTACT US</h3>
      <ul class="footer-contact-list">
        <li class="contact-item">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" class="contact-icon" aria-hidden="true">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          <a href={`mailto:${siteConfig.email}`} class="email-link">{siteConfig.email}</a>
        </li>

        <li class="contact-item">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" class="contact-icon" aria-hidden="true">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
          <div class="address-text">
            <span>{siteConfig.location.institution}</span>
            <span>{siteConfig.location.city}, {siteConfig.location.country}</span>
          </div>
        </li>

        <li class="contact-item">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" class="contact-icon" aria-hidden="true">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="social-link">IEEE NTC Yachay Tech</a>
        </li>

        <li class="contact-item">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" class="contact-icon" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073z"/>
          </svg>
          <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" class="social-link">@ntc.yachaytech</a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom Integrated Copyright & Legal Bar -->
  <div class="footer-bottom">
    <div class="site-container footer-bottom-inner">
      <p class="copyright-text">
        © 2026 IEEE Nanotechnology Council — Yachay Tech University Student Chapter. All rights reserved.
      </p>
      <div class="legal-links">
        <a href={siteConfig.legal.accessibility} target="_blank" rel="noopener noreferrer">Accessibility</a>
        <span class="dot-sep">•</span>
        <a href={siteConfig.legal.nondiscrimination} target="_blank" rel="noopener noreferrer">Nondiscrimination Policy</a>
        <span class="dot-sep">•</span>
        <a href={siteConfig.legal.privacy} target="_blank" rel="noopener noreferrer">Privacy Policy</a>
        <span class="dot-sep">•</span>
        <a href={siteConfig.legal.terms} target="_blank" rel="noopener noreferrer">Terms & Disclosures</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    background-color: var(--color-navy);
    color: var(--color-white);
    border-top: 3px solid var(--color-cyan);
    margin-top: auto;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(270px, 1.25fr) minmax(140px, 0.65fr) minmax(220px, 1fr) minmax(240px, 1fr);
    column-gap: clamp(32px, 3.5vw, 72px);
    align-items: start;
    padding-block: 52px 46px;
  }

  .footer-column {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Column 1: Brand Panel */
  .footer-brand-panel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 18px;
  }

  .footer-brand-panel {
    position: relative;
    width: min(100%, 280px);
    height: 52px;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    padding: 6px 28px 6px 14px;
    clip-path: polygon(0 0, 94% 0, 86% 100%, 0 100%);
    text-decoration: none;
    z-index: 2;
  }

  .footer-brand-cyan-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: min(100%, 290px);
    height: 52px;
    background-color: var(--color-cyan);
    clip-path: polygon(0 0, 96% 0, 88% 100%, 0 100%);
    z-index: 1;
  }

  .footer-logo-img {
    height: 38px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
  }

  .footer-description {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.55;
    margin-bottom: 22px;
    max-width: 340px;
  }

  .social-links-row {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--color-white);
    border-radius: 50%;
    transition: background-color 0.2s ease, transform 0.2s ease;
    text-decoration: none;
  }

  .social-btn:hover {
    background-color: var(--color-cyan);
    color: var(--color-white);
    transform: translateY(-2px);
  }

  /* Headings */
  .footer-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    letter-spacing: 0.8px;
    color: var(--color-cyan);
    margin: 0 0 20px;
    text-transform: uppercase;
    line-height: 1.2;
  }

  /* Vertical Lists */
  .footer-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-cyan);
    transform: translateX(2px);
  }

  .external-link {
    gap: 0.35rem;
  }

  .ext-icon {
    opacity: 0.7;
  }

  /* Column 4: Contact Us */
  .footer-contact {
    justify-self: end;
    width: min(100%, 330px);
  }

  .footer-contact-list {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
  }

  .contact-item {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.45;
  }

  .contact-icon {
    color: var(--color-cyan);
    margin-top: 3px;
  }

  .email-link {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    overflow-wrap: anywhere;
    word-break: normal;
    transition: color 0.2s ease;
  }

  .email-link:hover {
    color: var(--color-cyan);
  }

  .address-text {
    display: flex;
    flex-direction: column;
  }

  .social-link {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-link:hover {
    color: var(--color-cyan);
  }

  /* Bottom Integrated Bar */
  .footer-bottom {
    background: #102A47;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-bottom-inner {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.65);
    padding-block: 14px;
  }

  .copyright-text {
    margin: 0;
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .legal-links a {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .legal-links a:hover {
    color: var(--color-cyan);
  }

  .dot-sep {
    color: rgba(255, 255, 255, 0.3);
  }

  /* Responsive Rules */
  @media (max-width: 1100px) and (min-width: 768px) {
    .footer-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 44px 64px;
    }
    .footer-contact {
      justify-self: start;
    }
  }

  @media (max-width: 767px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-block: 42px 36px;
    }

    .footer-contact {
      justify-self: start;
      width: 100%;
    }

    .footer-bottom-inner {
      flex-direction: column;
      gap: 0.6rem;
      text-align: center;
    }
  }
</style>
