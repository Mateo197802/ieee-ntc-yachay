        </a>
        <a href="https://facebook.com/ieee.ntc.yachay" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.5 5H18V0h-3.808C10.592 0 9 1.583 9 4.615V8z"/></svg>
        </a>
        <a href="https://youtube.com/@ieee-ntc-yachay" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="YouTube">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
        </a>
      </div>
    </div>

    <!-- Column 2: Quick Links -->
    <div class="footer-links">
      <h3 class="footer-heading">QUICK LINKS</h3>
      <ul class="footer-list">
        <li><a href={getHref('/')}>• Home</a></li>
        <li><a href={getHref('/about/')}>• About Us</a></li>
        <li><a href={getHref('/directive/')}>• Directive</a></li>
        <li><a href={getHref('/events/')}>• Events</a></li>
        <li><a href={getHref('/projects/')}>• Projects</a></li>
        <li><a href={getHref('/opportunities/')}>• Opportunities</a></li>
        <li><a href={getHref('/gallery/')}>• Gallery</a></li>
        <li><a href={getHref('/news/')}>• News</a></li>
        <li><a href={getHref('/contact/')}>• Contact</a></li>
      </ul>
    </div>

    <!-- Column 3: Opportunities -->
    <div class="footer-links">
      <h3 class="footer-heading">OPPORTUNITIES</h3>
      <ul class="footer-list">
        <li><a href={getHref('/opportunities/#scholarships')}>• Scholarships</a></li>
        <li><a href={getHref('/opportunities/#grants')}>• Travel Grants</a></li>
        <li><a href={getHref('/opportunities/#competitions')}>• Competitions</a></li>
        <li><a href={getHref('/opportunities/#volunteer')}>• Volunteer</a></li>
        <li><a href={getHref('/opportunities/#programs')}>• IEEE Programs</a></li>
        <li><a href={getHref('/opportunities/#internships')}>• Internships</a></li>
      </ul>
    </div>

    <!-- Column 4: Contact Us -->
    <div class="footer-contact">
      <h3 class="footer-heading">CONTACT US</h3>
      <ul class="contact-list">
        <li>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
