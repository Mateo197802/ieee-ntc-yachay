---
import Layout from '@/layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="404 - Page Not Found | IEEE NTC Yachay Tech"
  description="The page you are looking for does not exist or has been moved."
>
  <section class="not-found-section">
    <div class="site-container text-center">
      <h1 class="error-code font-heading">404</h1>
      <h2 class="error-title">PAGE NOT FOUND</h2>
      <p class="error-desc">The page you are looking for does not exist or has been moved.</p>
      <a href={getHref('/')} class="btn btn-primary">
        BACK TO HOME
      </a>
    </div>
  </section>
</Layout>

<style>
  .not-found-section {
    padding: 6rem 0;
    background-color: var(--color-white);
  }
  .error-code {
    font-size: 6rem;
    color: var(--color-cyan);
    line-height: 1;
  }
  .error-title {
    font-size: 2rem;
    color: var(--color-navy);
    margin: 1rem 0;
  }
  .error-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  .text-center {
    text-align: center;
  }
</style>
