---
import Layout from '@/layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout title="404 - Página No Encontrada | IEEE NTC Yachay Tech">
  <section class="not-found-section">
    <div class="site-container text-center">
      <h1 class="error-code font-heading">404</h1>
      <h2 class="error-title" data-i18n-es="PÁGINA NO ENCONTRADA" data-i18n-en="PAGE NOT FOUND">PÁGINA NO ENCONTRADA</h2>
      <p class="error-desc" data-i18n-es="La página que estás buscando no existe o ha sido trasladada a otra dirección." data-i18n-en="The page you are looking for does not exist or has been moved.">La página que estás buscando no existe o ha sido trasladada a otra dirección.</p>
      <a href={getHref('/')} class="btn btn-primary" data-i18n-es="VOLVER AL INICIO" data-i18n-en="BACK TO HOME">
        VOLVER AL INICIO
      </a>
    </div>
  </section>
</Layout>

<style>
  .not-found-section {
    padding: 6rem 0;
    background-color: var(--color-white);
  }
  .error-code {
    font-size: 6rem;
    color: var(--color-cyan);
    line-height: 1;
  }
  .error-title {
    font-size: 2rem;
    color: var(--color-navy);
    margin: 1rem 0;
  }
  .error-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  .text-center {
    text-align: center;
  }
</style>
