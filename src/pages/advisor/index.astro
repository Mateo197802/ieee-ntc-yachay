---
import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/config/site';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

const RESEARCH_LINES = [
  {
    title: 'Carrier-Selective Contacts & Photovoltaics',
    tag: 'SOLAR CELLS & SEMICONDUCTORS',
    desc: 'Investigating transition metal oxides (TMOs) for carrier-selective passivating contacts in high-efficiency crystalline silicon and kesterite thin-film solar cells, advancing sustainable clean energy technologies.'
  },
  {
    title: 'Atomic Layer Deposition (ALD) & Surface Engineering',
    tag: 'ATOMIC-SCALE SYNTHESIS',
    desc: 'Precision synthesis of conformal ultra-thin films, surface passivation, and scalable atomic-layer coatings for next-generation semiconductor micro and nanodevices.'
  },
  {
    title: 'Magnetic Nanomaterials & Carbon Nanotubes',
    tag: 'ADVANCED NANOSTRUCTURES',
    desc: 'Pioneering synthesis, surface functionalization, and encapsulation of functional magnetic nanoparticles within multi-walled carbon nanotubes for advanced sensor and biomedical applications.'
  },
  {
    title: 'Spectroscopic & Structural Characterization',
    tag: 'ADVANCED MICROSCOPY',
    desc: 'Advanced nano-characterization leveraging Scanning Electron Microscopy (SEM), Transmission Electron Microscopy (TEM), Raman spectroscopy, and X-ray diffraction (XRD).'
  }
];

const ADVISOR_ROLES = [
  {
    role: 'Faculty Chapter Advisor',
    institution: 'IEEE Nanotechnology Council Student Branch Chapter',
    desc: 'Providing continuous scientific direction, academic mentorship, and strategic alignment with international IEEE NTC initiatives for student researchers at Yachay Tech.'
  },
  {
    role: 'Research Group Director',
    institution: 'GIAANT (Grupo de Investigación en Aplicaciones Avanzadas de Nano Tecnología)',
    desc: 'Leading interdisciplinary research projects focused on nanomaterial synthesis, photovoltaic devices, and advanced materials characterization.'
  },
  {
    role: 'Professor & Researcher',
    institution: 'School of Physical Sciences and Nanotechnology · Yachay Tech University',
    desc: 'Teaching core courses in nanotechnology engineering, training students in advanced laboratory cleanroom protocols, and advising undergraduate theses.'
  },
  {
    role: 'Principal Outreach Delegate',
    institution: 'Directorate of University Outreach (Vinculación con la Sociedad)',
    desc: 'Fostering university-community integration by promoting STEM dissemination, youth scientific workshops, and technological transfer across Ecuador.'
  }
];

const INTERNATIONAL_ALLIANCES = [
  {
    name: 'IREC (Institut de Recerca en Energia de Catalunya)',
    location: 'Barcelona, Spain',
    focus: 'Advanced thin-film solar cells, kesterite absorbers, and functional oxide carrier-selective contacts.'
  },
  {
    name: 'Universitat Politècnica de Catalunya (UPC)',
    location: 'Barcelona, Spain',
    focus: 'Micro and nanotechnologies, semiconductor device fabrication, and atomic layer deposition techniques.'
  },
  {
    name: 'European Research Centers',
    location: 'Italy & Spain',
    focus: 'International research stays, cleanroom synthesis methodologies, and cross-border scientific publications.'
  }
];
---

<Layout
  title="Faculty Chapter Advisor | IEEE Nanotechnology Council Yachay Tech"
  description="Academic profile, research trajectory, and scientific mentorship of Dra. Rosa Estefanía Almache Hernández, Faculty Advisor of IEEE Nanotechnology Council at Yachay Tech University."
>
  <!-- Hero Section -->
  <section class="page-hero">
    <div class="site-container">
      <div class="breadcrumbs">
        <a href={getHref('/')}>Home</a> &gt; 
        <a href={getHref('/about/')}>About</a> &gt; 
        <span>Chapter Advisor</span>
      </div>
      <div class="hero-content">
        <span class="hero-badge">ACADEMIC LEADERSHIP & SCIENTIFIC MENTORSHIP</span>
        <h1 class="page-title font-heading">FACULTY CHAPTER ADVISOR</h1>
        <p class="page-subtitle">
          Guiding Next-Generation Nanotechnologists, Frontier Nanomaterials Research & International IEEE Synergies
        </p>
      </div>
    </div>
  </section>

  <!-- Main Showcase Section -->
  <section class="advisor-showcase-section">
    <div class="site-container">
      
      <!-- Top Profile Card & Biography Grid -->
      <div class="advisor-main-grid">
        
        <!-- Left Column: Portrait Card & Key Data -->
        <div class="advisor-card-column">
          <div class="advisor-portrait-card">
            <div class="portrait-wrapper">
              <img 
                src={getHref('/assets/directive/dra_estefania_almache.png')} 
                alt="Dra. Rosa Estefanía Almache Hernández, Ph.D. - Faculty Advisor IEEE NTC Yachay Tech" 
                width="480" 
                height="540" 
                class="advisor-portrait-img"
              />
              <div class="portrait-badge">
                <span class="badge-dot"></span>
                <span>OFFICIAL FACULTY ADVISOR</span>
              </div>
            </div>

            <div class="advisor-card-info">
              <h2 class="advisor-name">Dra. Rosa Estefanía Almache Hernández</h2>
              <span class="advisor-academic-title">Ph.D. in Nanotechnology & Materials Science</span>
              
              <div class="advisor-meta-pills">
                <span class="meta-pill">School of Physical Sciences & Nanotechnology</span>
                <span class="meta-pill">Director at GIAANT Research Group</span>
                <span class="meta-pill">Yachay Tech University</span>
              </div>

              <div class="advisor-contact-block">
                <div class="contact-item">
                  <span class="contact-label">INSTITUTIONAL EMAIL</span>
                  <a href="mailto:ealmache@yachaytech.edu.ec" class="contact-link">ealmache@yachaytech.edu.ec</a>
                </div>
                <div class="contact-item">
                  <span class="contact-label">FACULTY LOCATION</span>
                  <span class="contact-val">Knowledge City, Urcuquí, Imbabura, Ecuador</span>
                </div>
              </div>

              <div class="advisor-card-actions">
                <a href="mailto:ealmache@yachaytech.edu.ec" class="btn btn-primary contact-btn">
                  <span>CONTACT FACULTY ADVISOR</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Comprehensive Narrative Biography & Focus -->
        <div class="advisor-bio-column">
          
          <div class="bio-intro-box">
            <span class="section-kicker">SCIENTIFIC PROFILE & TRAJECTORY</span>
            <h2 class="bio-heading font-heading">BRIDGING FRONTIER NANOSCIENCE WITH STUDENT LEADERSHIP</h2>
            <p class="bio-lead">
              <strong>Dra. Rosa Estefanía Almache Hernández</strong> is a prominent Ecuadorian researcher, academic, and faculty mentor specializing in micro and nanotechnologies. She currently serves as Professor and Researcher within the <strong>School of Physical Sciences and Nanotechnology</strong> at Yachay Tech University and is the official Faculty Chapter Advisor of the <strong>IEEE Nanotechnology Council Student Branch Chapter</strong>.
            </p>
            <p class="bio-paragraph">
              With extensive international research experience in Europe—including research collaborations and stays in <strong>Spain (IREC, UPC)</strong> and <strong>Italy</strong>—Dr. Almache leads cutting-edge research in transition metal oxide-based carrier-selective contacts for high-efficiency solar cells, atomic layer deposition (ALD), and magnetic nanoparticle encapsulation in carbon nanostructures.
            </p>
            <p class="bio-paragraph">
              As Director of the <strong>Grupo de Investigación en Aplicaciones Avanzadas de Nano Tecnología (GIAANT)</strong>, she actively champions hands-on undergraduate research, cleanroom laboratory training, and peer-reviewed international scientific publications, guiding Yachay Tech students to present their findings at prestigious international conferences across the Americas and Europe.
            </p>
          </div>

          <!-- Advisor Inspiring Statement Box -->
          <div class="advisor-quote-card">
            <div class="quote-icon" aria-hidden="true">“</div>
            <p class="quote-text">
              Scientific innovation achieves its highest purpose when it connects atomic-scale physics with tangible technological solutions that elevate our society. Through our IEEE Nanotechnology Council chapter, we empower students to lead frontier research, master advanced laboratory techniques, and demonstrate that Latin American science is at the global vanguard.
            </p>
            <div class="quote-author">
              <strong>Dra. Rosa Estefanía Almache Hernández, Ph.D.</strong>
              <span>Faculty Chapter Advisor · IEEE Nanotechnology Council Yachay Tech</span>
            </div>
          </div>

        </div>

      </div>

      <!-- Core Research Areas Section -->
      <div class="research-areas-block">
        <div class="block-header text-center">
          <span class="section-kicker">SCIENTIFIC SPECIALIZATION</span>
          <h2 class="block-title font-heading">PRIMARY RESEARCH LINES & EXPERTISE</h2>
          <p class="block-subtitle">
            Pioneering experimental methodologies and nanomaterials engineering developed at Yachay Tech and European partner laboratories.
          </p>
        </div>

        <div class="research-grid">
          {RESEARCH_LINES.map((item) => (
            <div class="research-card">
              <span class="research-tag">{item.tag}</span>
              <h3 class="research-card-title font-heading">{item.title}</h3>
              <p class="research-card-desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Institutional Leadership & Roles -->
      <div class="leadership-roles-block">
        <div class="block-header text-center">
          <span class="section-kicker">INSTITUTIONAL SERVICE</span>
          <h2 class="block-title font-heading">ACADEMIC LEADERSHIP & COMMUNITY ROLES</h2>
          <p class="block-subtitle">
            Fostering research excellence, student development, and societal engagement across Yachay Tech University.
          </p>
        </div>

        <div class="roles-grid">
          {ADVISOR_ROLES.map((r) => (
            <div class="role-card">
              <div class="role-header">
                <h3 class="role-title font-heading">{r.role}</h3>
                <span class="role-institution">{r.institution}</span>
              </div>
              <p class="role-desc">{r.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- International Alliances & European Collaborations -->
      <div class="alliances-block">
        <div class="block-header text-center">
          <span class="section-kicker">GLOBAL RESEARCH ECOSYSTEM</span>
          <h2 class="block-title font-heading">INTERNATIONAL COLLABORATIONS & INSTITUTIONAL ALLIANCES</h2>
          <p class="block-subtitle">
            Strengthening cross-border academic ties and state-of-the-art cleanroom research collaborations in Europe.
          </p>
        </div>

        <div class="alliances-grid">
          {INTERNATIONAL_ALLIANCES.map((a) => (
            <div class="alliance-card">
              <div class="alliance-icon">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
              </div>
              <h3 class="alliance-name font-heading">{a.name}</h3>
              <span class="alliance-location">{a.location}</span>
              <p class="alliance-focus">{a.focus}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Chapter Quick Navigation Strip -->
      <div class="advisor-bottom-nav">
        <div class="nav-cta-card">
          <div class="nav-cta-info">
            <h3 class="nav-cta-title font-heading">EXPLORE CHAPTER LEADERSHIP & INITIATIVES</h3>
            <p class="nav-cta-desc">
              Discover the student executive board, ongoing nanotechnology projects, and academic events mentored by Dr. Almache.
            </p>
          </div>
          <div class="nav-cta-buttons">
            <a href={getHref('/directive/')} class="btn btn-secondary">
              <span>FOUNDING BOARD & DIRECTIVE</span>
            </a>
            <a href={getHref('/projects/')} class="btn btn-primary">
              <span>VIEW CHAPTER PROJECTS</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  /* Page Hero */
  .page-hero {
    background-color: var(--color-navy);
    color: #ffffff;
    padding: 3.5rem 0 2.5rem;
    position: relative;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumbs {
    font-size: 0.85rem;
    color: #cbd5e1;
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: #ffffff;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumbs a:hover {
    color: var(--color-cyan);
  }

  .breadcrumbs span {
    color: var(--color-cyan);
    font-weight: 600;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--color-cyan);
    background: rgba(5, 135, 189, 0.18);
    border: 1px solid var(--color-cyan);
    padding: 0.35rem 0.85rem;
    border-radius: var(--border-radius-sm);
    margin-bottom: 0.85rem;
  }

  .page-title {
    font-size: 2.75rem;
    line-height: 1.15;
    color: #ffffff;
    margin-bottom: 0.5rem;
    letter-spacing: 0.5px;
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: #e2e8f0;
    max-width: 820px;
    line-height: 1.5;
  }

  /* Main Showcase Section */
  .advisor-showcase-section {
    padding: 3.5rem 0 4.5rem;
    background-color: var(--color-bg-light);
  }

  .advisor-main-grid {
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-bottom: 4rem;
  }

  /* Left Portrait Card */
  .advisor-portrait-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    position: sticky;
    top: 100px;
  }

  .portrait-wrapper {
    position: relative;
    width: 100%;
    height: 420px;
    background-color: #071c34;
    overflow: hidden;
  }

  .advisor-portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    transition: transform 0.4s ease;
  }

  .advisor-portrait-card:hover .advisor-portrait-img {
    transform: scale(1.03);
  }

  .portrait-badge {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    background: rgba(7, 28, 52, 0.92);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-cyan);
    border-radius: var(--border-radius-sm);
    padding: 0.45rem 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.8px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 8px #22c55e;
  }

  .advisor-card-info {
    padding: 1.75rem 1.5rem;
  }

  .advisor-name {
    font-size: 1.35rem;
    color: var(--color-navy);
    line-height: 1.25;
    margin-bottom: 0.35rem;
  }

  .advisor-academic-title {
    font-size: 0.88rem;
    color: var(--color-cyan);
    font-weight: 700;
    display: block;
    margin-bottom: 1rem;
  }

  .advisor-meta-pills {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .meta-pill {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-navy);
    background-color: var(--color-bg-light);
    border: 1px solid var(--color-border-light);
    padding: 0.3rem 0.65rem;
    border-radius: 4px;
  }

  .advisor-contact-block {
    border-top: 1px solid var(--color-border-light);
    padding-top: 1rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .contact-label {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.6px;
    color: var(--color-text-muted);
  }

  .contact-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-institutional-blue);
    text-decoration: none;
    word-break: break-all;
    transition: color var(--transition-fast);
  }

  .contact-link:hover {
    color: var(--color-cyan);
  }

  .contact-val {
    font-size: 0.82rem;
    color: var(--color-navy);
  }

  .advisor-card-actions .btn {
    width: 100%;
    justify-content: center;
    font-size: 0.85rem;
  }

  /* Right Bio Column */
  .advisor-bio-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .bio-intro-box {
    background-color: var(--color-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-md);
    padding: 2.25rem 2.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .section-kicker {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--color-cyan);
    display: block;
    margin-bottom: 0.4rem;
  }

  .bio-heading {
    font-size: 1.85rem;
    color: var(--color-navy);
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }

  .bio-lead {
    font-size: 1.05rem;
    color: var(--color-navy);
    line-height: 1.7;
    margin-bottom: 1.2rem;
  }

  .bio-paragraph {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .bio-paragraph:last-child {
    margin-bottom: 0;
  }

  /* Advisor Quote Card */
  .advisor-quote-card {
    background-color: #071c34;
    border: 1px solid rgba(5, 135, 189, 0.35);
    border-left: 5px solid var(--color-cyan);
    border-radius: var(--border-radius-md);
    padding: 2rem 2.25rem;
    position: relative;
    color: #ffffff;
  }

  .quote-icon {
    font-size: 3.5rem;
    line-height: 1;
    font-family: Georgia, serif;
    color: var(--color-cyan);
    opacity: 0.6;
    margin-bottom: -0.75rem;
  }

  .quote-text {
    font-size: 1.05rem;
    line-height: 1.65;
    font-style: italic;
    color: #f1f5f9;
    margin-bottom: 1.25rem;
  }

  .quote-author strong {
    display: block;
    font-size: 0.95rem;
    color: #ffffff;
  }

  .quote-author span {
    font-size: 0.8rem;
    color: var(--color-cyan);
  }

  /* Section Blocks Styling */
  .research-areas-block,
  .leadership-roles-block,
  .alliances-block {
    margin-bottom: 4rem;
  }

  .block-header {
    max-width: 780px;
    margin: 0 auto 2.5rem;
  }

  .block-title {
    font-size: 2rem;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .block-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Research Grid */
  .research-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .research-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-md);
    padding: 2rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .research-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    border-color: var(--color-cyan);
  }

  .research-tag {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.8px;
    color: var(--color-cyan);
    background-color: rgba(5, 135, 189, 0.1);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .research-card-title {
    font-size: 1.25rem;
    color: var(--color-navy);
    margin-bottom: 0.65rem;
    line-height: 1.25;
  }

  .research-card-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Leadership Roles Grid */
  .roles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .role-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-md);
    padding: 2rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
  }

  .role-header {
    border-bottom: 2px solid var(--color-border-light);
    padding-bottom: 0.85rem;
    margin-bottom: 1rem;
  }

  .role-title {
    font-size: 1.25rem;
    color: var(--color-navy);
    margin-bottom: 0.25rem;
  }

  .role-institution {
    font-size: 0.82rem;
    color: var(--color-cyan);
    font-weight: 700;
    display: block;
  }

  .role-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Alliances Grid */
  .alliances-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .alliance-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-md);
    padding: 2rem 1.75rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    text-align: center;
  }

  .alliance-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: rgba(5, 135, 189, 0.12);
    color: var(--color-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }

  .alliance-name {
    font-size: 1.15rem;
    color: var(--color-navy);
    margin-bottom: 0.35rem;
    line-height: 1.25;
  }

  .alliance-location {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-cyan);
    display: block;
    margin-bottom: 0.85rem;
  }

  .alliance-focus {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  /* Bottom Navigation CTA */
  .nav-cta-card {
    background-color: var(--color-navy);
    border-radius: var(--border-radius-md);
    padding: 2.5rem 3rem;
    color: #ffffff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

