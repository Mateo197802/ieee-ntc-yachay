---
import Layout from '@/layouts/Layout.astro';
import { NEWS_DATA } from '@/data/news';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Noticias y Comunicados | IEEE Nanotechnology Council Yachay Tech"
  description="Mantente informado con las últimas noticias, convocatorias, coberturas de eventos y publicaciones oficiales de IEEE NTC Yachay Tech."
>
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')} data-i18n-es="Inicio" data-i18n-en="Home">Inicio</a> &gt; <span data-i18n-es="Noticias" data-i18n-en="News">Noticias</span>
      </div>
      <h1 class="banner-title font-heading" data-i18n-es="NOTICIAS Y COMUNICADOS" data-i18n-en="NEWS & ANNOUNCEMENTS">NOTICIAS Y COMUNICADOS</h1>
      <p class="banner-subtitle" data-i18n-es="Comunicados oficiales, coberturas de eventos, logros de investigación y vinculación científica." data-i18n-en="Official announcements, event coverages, research milestones, and scientific outreach.">Comunicados oficiales, coberturas de eventos, logros de investigación y vinculación científica.</p>
    </div>
  </section>

  <section class="news-section">
    <div class="site-container">
      <div class="news-grid">
        {NEWS_DATA.map((article) => (
          <article class="news-card">
            <div class="news-img-box">
              <img src={getHref(article.image)} alt={article.imageAlt} width="400" height="260" loading="lazy" class="article-img" />
              <span class="category-tag" data-i18n-es={article.category} data-i18n-en={article.categoryEn}>{article.category}</span>
            </div>

            <div class="news-card-body">
              <div class="news-meta">
                <span class="meta-date" data-i18n-es={article.date} data-i18n-en={article.dateEn}>{article.date}</span>
                <span class="meta-author" data-i18n-es={`• Por ${article.author}`} data-i18n-en={`• By ${article.authorEn}`}>• Por {article.author}</span>
                <span class="meta-read" data-i18n-es={`• ${article.readTime}`} data-i18n-en={`• ${article.readTimeEn}`}>• {article.readTime}</span>
              </div>

              <h2 class="article-title" data-i18n-es={article.title} data-i18n-en={article.titleEn}>{article.title}</h2>
              <p class="article-summary" data-i18n-es={article.summary} data-i18n-en={article.summaryEn}>{article.summary}</p>
              <p class="article-content-preview" data-i18n-es={article.content} data-i18n-en={article.contentEn}>{article.content}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
  }

  .news-section {
    padding: 4.5rem 0;
    background-color: var(--color-bg-light);
  }

  .news-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .news-card {
    display: grid;
    grid-template-columns: 380px 1fr;
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .news-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .news-img-box {
    position: relative;
    background-color: #06192e;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .article-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .category-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: rgba(7, 28, 52, 0.85);
    color: var(--color-cyan);
    border: 1px solid var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 20px;
    z-index: 2;
  }

  .news-card-body {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
  }

  .news-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .meta-date {
    font-weight: 700;
    color: var(--color-cyan);
  }

  .article-title {
    font-size: 1.4rem;
    color: var(--color-navy);
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .article-summary {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-dark);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .article-content-preview {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .news-card {
      grid-template-columns: 1fr;
    }
    .news-img-box {
      height: 220px;
    }
  }
</style>
