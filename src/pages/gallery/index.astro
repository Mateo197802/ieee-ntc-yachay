---
import Layout from '@/layouts/Layout.astro';
import { GALLERY_ALBUMS } from '@/data/gallery';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

const categories = ['All', 'Outreach', 'Conferences', 'Workshops', 'Community'];
---

<Layout 
  title="Photo Gallery | IEEE Nanotechnology Council Yachay Tech"
  description="Visual records of IEEE NTC Yachay Tech activities, high school workshops, hospital volunteering, scientific conferences, and community gatherings."
>
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>Gallery</span>
      </div>
      <h1 class="banner-title font-heading">PHOTO GALLERY</h1>
      <p class="banner-subtitle">Documenting our history, STEM workshops, community service, and participation in scientific conferences.</p>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="gallery-section">
    <div class="site-container">
      <!-- Filter Buttons Bar -->
      <div class="filter-bar" role="tablist" aria-label="Gallery Categories">
        {categories.map((cat, idx) => (
          <button 
            class={`filter-btn ${idx === 0 ? 'active' : ''}`}
            data-filter={cat.toLowerCase()}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Compact 4-Column Responsive Albums Grid with Fully Visible Photos -->
      <div class="gallery-mosaic" id="gallery-mosaic">
        {GALLERY_ALBUMS.map((album) => (
          <div 
            class="mosaic-item" 
            data-category={album.category.toLowerCase()}
            id={album.id}
          >
            <button 
              class="mosaic-card-btn open-album-btn" 
              data-album={JSON.stringify(album)}
              aria-label={`View full album: ${album.title}`}
            >
              <div class="mosaic-img-box">
                <img 
                  src={getHref(album.coverImage)} 
                  alt={album.title} 
                  width="320" 
                  height="180" 
                  loading="lazy" 
                  class="mosaic-img"
                />
                <span class="category-tag">{album.category}</span>
                <span class="photos-count-badge">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                  {album.slides.length} Photos
                </span>
                <span class="zoom-hover-badge">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                  EXPAND
                </span>
              </div>
              <div class="mosaic-info-box">
                <span class="info-date">{album.date}</span>
                <h3 class="info-title">{album.title}</h3>
                <p class="info-caption">{album.summary}</p>
              </div>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Lightbox Carousel Modal with Pure Arrow Navigation -->
  <dialog id="gallery-carousel-modal" class="gallery-modal-dialog">
    <div class="gallery-modal-inner">
      <button class="gallery-modal-close" id="modal-close-btn" aria-label="Close modal">&times;</button>
      
      <div class="gallery-modal-header">
        <div class="modal-header-top">
          <span class="gallery-modal-category" id="album-category-display">OUTREACH</span>
          <span class="modal-counter-badge" id="carousel-counter">Photo 1 of 4</span>
        </div>
        <h2 class="gallery-modal-title" id="album-title-display">Album Title</h2>
      </div>

      <!-- Main Stage with Prominent Lateral Arrow Buttons -->
      <div class="gallery-carousel-stage">
        <button class="carousel-nav-btn prev-btn" id="carousel-prev-btn" aria-label="Previous photo">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        </button>
        
        <div class="carousel-slide-box">
          <img id="carousel-slide-img" src="" alt="" class="carousel-main-img" />
          <div class="carousel-caption-bar">
            <h4 class="slide-title" id="carousel-slide-title">Photo title</h4>
            <p class="slide-desc" id="carousel-slide-desc">Photo description</p>
          </div>
        </div>

        <button class="carousel-nav-btn next-btn" id="carousel-next-btn" aria-label="Next photo">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
      </div>

      <!-- Subtle keyboard helper text -->
      <div class="modal-keyboard-hint">
        <span>Use lateral arrows or keyboard ← / → to navigate</span>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
    max-width: 760px;
  }

  .gallery-section {
    padding: 4rem 0 5rem;
    background-color: var(--color-bg-light);
  }

  .filter-bar {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.45rem 1.25rem;
    border-radius: 20px;
    background-color: var(--color-white);
    color: var(--color-navy);
    border: 1px solid var(--color-border-light);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover,
  .filter-btn.active {
    background-color: var(--color-cyan);
    color: var(--color-white);
    border-color: var(--color-cyan);
  }

  .gallery-mosaic {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .mosaic-item {
    display: flex;
  }

  .mosaic-card-btn {
    background: var(--color-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    width: 100%;
    text-align: left;
    padding: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .mosaic-card-btn:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .mosaic-img-box {
    position: relative;
    width: 100%;
    height: 190px;
    background-color: #0c2340;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mosaic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .mosaic-card-btn:hover .mosaic-img {
    transform: scale(1.04);
  }

  .category-tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background-color: rgba(7, 28, 52, 0.85);
    color: var(--color-cyan);
    border: 1px solid var(--color-cyan);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
  }

  .photos-count-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background-color: rgba(0, 0, 0, 0.75);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    z-index: 2;
  }

  .zoom-hover-badge {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background-color: var(--color-cyan);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    opacity: 0;
    transform: translateY(4px);
    transition: all 0.2s ease;
    z-index: 2;
  }

  .mosaic-card-btn:hover .zoom-hover-badge {
    opacity: 1;
    transform: translateY(0);
  }

  .mosaic-info-box {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .info-date {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-cyan);
    margin-bottom: 0.35rem;
    display: block;
  }

  .info-title {
    font-size: 1rem;
    color: var(--color-navy);
    line-height: 1.35;
    margin: 0 0 0.5rem;
  }

  .info-caption {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Lightbox Modal */
  .gallery-modal-dialog {
    border: none;
    padding: 0;
    background: transparent;
  }

  .gallery-modal-inner {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2rem;
    position: relative;
    border-top: 4px solid var(--color-cyan);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    width: 100%;
    max-width: 900px;
  }

  .gallery-modal-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: none;
    border: none;
    font-size: 1.85rem;
    color: var(--color-navy);
    cursor: pointer;
    line-height: 1;
  }

  .modal-header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .gallery-modal-category {
    color: var(--color-cyan);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .gallery-modal-title {
    font-size: 1.45rem;
    color: var(--color-navy);
    margin: 0.25rem 0 1.25rem;
  }

  .gallery-carousel-stage {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .carousel-slide-box {
    flex: 1;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    background-color: #06192e;
    box-shadow: var(--shadow-hover);
  }

  .carousel-main-img {
    width: 100%;
    height: 440px;
    object-fit: contain;
    display: block;
    background-color: #06192e;
  }

  .carousel-caption-bar {
    background-color: var(--color-navy);
    color: var(--color-white);
    padding: 1rem 1.25rem;
  }

  .slide-title {
    font-size: 1rem;
    margin: 0 0 0.25rem;
    color: var(--color-white);
  }

  .slide-desc {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
    line-height: 1.45;
  }

  .carousel-nav-btn {
    background-color: var(--color-navy);
    color: var(--color-white);
    border: 1px solid var(--color-cyan);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .carousel-nav-btn:hover {
    background-color: var(--color-cyan);
    transform: scale(1.05);
  }

  .modal-keyboard-hint {
    text-align: center;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: 1rem;
  }

  /* Dark Mode Overrides for Gallery Page */
  :global(html[data-theme="dark"]) .gallery-section {
    background-color: #071626;
  }

  :global(html[data-theme="dark"]) .filter-btn {
    background-color: rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    border-color: rgba(255, 255, 255, 0.18);
  }

  :global(html[data-theme="dark"]) .filter-btn:hover {
    background-color: rgba(5, 135, 189, 0.2);
    border-color: var(--color-cyan);
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .filter-btn.active {
    background-color: var(--color-cyan);
    color: #ffffff;
    border-color: var(--color-cyan);
    box-shadow: 0 4px 12px rgba(5, 135, 189, 0.35);
  }

  :global(html[data-theme="dark"]) .mosaic-card-btn {
    background-color: #0c2340;
    border-color: rgba(5, 135, 189, 0.25);
  }

  :global(html[data-theme="dark"]) .info-title {
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .info-summary {
    color: #cbd5e1;
  }

  :global(html[data-theme="dark"]) .card-cta {
    color: var(--color-cyan);
  }

  @media (max-width: 1200px) {
    .gallery-mosaic {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 860px) {
    .gallery-mosaic {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .gallery-mosaic {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const basePrefix = (window as any).__ASTRO_BASE_URL__ || document.querySelector('meta[name="base-url"]')?.getAttribute('content') || '/ieee-ntc-yachay';
    function resolveUrl(path: string) {
      if (!path) return '';
      if (path.startsWith('http')) return path;
      const cleanBase = basePrefix.replace(/\/$/, '');
      const cleanPath = path.startsWith('/') ? path : '/' + path;
      return `${cleanBase}${cleanPath}`;
    }

    // 1. Category Filtering
    const filterButtons = document.querySelectorAll('.filter-btn');
    const mosaicItems = document.querySelectorAll('.mosaic-item');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter') || 'all';

        mosaicItems.forEach((item) => {
          const itemCat = item.getAttribute('data-category') || '';
          if (filter === 'all' || itemCat === filter) {
            (item as HTMLElement).style.display = 'flex';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // 2. Carousel Lightbox Modal
    const modal = document.getElementById('gallery-carousel-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('modal-close-btn');
    const prevBtn = document.getElementById('carousel-prev-btn');
    const nextBtn = document.getElementById('carousel-next-btn');

    const catEl = document.getElementById('album-category-display');
    const titleEl = document.getElementById('album-title-display');

    const slideImg = document.getElementById('carousel-slide-img') as HTMLImageElement | null;
    const counterEl = document.getElementById('carousel-counter');
    const slideTitleEl = document.getElementById('carousel-slide-title');
    const slideDescEl = document.getElementById('carousel-slide-desc');

    let currentAlbum: any = null;
    let currentIndex = 0;

    function renderSlide(idx: number) {
      if (!currentAlbum || !currentAlbum.slides || currentAlbum.slides.length === 0) return;
      currentIndex = (idx + currentAlbum.slides.length) % currentAlbum.slides.length;
      const slide = currentAlbum.slides[currentIndex];

      if (slideImg) slideImg.src = resolveUrl(slide.image);
      if (catEl) catEl.textContent = currentAlbum.category.toUpperCase();
      if (titleEl) titleEl.textContent = currentAlbum.title;
      if (counterEl) counterEl.textContent = `Photo ${currentIndex + 1} of ${currentAlbum.slides.length}`;
      if (slideTitleEl) slideTitleEl.textContent = slide.title;
      if (slideDescEl) slideDescEl.textContent = slide.caption;
    }

    document.querySelectorAll('.open-album-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-album');
        if (!raw || !modal) return;
        currentAlbum = JSON.parse(raw);
        currentIndex = 0;

        renderSlide(0);
        modal.showModal();
      });
    });

    prevBtn?.addEventListener('click', () => renderSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => renderSlide(currentIndex + 1));

    document.addEventListener('keydown', (e) => {
      if (modal?.open) {
        if (e.key === 'ArrowLeft') renderSlide(currentIndex - 1);
        if (e.key === 'ArrowRight') renderSlide(currentIndex + 1);
      }
    });

    closeBtn?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  });
</script>
