---
import Layout from '@/layouts/Layout.astro';
import { GALLERY_ALBUMS } from '@/data/gallery';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

const categories = ['Todas', 'Vinculación', 'Conferencias', 'Talleres', 'Comunidad'];
---

<Layout 
  title="Galería de Fotos | IEEE Nanotechnology Council Yachay Tech"
  description="Registro visual de las actividades de IEEE NTC Yachay Tech, talleres en colegios, voluntariado en hospitales, conferencias científicas y eventos comunitarios."
>
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Inicio</a> &gt; <span>Galería</span>
      </div>
      <h1 class="banner-title font-heading">GALERÍA DE FOTOS</h1>
      <p class="banner-subtitle">Documentando nuestra historia, talleres STEM, servicio comunitario y participación en conferencias científicas.</p>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="gallery-section">
    <div class="site-container">
      <!-- Filter Buttons Bar -->
      <div class="filter-bar" role="tablist" aria-label="Categorías de la Galería">
        {categories.map((cat, idx) => (
          <button 
            class={`filter-btn ${idx === 0 ? 'active' : ''}`}
            data-filter={cat.toLowerCase()}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Compact 4-Column Responsive Albums Grid with Fully Visible Photos -->
      <div class="gallery-mosaic" id="gallery-mosaic">
        {GALLERY_ALBUMS.map((album) => (
          <div 
            class="mosaic-item" 
            data-category={album.category.toLowerCase()}
            id={album.id}
          >
            <button 
              class="mosaic-card-btn open-album-btn" 
              data-album={JSON.stringify(album)}
              aria-label={`Ver álbum completo: ${album.title}`}
            >
              <div class="mosaic-img-box">
                <img 
                  src={getHref(album.coverImage)} 
                  alt={album.title} 
                  width="320" 
                  height="180" 
                  loading="lazy" 
                  class="mosaic-img"
                />
                <span class="category-tag">{album.category}</span>
                <span class="photos-count-badge">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                  {album.slides.length} {album.slides.length === 1 ? 'Foto' : 'Fotos'}
                </span>
                <span class="zoom-hover-badge">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                  AMPLIAR
                </span>
              </div>
              <div class="mosaic-info-box">
                <span class="info-date">{album.date}</span>
                <h3 class="info-title">{album.title}</h3>
                <p class="info-caption">{album.summary}</p>
              </div>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Lightbox Carousel Modal with Pure Arrow Navigation -->
  <dialog id="gallery-carousel-modal" class="gallery-modal-dialog">
    <div class="gallery-modal-inner">
      <button class="gallery-modal-close" id="modal-close-btn" aria-label="Cerrar modal">&times;</button>
      
      <div class="gallery-modal-header">
        <div class="modal-header-top">
          <span class="gallery-modal-category" id="album-category-display">VINCULACIÓN</span>
          <span class="modal-counter-badge" id="carousel-counter">Foto 1 de 4</span>
        </div>
        <h2 class="gallery-modal-title" id="album-title-display">Título del Álbum</h2>
      </div>

      <!-- Main Stage with Prominent Lateral Arrow Buttons -->
      <div class="gallery-carousel-stage">
        <button class="carousel-nav-btn prev-btn" id="carousel-prev-btn" aria-label="Foto anterior">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        </button>
        
        <div class="carousel-slide-box">
          <img id="carousel-slide-img" src="" alt="" class="carousel-main-img" />
          <div class="carousel-caption-bar">
            <h4 class="slide-title" id="carousel-slide-title">Título de la fotografía</h4>
            <p class="slide-desc" id="carousel-slide-desc">Descripción de la fotografía</p>
          </div>
        </div>

        <button class="carousel-nav-btn next-btn" id="carousel-next-btn" aria-label="Foto siguiente">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
      </div>

      <!-- Subtle keyboard helper text -->
      <div class="modal-keyboard-hint">
        <span>Usa las flechas laterales o las teclas &#8592; / &#8594; para navegar</span>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
  }

  .gallery-section {
    padding: 3.5rem 0 5rem;
    background-color: var(--color-bg-light);
  }

  .filter-bar {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.5rem 1.25rem;
    border-radius: 25px;
    background-color: var(--color-white);
    color: var(--color-navy);
    border: 1px solid var(--color-border-light);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover,
  .filter-btn.active {
    background-color: var(--color-cyan);
    color: var(--color-white);
    border-color: var(--color-cyan);
    box-shadow: 0 4px 12px rgba(5, 135, 189, 0.3);
  }

  /* 4-Column Responsive Compact Grid */
  .gallery-mosaic {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }

  .mosaic-item {
    background-color: #ffffff;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    display: flex;
    flex-direction: column;
  }

  .mosaic-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .mosaic-card-btn {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background: transparent;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
  }

  /* Image box: object-fit contain to see the FULL photo without clipping */
  .mosaic-img-box {
    position: relative;
    width: 100%;
    height: 180px;
    background: #06192e;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .mosaic-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .mosaic-card-btn:hover .mosaic-img {
    transform: scale(1.03);
  }

  .category-tag {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    background: rgba(7, 28, 52, 0.88);
    backdrop-filter: blur(4px);
    color: var(--color-cyan);
    border: 1px solid var(--color-cyan);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
  }

  .photos-count-badge {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    z-index: 2;
  }

  .zoom-hover-badge {
    position: absolute;
    bottom: 0.65rem;
    right: 0.65rem;
    background: rgba(5, 135, 189, 0.95);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    opacity: 0;
    transform: translateY(4px);
    transition: all 0.2s ease;
    z-index: 2;
  }

  .mosaic-card-btn:hover .zoom-hover-badge {
    opacity: 1;
    transform: translateY(0);
  }

  .mosaic-info-box {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .info-date {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-cyan);
    margin-bottom: 0.25rem;
  }

  .info-title {
    font-size: 0.98rem;
    color: var(--color-navy);
    line-height: 1.3;
    margin-bottom: 0.4rem;
    font-weight: 700;
  }

  .info-caption {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Lightbox Carousel Modal */
  .gallery-modal-dialog {
    border: none;
    border-radius: 16px;
    padding: 0;
    max-width: 960px;
    width: 95vw;
    background: #061b31;
    color: #ffffff;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65);
    margin: auto;
  }

  .gallery-modal-dialog::backdrop {
    background: rgba(4, 15, 28, 0.88);
    backdrop-filter: blur(8px);
  }

  .gallery-modal-inner {
    position: relative;
    padding: 1.75rem 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .gallery-modal-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: transparent;
    border: none;
    font-size: 2.2rem;
    color: #ffffff;
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s ease, transform 0.2s ease;
    z-index: 20;
  }

  .gallery-modal-close:hover {
    color: var(--color-cyan);
    transform: scale(1.1);
  }

  .modal-header-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .gallery-modal-category {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-cyan);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .modal-counter-badge {
    background: rgba(5, 135, 189, 0.2);
    border: 1px solid var(--color-cyan);
    color: var(--color-cyan);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 12px;
  }

  .gallery-modal-title {
    font-size: 1.35rem;
    color: #ffffff;
  }

  .gallery-carousel-stage {
    position: relative;
    width: 100%;
    height: 500px;
    background: #020c17;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .carousel-slide-box {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-main-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: opacity 0.25s ease;
  }

  .carousel-caption-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(2, 12, 23, 0.92) 0%, rgba(2, 12, 23, 0.6) 70%, transparent 100%);
    padding: 1.5rem 1.75rem 1rem;
    color: #ffffff;
  }

  .slide-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    color: #ffffff;
  }

  .slide-desc {
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.45;
  }

  /* Large Prominent Floating Lateral Navigation Arrows */
  .carousel-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(5, 135, 189, 0.85);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
  }

  .carousel-nav-btn:hover {
    background: #0587bd;
    transform: translateY(-50%) scale(1.12);
    box-shadow: 0 8px 22px rgba(5, 135, 189, 0.5);
  }

  .prev-btn { left: 1.25rem; }
  .next-btn { right: 1.25rem; }

  .modal-keyboard-hint {
    text-align: center;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 1100px) {
    .gallery-mosaic {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }
  }

  @media (max-width: 768px) {
    .gallery-mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .gallery-carousel-stage {
      height: 340px;
    }
    .gallery-modal-inner {
      padding: 1.25rem 1rem;
    }
    .carousel-nav-btn {
      width: 40px;
      height: 40px;
    }
  }

  @media (max-width: 480px) {
    .gallery-mosaic {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const baseUrl = '/ieee-ntc-yachay';
    function resolveUrl(path: string) {
      if (!path) return '';
      if (path.startsWith('http') || path.startsWith(baseUrl)) return path;
      return `${baseUrl.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
    }

    // 1. Category Filtering
    const filterButtons = document.querySelectorAll('.filter-btn');
    const mosaicItems = document.querySelectorAll('.mosaic-item');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter') || 'todas';

        mosaicItems.forEach((item) => {
          const itemCat = item.getAttribute('data-category') || '';
          if (filter === 'todas' || itemCat === filter) {
            (item as HTMLElement).style.display = 'flex';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // 2. Carousel Lightbox Modal
    const modal = document.getElementById('gallery-carousel-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('modal-close-btn');
    const prevBtn = document.getElementById('carousel-prev-btn');
    const nextBtn = document.getElementById('carousel-next-btn');

    const catEl = document.getElementById('album-category-display');
    const titleEl = document.getElementById('album-title-display');

    const slideImg = document.getElementById('carousel-slide-img') as HTMLImageElement | null;
    const counterEl = document.getElementById('carousel-counter');
    const slideTitleEl = document.getElementById('carousel-slide-title');
    const slideDescEl = document.getElementById('carousel-slide-desc');

    let currentAlbum: any = null;
    let currentIndex = 0;

    function renderSlide(idx: number) {
      if (!currentAlbum || !currentAlbum.slides || currentAlbum.slides.length === 0) return;
      currentIndex = (idx + currentAlbum.slides.length) % currentAlbum.slides.length;
      const slide = currentAlbum.slides[currentIndex];

      if (slideImg) slideImg.src = resolveUrl(slide.image);
      if (counterEl) counterEl.textContent = `Foto ${currentIndex + 1} de ${currentAlbum.slides.length}`;
      if (slideTitleEl) slideTitleEl.textContent = slide.title;
      if (slideDescEl) slideDescEl.textContent = slide.caption;
    }

    document.querySelectorAll('.open-album-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-album');
        if (!raw || !modal) return;
        currentAlbum = JSON.parse(raw);
        currentIndex = 0;

        if (catEl) catEl.textContent = currentAlbum.category.toUpperCase();
        if (titleEl) titleEl.textContent = currentAlbum.title;

        renderSlide(0);
        modal.showModal();
      });
    });

    prevBtn?.addEventListener('click', () => renderSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => renderSlide(currentIndex + 1));

    document.addEventListener('keydown', (e) => {
      if (modal?.open) {
        if (e.key === 'ArrowLeft') renderSlide(currentIndex - 1);
        if (e.key === 'ArrowRight') renderSlide(currentIndex + 1);
      }
    });

    closeBtn?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  });
</script>
