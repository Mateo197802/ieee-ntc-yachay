---
import Layout from '@/layouts/Layout.astro';
import { GALLERY_DATA } from '@/data/gallery';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

const categories = ['All', 'Outreach', 'Conferences', 'Workshops', 'Community'];
---

<Layout 
  title="Photo & Video Gallery | IEEE Nanotechnology Council Yachay Tech"
  description="Visual record of IEEE Nanotechnology Council Yachay Tech student activities, outreach in high schools, pediatric hospital visits, workshops, and TEMSCON LATAM conference participation."
>
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>Gallery</span>
      </div>
      <h1 class="banner-title font-heading">PHOTO & VIDEO GALLERY</h1>
      <p class="banner-subtitle">Documenting our chapter history, STEM workshops, community service, and scientific conferences.</p>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="gallery-section">
    <div class="site-container">
      <!-- Filter Buttons Bar -->
      <div class="filter-bar" role="tablist" aria-label="Gallery Categories">
        {categories.map((cat, idx) => (
          <button 
            class={`filter-btn ${idx === 0 ? 'active' : ''}`}
            data-filter={cat.toLowerCase()}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Gallery Grid -->
      <div class="gallery-mosaic" id="gallery-mosaic">
        {GALLERY_DATA.map((item, index) => (
          <div 
            class="mosaic-item" 
            data-category={item.category.toLowerCase()}
            data-index={index}
          >
            <button class="mosaic-card-btn" aria-label={`View larger image: ${item.title}`}>
              <div class="mosaic-img-box">
                <img 
                  src={getHref(item.image)} 
                  alt={item.title} 
                  width="400" 
                  height="300" 
                  loading="lazy" 
                  class="mosaic-img"
                  style={`object-position: ${item.position || 'center center'};`}
                />
                <span class="category-tag">{item.category}</span>
                <span class="zoom-hover-badge">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                  EXPAND
                </span>
              </div>
              <div class="mosaic-info-box">
                <span class="info-date">{item.date}</span>
                <h3 class="info-title">{item.title}</h3>
                <p class="info-caption">{item.caption}</p>
              </div>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Accessible Lightbox Modal -->
  <div class="lightbox-modal" id="lightbox-modal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="lightbox-backdrop" id="lightbox-backdrop"></div>
    <div class="lightbox-content">
      <button class="lightbox-close" id="lightbox-close-btn" aria-label="Close image modal">&times;</button>

      <button class="lightbox-nav prev" id="lightbox-prev-btn" aria-label="Previous image">&#10094;</button>

      <div class="lightbox-stage">
        <img src="" alt="" id="lightbox-img" class="lightbox-main-img" />
        <div class="lightbox-caption-box">
          <span class="lightbox-cat" id="lightbox-cat"></span>
          <h3 id="lightbox-title"></h3>
          <p id="lightbox-caption"></p>
        </div>
      </div>

      <button class="lightbox-nav next" id="lightbox-next-btn" aria-label="Next image">&#10095;</button>
    </div>
  </div>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
  }

  .gallery-section {
    padding: 4.5rem 0;
    background-color: var(--color-bg-light);
  }

  .filter-bar {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.6rem 1.5rem;
    border-radius: 25px;
    background-color: var(--color-white);
    border: 1px solid var(--color-border-light);
    color: var(--color-navy);
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-subtle);
  }

  .filter-btn.active,
  .filter-btn:hover {
    background-color: var(--color-cyan);
    color: var(--color-white);
    border-color: var(--color-cyan);
  }

  /* Responsive Mosaic Grid */
  .gallery-mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .mosaic-item {
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    background-color: var(--color-white);
    border: 1px solid var(--color-border-light);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .mosaic-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .mosaic-card-btn {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    text-align: left;
  }

  .mosaic-img-box {
    position: relative;
    width: 100%;
    height: 250px;
    background-color: #071C34;
    overflow: hidden;
  }

  .mosaic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .mosaic-card-btn:hover .mosaic-img {
    transform: scale(1.05);
  }

  .category-tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background-color: rgba(7, 28, 52, 0.85);
    color: var(--color-cyan);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 15px;
    border: 1px solid rgba(5, 135, 189, 0.4);
    backdrop-filter: blur(4px);
  }

  .zoom-hover-badge {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background-color: rgba(5, 135, 189, 0.9);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 15px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    opacity: 0;
    transform: translateY(4px);
    transition: all 0.2s ease;
  }

  .mosaic-card-btn:hover .zoom-hover-badge {
    opacity: 1;
    transform: translateY(0);
  }

  .mosaic-info-box {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background-color: var(--color-white);
    flex-grow: 1;
  }

  .info-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .info-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.35;
    margin: 0;
  }

  .info-caption {
    font-size: 0.82rem;
    color: var(--color-text-dark);
    line-height: 1.45;
    margin-top: 0.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Lightbox Modal */
  .lightbox-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 3000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .lightbox-modal.open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(7, 28, 52, 0.94);
    backdrop-filter: blur(8px);
  }

  .lightbox-content {
    position: relative;
    z-index: 3010;
    max-width: 92vw;
    max-height: 92vh;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .lightbox-stage {
    background-color: #071C34;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    max-width: 820px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
    border: 2px solid var(--color-cyan);
  }

  .lightbox-main-img {
    width: 100%;
    max-height: 62vh;
    object-fit: contain;
    display: block;
    background-color: #000;
  }

  .lightbox-caption-box {
    padding: 1.25rem 1.5rem;
    color: var(--color-white);
  }

  .lightbox-cat {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-cyan);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.25rem;
  }

  .lightbox-caption-box h3 {
    font-size: 1.25rem;
    color: var(--color-white);
    margin: 0 0 0.4rem 0;
  }

  .lightbox-caption-box p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5;
    margin: 0;
  }

  .lightbox-close {
    position: absolute;
    top: -45px;
    right: 0;
    background: transparent;
    border: none;
    color: var(--color-white);
    font-size: 2.5rem;
    cursor: pointer;
    line-height: 1;
  }

  .lightbox-nav {
    background: var(--color-cyan);
    color: var(--color-white);
    border: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .lightbox-nav:hover {
    background-color: #04709d;
    transform: scale(1.08);
  }

  @media (max-width: 1024px) {
    .gallery-mosaic {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .gallery-mosaic {
      grid-template-columns: 1fr;
    }
    .lightbox-nav {
      width: 38px;
      height: 38px;
      font-size: 1.1rem;
    }
  }
</style>

<script>
  import { GALLERY_DATA } from '@/data/gallery';

  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.mosaic-item');

    // Category Filter Logic
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        const filter = btn.getAttribute('data-filter');

        items.forEach((item) => {
          const category = item.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            (item as HTMLElement).style.display = 'block';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Lightbox Interactive Logic
    const modal = document.getElementById('lightbox-modal');
    const backdrop = document.getElementById('lightbox-backdrop');
    const closeBtn = document.getElementById('lightbox-close-btn');
    const prevBtn = document.getElementById('lightbox-prev-btn');
    const nextBtn = document.getElementById('lightbox-next-btn');

    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const modalCat = document.getElementById('lightbox-cat');
    const modalTitle = document.getElementById('lightbox-title');
    const modalCaption = document.getElementById('lightbox-caption');

    let currentIndex = 0;

    function openLightbox(index: number) {
      currentIndex = index;
      const data = GALLERY_DATA[currentIndex];
      if (!data) return;

      const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
      const fullPath = baseUrl === '' ? data.image : `${baseUrl}${data.image}`;

      if (modalImg) modalImg.src = fullPath;
      if (modalImg) modalImg.alt = data.title;
      if (modalCat) modalCat.textContent = `${data.category} • ${data.date}`;
      if (modalTitle) modalTitle.textContent = data.title;
      if (modalCaption) modalCaption.textContent = data.caption;

      modal?.classList.add('open');
      modal?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      modal?.classList.remove('open');
      modal?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function showPrev() {
      currentIndex = (currentIndex - 1 + GALLERY_DATA.length) % GALLERY_DATA.length;
      openLightbox(currentIndex);
    }

    function showNext() {
      currentIndex = (currentIndex + 1) % GALLERY_DATA.length;
      openLightbox(currentIndex);
    }

    document.querySelectorAll('.mosaic-card-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const item = (e.currentTarget as HTMLElement).closest('.mosaic-item');
        const idx = parseInt(item?.getAttribute('data-index') || '0', 10);
        openLightbox(idx);
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    backdrop?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', showPrev);
    nextBtn?.addEventListener('click', showNext);

    document.addEventListener('keydown', (e) => {
      if (!modal?.classList.contains('open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
    });
  });
</script>
