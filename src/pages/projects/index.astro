---
import Layout from '@/layouts/Layout.astro';
import { PROJECTS_DATA } from '@/data/projects';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Projects & Initiatives | IEEE Nanotechnology Council Yachay Tech"
  description="Explore our scientific research incubators, STEM outreach programs, Virtual Reality molecular simulations, and community service initiatives."
>
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>Projects</span>
      </div>
      <h1 class="banner-title font-heading">PROJECTS & INITIATIVES</h1>
      <p class="banner-subtitle">Interdisciplinary research, educational outreach, Virtual Reality innovation, and community service.</p>
    </div>
  </section>

  <section class="projects-section">
    <div class="site-container">
      <div class="projects-grid">
        {PROJECTS_DATA.map((project) => (
          <div class="project-card">
            <div class="project-img-box">
              <img src={getHref(project.image)} alt={project.title} width="400" height="240" loading="lazy" class="project-img" />
              <span class={`status-badge ${project.status.toLowerCase()}`}>{project.status}</span>
              <span class="category-pill">{project.category}</span>
            </div>

            <div class="project-body">
              <h2 class="project-title">{project.title}</h2>
              <p class="project-desc">{project.description}</p>

              <div class="project-tech-stack">
                <span class="stack-label">Technologies / Focus:</span>
                <div class="tags-row">
                  {project.technologies.map((tech) => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                </div>
              </div>

              {project.outcomes && (
                <div class="outcomes-box">
                  <strong>Outcomes / Impact:</strong> <span>{project.outcomes}</span>
                </div>
              )}

              <div class="project-team-row">
                <strong>Team:</strong> <span>{project.team.join(', ')}</span>
              </div>

              {project.paperUrl && (
                <div class="project-action-row">
                  <a href={project.paperUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark project-cta">
                    VIEW PROGRAM / CONFERENCE
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6v2H5v12h12v-6h2v6c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z"/></svg>
                  </a>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
  }

  .projects-section {
    padding: 4.5rem 0;
    background-color: var(--color-bg-light);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .project-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .project-img-box {
    position: relative;
    height: 250px;
    background-color: #06192e;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .status-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.65rem;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .status-badge.active {
    background-color: rgba(16, 185, 129, 0.9);
    color: #ffffff;
  }

  .status-badge.completed {
    background-color: rgba(5, 135, 189, 0.9);
    color: #ffffff;
  }

  .category-pill {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: rgba(7, 28, 52, 0.85);
    color: var(--color-cyan);
    border: 1px solid var(--color-cyan);
    padding: 0.25rem 0.65rem;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .project-body {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-title {
    font-size: 1.35rem;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .project-desc {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .project-tech-stack {
    margin-bottom: 1.25rem;
  }

  .stack-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-tag {
    background-color: var(--color-bg-light);
    color: var(--color-navy);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid var(--color-border-light);
  }

  .outcomes-box {
    background-color: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: var(--border-radius-sm);
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    color: #166534;
    margin-bottom: 1.25rem;
    line-height: 1.45;
  }

  .outcomes-box strong {
    font-weight: 700;
  }

  .project-team-row {
    font-size: 0.85rem;
    color: var(--color-text-dark);
    margin-bottom: 1.5rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-light);
  }

  .project-team-row strong {
    color: var(--color-navy);
  }

  .project-action-row {
    display: flex;
    justify-content: flex-end;
  }

  .project-cta {
    font-size: 0.85rem;
    padding: 0.55rem 1rem;
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
