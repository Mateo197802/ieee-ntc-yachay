---
import Layout from '@/layouts/Layout.astro';
import { PROJECTS_DATA } from '@/data/projects';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Proyectos e Iniciativas | IEEE Nanotechnology Council Yachay Tech"
  description="Explora nuestros semilleros de investigación científica, programas de divulgación STEM, simulaciones en Realidad Virtual e iniciativas de servicio social."
>
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Inicio</a> &gt; <span>Proyectos</span>
      </div>
      <h1 class="banner-title font-heading">PROYECTOS E INICIATIVAS</h1>
      <p class="banner-subtitle">Investigación interdisciplinaria, divulgación educativa, innovación en Realidad Virtual y servicio a la comunidad.</p>
    </div>
  </section>

  <section class="projects-section">
    <div class="site-container">
      <div class="projects-grid">
        {PROJECTS_DATA.map((project) => (
          <div class="project-card">
            <div class="project-img-box">
              <img src={getHref(project.image)} alt={project.title} width="400" height="240" loading="lazy" class="project-img" />
              <span class={`status-badge ${project.status.toLowerCase()}`}>{project.status}</span>
              <span class="category-pill">{project.category}</span>
            </div>

            <div class="project-body">
              <h2 class="project-title">{project.title}</h2>
              <p class="project-desc">{project.description}</p>

              <div class="project-tech-stack">
                <span class="stack-label">Tecnologías / Enfoque:</span>
                <div class="tags-row">
                  {project.technologies.map((tech) => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                </div>
              </div>

              {project.outcomes && (
                <div class="outcomes-box">
                  <strong>Resultados / Impacto:</strong> {project.outcomes}
                </div>
              )}

              <div class="project-team-row">
                <strong>Equipo:</strong> {project.team.join(', ')}
              </div>

              {project.paperUrl && (
                <div class="project-action-row">
                  <a href={project.paperUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark project-cta">
                    VER PROGRAMA / CONFERENCIA
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6v2H5v12h12v-6h2v6c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z"/></svg>
                  </a>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
  }

  .projects-section {
    padding: 4.5rem 0;
    background-color: var(--color-bg-light);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .project-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .project-img-box {
    position: relative;
    height: 250px;
    background-color: var(--color-navy);
    overflow: hidden;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  .status-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.3rem 0.65rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
  }

  .status-badge.activo {
    background-color: #10B981;
    color: var(--color-white);
  }

  .status-badge.completado {
    background-color: #122844;
    color: var(--color-white);
  }

  .status-badge.planificación {
    background-color: #6B7280;
    color: var(--color-white);
  }

  .category-pill {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(7, 28, 52, 0.85);
    color: var(--color-cyan);
    border: 1px solid var(--color-cyan);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.3rem 0.65rem;
    border-radius: 20px;
    z-index: 2;
  }

  .project-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-title {
    font-size: 1.25rem;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .project-desc {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .project-tech-stack {
    margin-bottom: 1rem;
  }

  .stack-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-navy);
    display: block;
    margin-bottom: 0.4rem;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-tag {
    font-size: 0.75rem;
    background-color: var(--color-bg-alt);
    color: var(--color-navy);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .outcomes-box {
    background-color: rgba(5, 135, 189, 0.08);
    border-left: 3px solid var(--color-cyan);
    padding: 0.75rem 1rem;
    border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0;
    font-size: 0.85rem;
    color: var(--color-navy);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .project-team-row {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .project-action-row {
    margin-top: 1rem;
  }

  .project-cta {
    width: 100%;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
