---
import Layout from '@/layouts/Layout.astro';
import { PROJECTS_DATA } from '@/data/projects';
import { NANONEWS_ISSUES } from '@/data/nanonews';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Projects & Initiatives | IEEE Nanotechnology Council Yachay Tech"
  description="Discover our flagship research and outreach projects: VR NanoLab immersive simulations, Logic Lock automated paper discovery, IEEE LANANO 2026 publication incubator, and official NanoNews bulletins."
>
  <!-- Inner Page Banner -->
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>Projects</span>
      </div>
      <span class="banner-eyebrow">FRONTIER RESEARCH & INNOVATION</span>
      <h1 class="banner-title font-heading">PROJECTS & INITIATIVES</h1>
      <p class="banner-subtitle">
        Bridging cleanroom materials research, digital literature automation, Virtual Reality outreach in hospitals and schools, and peer-reviewed international publications.
      </p>
    </div>
  </section>

  <!-- Flagship Projects Section -->
  <section class="projects-section">
    <div class="site-container">
      <div class="projects-grid">
        {PROJECTS_DATA.map((project) => (
          <div class="project-card">
            <div class="project-img-box">
              <img src={getHref(project.image)} alt={project.title} width="400" height="240" loading="lazy" class="project-img" />
              <span class={`status-badge ${project.status.toLowerCase()}`}>{project.status}</span>
              <span class="category-pill">{project.category}</span>
            </div>

            <div class="project-body">
              <h2 class="project-title">{project.title}</h2>
              <p class="project-desc">{project.description}</p>

              <!-- Detailed 5-Point Project Scope Breakdown -->
              {(project.what || project.objective || project.impact) && (
                <div class="project-breakdown-box">
                  {project.what && (
                    <div class="breakdown-row">
                      <strong>Core Initiative:</strong> <span>{project.what}</span>
                    </div>
                  )}
                  {project.who && (
                    <div class="breakdown-row">
                      <strong>Contributors:</strong> <span>{project.who}</span>
                    </div>
                  )}
                  {project.objective && (
                    <div class="breakdown-row">
                      <strong>Strategic Objective:</strong> <span>{project.objective}</span>
                    </div>
                  )}
                  {project.impact && (
                    <div class="breakdown-row highlight-impact">
                      <strong>Demonstrated Impact:</strong> <span>{project.impact}</span>
                    </div>
                  )}
                </div>
              )}

              <div class="project-tech-stack">
                <span class="stack-label">Technologies / Focus:</span>
                <div class="tags-row">
                  {project.technologies.map((tech) => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                </div>
              </div>

              {project.outcomes && (
                <div class="outcomes-box">
                  <strong>Outcomes & Deployments:</strong> <span>{project.outcomes}</span>
                </div>
              )}

              <div class="project-team-row">
                <strong>Project Team:</strong> <span>{project.team.join(', ')}</span>
              </div>

              {project.paperUrl && (
                <div class="project-action-row">
                  <a href={project.paperUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark project-cta">
                    <span>VIEW PROGRAM / PUBLICATION PORTAL</span>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6v2H5v12h12v-6h2v6c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z"/></svg>
                  </a>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NEW NANONEWS SECTION: Stacked Cards Animation & Interactive Viewer -->
  <section class="nanonews-section" id="nanonews">
    <div class="site-container">
      <div class="section-header text-center">
        <span class="section-eyebrow">EDITORIAL SERIES & SCIENTIFIC INFOGRAPHICS</span>
        <h2 class="section-title font-heading">NANONEWS BULLETIN</h2>
        <p class="section-subtitle">
          Explore our periodic visual publications, chapter onboarding roadmaps, and high-impact scientific writing guides. Click any edition to read the full multi-page visual document.
        </p>
      </div>

      <div class="nanonews-grid">
        {NANONEWS_ISSUES.map((issue) => (
          <div class="nanonews-card-container">
            <button 
              class="nanonews-stacked-trigger open-nanonews-btn" 
              data-issue={JSON.stringify(issue)}
              aria-label={`Open full reader for ${issue.title}`}
            >
              <!-- 3D Stacked Deck Layers -->
              <div class="stacked-deck">
                <div class="deck-layer deck-layer-3" aria-hidden="true"></div>
                <div class="deck-layer deck-layer-2" aria-hidden="true"></div>
                <div class="deck-layer deck-layer-1">
                  <img 
                    src={getHref(issue.coverImage)} 
                    alt={issue.title} 
                    width="380" 
                    height="480" 
                    loading="lazy" 
                    class="nanonews-cover-img" 
                  />
                  <div class="cover-glow-overlay"></div>
                  <span class="issue-badge">EDITION #{issue.issueNumber}</span>
                  <span class="pages-badge">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
                    {issue.totalPages} Pages
                  </span>
                  <div class="expand-prompt">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                    <span>CLICK TO READ ISSUE</span>
                  </div>
                </div>
              </div>

              <!-- Content Summary Box -->
              <div class="nanonews-info-box">
                <h3 class="nanonews-title">{issue.title}</h3>
                <span class="nanonews-subtitle">{issue.subtitle}</span>
                <p class="nanonews-summary">{issue.summary}</p>
                <div class="nanonews-topics">
                  {issue.topics.map((t) => (
                    <span class="topic-tag">{t}</span>
                  ))}
                </div>
                <div class="read-action-bar">
                  <span class="read-btn-label">OPEN FULL DOCUMENT ({issue.totalPages} PAGES) &rarr;</span>
                </div>
              </div>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive NanoNews Reader Modal Dialog -->
  <dialog id="nanonews-modal" class="nanonews-modal-dialog">
    <div class="nanonews-modal-inner">
      <button class="nanonews-modal-close" id="nanonews-close-btn" aria-label="Close reader">&times;</button>
      
      <div class="nanonews-modal-header">
        <div class="modal-header-meta">
          <span class="modal-badge-issue" id="reader-issue-badge">EDITION #1</span>
          <span class="modal-counter-badge" id="reader-page-counter">Page 1 of 6</span>
        </div>
        <h2 class="nanonews-modal-title" id="reader-title-display">NanoNews Title</h2>
        <p class="nanonews-modal-subtitle" id="reader-subtitle-display">Subtitle description</p>
      </div>

      <!-- Main Document Viewer Viewport -->
      <div class="nanonews-viewer-stage">
        <button class="viewer-nav-btn prev-btn" id="reader-prev-btn" aria-label="Previous page">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        </button>

        <div class="viewer-page-wrapper">
          <img id="reader-page-img" src="" alt="NanoNews Page View" class="reader-current-img" />
        </div>

        <button class="viewer-nav-btn next-btn" id="reader-next-btn" aria-label="Next page">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
      </div>

      <!-- Navigation Dots & Helper -->
      <div class="nanonews-modal-footer">
        <div class="reader-dots-container" id="reader-dots"></div>
        <span class="reader-hint">Use lateral arrows or keyboard &larr; / &rarr; to flip pages</span>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3.5rem 0 4rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--color-cyan);
    margin-bottom: 0.5rem;
  }

  .banner-title {
    font-size: clamp(2.2rem, 3.8vw, 3rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.88);
    margin-top: 0.5rem;
    max-width: 820px;
    line-height: 1.6;
  }

  .projects-section {
    padding: 4.5rem 0 5rem;
    background-color: var(--color-bg-light);
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .project-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    display: grid;
    grid-template-columns: 420px 1fr;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-cyan);
  }

  .project-img-box {
    position: relative;
    background-color: #06192e;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-normal);
  }

  .project-card:hover .project-img {
    transform: scale(1.04);
  }

  .status-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.65rem;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    z-index: 2;
  }

  .status-badge.active {
    background-color: rgba(16, 185, 129, 0.95);
    color: #ffffff;
  }

  .status-badge.completed {
    background-color: rgba(5, 135, 189, 0.95);
    color: #ffffff;
  }

  .category-pill {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: rgba(7, 28, 52, 0.88);
    color: var(--color-cyan);
    border: 1px solid var(--color-cyan);
    padding: 0.25rem 0.65rem;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    z-index: 2;
  }

  .project-body {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-title {
    font-size: 1.45rem;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .project-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .project-breakdown-box {
    background-color: var(--color-bg-light);
    border-left: 3px solid var(--color-cyan);
    border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0;
    padding: 1.1rem 1.25rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .breakdown-row {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--color-text-dark);
  }

  .breakdown-row strong {
    color: var(--color-navy);
    font-weight: 700;
  }

  .breakdown-row.highlight-impact {
    border-top: 1px dashed var(--color-border-light);
    padding-top: 0.4rem;
    margin-top: 0.2rem;
  }

  .project-tech-stack {
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .stack-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .tags-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tech-tag {
    background-color: var(--color-bg-light);
    color: var(--color-navy);
    border: 1px solid var(--color-border-light);
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .outcomes-box {
    background-color: rgba(5, 135, 189, 0.06);
    border-radius: var(--border-radius-sm);
    padding: 0.85rem 1rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .outcomes-box strong {
    color: var(--color-navy);
  }

  .project-team-row {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .project-team-row strong {
    color: var(--color-navy);
  }

  .project-action-row {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-light);
  }

  .project-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    padding: 0.6rem 1.1rem;
  }

  /* NANONEWS SECTION & 3D STACKED ANIMATION */
  .nanonews-section {
    padding: 5.5rem 0 6.5rem;
    background-color: var(--color-white);
    border-top: 1px solid var(--color-border-light);
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 720px;
    margin: 0.5rem auto 3.5rem;
    line-height: 1.6;
  }

  .nanonews-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .nanonews-card-container {
    display: flex;
  }

  .nanonews-stacked-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
    display: flex;
    flex-direction: column;
    width: 100%;
    perspective: 1000px;
  }

  /* 3D Stacked Deck Effect */
  .stacked-deck {
    position: relative;
    width: 100%;
    height: 480px;
    margin-bottom: 1.75rem;
  }

  .deck-layer {
    position: absolute;
    inset: 0;
    border-radius: var(--border-radius-md);
    background-color: #0c2340;
    border: 1px solid var(--color-border-light);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.3s ease;
  }

  /* Back Layer 3 */
  .deck-layer-3 {
    z-index: 1;
    background: linear-gradient(135deg, #153054 0%, #071C34 100%);
    transform: rotate(-3.5deg) translate(-6px, 8px) scale(0.96);
    opacity: 0.6;
  }

  /* Mid Layer 2 */
  .deck-layer-2 {
    z-index: 2;
    background: linear-gradient(135deg, #1A3C68 0%, #0c2340 100%);
    transform: rotate(3deg) translate(6px, 4px) scale(0.98);
    opacity: 0.85;
  }

  /* Front Layer 1 (Active Cover) */
  .deck-layer-1 {
    z-index: 3;
    background-color: #0c2340;
    overflow: hidden;
    box-shadow: 0 15px 30px -8px rgba(0, 0, 0, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nanonews-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .cover-glow-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 28, 52, 0.7) 0%, transparent 60%);
    pointer-events: none;
  }

  .issue-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: var(--color-cyan);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 10px rgba(5, 135, 189, 0.4);
  }

  .pages-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: rgba(7, 28, 52, 0.9);
    color: #ffffff;
    border: 1px solid var(--color-cyan);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.3rem 0.65rem;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .expand-prompt {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(7, 28, 52, 0.92);
    border: 1px solid var(--color-cyan);
    color: var(--color-cyan);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 0.45rem 1.1rem;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
    white-space: nowrap;
  }

  /* Hover 3D Stack Expansion */
  .nanonews-stacked-trigger:hover .deck-layer-1 {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 25px 45px -10px rgba(5, 135, 189, 0.3), 0 15px 25px -5px rgba(31, 62, 101, 0.2);
    border-color: var(--color-cyan);
  }

  .nanonews-stacked-trigger:hover .deck-layer-2 {
    transform: rotate(6deg) translate(14px, 6px) scale(0.98);
    opacity: 1;
    border-color: rgba(5, 135, 189, 0.5);
  }

  .nanonews-stacked-trigger:hover .deck-layer-3 {
    transform: rotate(-6deg) translate(-14px, 12px) scale(0.95);
    opacity: 0.85;
    border-color: rgba(5, 135, 189, 0.4);
  }

  .nanonews-stacked-trigger:hover .expand-prompt {
    background: var(--color-cyan);
    color: #ffffff;
    transform: translateX(-50%) translateY(-2px);
    box-shadow: 0 4px 14px rgba(5, 135, 189, 0.5);
  }

  /* NanoNews Info Box */
  .nanonews-info-box {
    background-color: var(--color-bg-light);
    border-radius: var(--border-radius-md);
    padding: 1.75rem;
    border: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    flex: 1;
    transition: border-color 0.3s ease;
  }

  .nanonews-stacked-trigger:hover .nanonews-info-box {
    border-color: var(--color-cyan);
  }

  .nanonews-title {
    font-size: 1.3rem;
    color: var(--color-navy);
    margin-bottom: 0.35rem;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .nanonews-stacked-trigger:hover .nanonews-title {
    color: var(--color-institutional-blue);
  }

  .nanonews-subtitle {
    font-size: 0.85rem;
    color: var(--color-cyan);
    font-weight: 700;
    margin-bottom: 0.75rem;
    display: block;
  }

  .nanonews-summary {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .nanonews-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
  }

  .topic-tag {
    font-size: 0.72rem;
    background-color: var(--color-white);
    color: var(--color-navy);
    border: 1px solid var(--color-border-light);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .read-action-bar {
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border-light);
  }

  .read-btn-label {
    font-size: 0.84rem;
    color: var(--color-cyan);
    font-weight: 700;
    letter-spacing: 0.3px;
    display: block;
  }

  /* Interactive NanoNews Full Reader Lightbox Modal */
  .nanonews-modal-dialog {
    border: none;
    padding: 0;
    background: transparent;
  }

  .nanonews-modal-inner {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2rem;
    position: relative;
    border-top: 4px solid var(--color-cyan);
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.75);
    width: 100%;
    max-width: 820px;
  }

  .nanonews-modal-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: none;
    border: none;
    font-size: 1.85rem;
    color: var(--color-navy);
    cursor: pointer;
    line-height: 1;
    z-index: 10;
  }

  .modal-header-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  .modal-badge-issue {
    color: var(--color-cyan);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .modal-counter-badge {
    background-color: rgba(5, 135, 189, 0.12);
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 12px;
  }

  .nanonews-modal-title {
    font-size: 1.4rem;
    color: var(--color-navy);
    margin-bottom: 0.25rem;
  }

  .nanonews-modal-subtitle {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    margin-bottom: 1.5rem;
  }

  /* Main Viewer Stage */
  .nanonews-viewer-stage {
    position: relative;
    background-color: #071C34;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 520px;
    max-height: 65vh;
  }

  .viewer-page-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .reader-current-img {
    max-width: 100%;
    max-height: 60vh;
    object-fit: contain;
    display: block;
    border-radius: 4px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    transition: opacity 0.2s ease;
  }

  .viewer-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(7, 28, 52, 0.85);
    border: 1px solid var(--color-cyan);
    color: #ffffff;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .viewer-nav-btn:hover {
    background: var(--color-cyan);
    transform: translateY(-50%) scale(1.1);
  }

  .viewer-nav-btn.prev-btn { left: 1rem; }
  .viewer-nav-btn.next-btn { right: 1rem; }

  /* Footer & Dots */
  .nanonews-modal-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .reader-dots-container {
    display: flex;
    gap: 0.5rem;
  }

  .dot-btn {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--color-border-light);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .dot-btn.active {
    background-color: var(--color-cyan);
    transform: scale(1.3);
  }

  .reader-hint {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* Responsive Rules */
  @media (max-width: 960px) {
    .project-card {
      grid-template-columns: 1fr;
    }
    .nanonews-grid {
      grid-template-columns: 1fr;
    }
    .stacked-deck {
      height: 420px;
    }
  }
</style>

<script>
  interface NanoNewsIssueData {
    id: string;
    issueNumber: number;
    title: string;
    subtitle: string;
    date: string;
    coverImage: string;
    totalPages: number;
    pages: string[];
    summary: string;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('nanonews-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('nanonews-close-btn');
    const titleDisplay = document.getElementById('reader-title-display');
    const subtitleDisplay = document.getElementById('reader-subtitle-display');
    const issueBadge = document.getElementById('reader-issue-badge');
    const pageCounter = document.getElementById('reader-page-counter');
    const pageImg = document.getElementById('reader-page-img') as HTMLImageElement | null;
    const prevBtn = document.getElementById('reader-prev-btn');
    const nextBtn = document.getElementById('reader-next-btn');
    const dotsContainer = document.getElementById('reader-dots');

    let currentIssue: NanoNewsIssueData | null = null;
    let currentPageIndex = 0;

    const baseUrl = (import.meta.env.BASE_URL || '').replace(/\/$/, '');
    function resolveHref(path: string) {
      if (path.startsWith('http')) return path;
      return `${baseUrl}${path}`;
    }

    function renderCurrentPage() {
      if (!currentIssue || !pageImg || !pageCounter || !dotsContainer) return;

      const pageSrc = currentIssue.pages[currentPageIndex];
      pageImg.style.opacity = '0';
      setTimeout(() => {
        pageImg.src = resolveHref(pageSrc);
        pageImg.style.opacity = '1';
      }, 100);

      pageCounter.textContent = `Page ${currentPageIndex + 1} of ${currentIssue.totalPages}`;

      // Update dots
      dotsContainer.innerHTML = '';
      currentIssue.pages.forEach((_, idx) => {
        const dot = document.createElement('button');
        dot.className = `dot-btn ${idx === currentPageIndex ? 'active' : ''}`;
        dot.setAttribute('aria-label', `Go to page ${idx + 1}`);
        dot.addEventListener('click', () => {
          currentPageIndex = idx;
          renderCurrentPage();
        });
        dotsContainer.appendChild(dot);
      });
    }

    document.querySelectorAll('.open-nanonews-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-issue');
        if (!raw || !modal) return;

        currentIssue = JSON.parse(raw);
        currentPageIndex = 0;

        if (titleDisplay && currentIssue) titleDisplay.textContent = currentIssue.title;
        if (subtitleDisplay && currentIssue) subtitleDisplay.textContent = currentIssue.subtitle;
        if (issueBadge && currentIssue) issueBadge.textContent = `EDITION #${currentIssue.issueNumber}`;

        renderCurrentPage();
        modal.showModal();
      });
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!currentIssue) return;
      if (currentPageIndex > 0) {
        currentPageIndex--;
      } else {
        currentPageIndex = currentIssue.totalPages - 1;
      }
      renderCurrentPage();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!currentIssue) return;
      if (currentPageIndex < currentIssue.totalPages - 1) {
        currentPageIndex++;
      } else {
        currentPageIndex = 0;
      }
      renderCurrentPage();
    });

    document.addEventListener('keydown', (e) => {
      if (!modal?.open || !currentIssue) return;
      if (e.key === 'ArrowLeft') {
        prevBtn?.click();
      } else if (e.key === 'ArrowRight') {
        nextBtn?.click();
      }
    });

    closeBtn?.addEventListener('click', () => {
      modal?.close();
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  });
</script>
