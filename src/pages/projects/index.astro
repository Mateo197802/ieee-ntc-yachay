---
import Layout from '@/layouts/Layout.astro';
import { PROJECTS_DATA } from '@/data/projects';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Projects & Initiatives | IEEE Nanotechnology Council Yachay Tech"
  description="Explore research paper pipelines, STEM school outreach programs, VR laboratory simulations, and social service initiatives."
>
  <section class="inner-banner">
    <div class="container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>Projects</span>
      </div>
      <h1 class="banner-title font-heading">PROJECTS & INITIATIVES</h1>
      <p class="banner-subtitle">Interdisciplinary research, educational outreach, VR innovation, and community service.</p>
    </div>
  </section>

  <section class="projects-section">
    <div class="container">
      <div class="projects-grid">
        {PROJECTS_DATA.map((project) => (
          <div class="project-card">
            <div class="project-img-box">
              <img src={getHref(project.image)} alt={project.title} width="400" height="240" loading="lazy" class="project-img" />
              <span class={`status-badge ${project.status.toLowerCase().replace(' ', '-')}`}>{project.status}</span>
              <span class="category-pill">{project.category}</span>
            </div>

            <div class="project-body">
              <h2 class="project-title">{project.title}</h2>
              <p class="project-desc">{project.description}</p>

              <div class="project-tech-stack">
                <span class="stack-label">Technologies / Focus:</span>
                <div class="tags-row">
                  {project.technologies.map((tech) => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                </div>
              </div>

              {project.outcomes && (
                <div class="outcomes-box">
                  <strong>Results / Impact:</strong> {project.outcomes}
                </div>
              )}

              <div class="project-team-row">
                <strong>Team:</strong> {project.team.join(', ')}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-deep-blue) 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: 2.5rem;
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
  }

  .projects-section {
    padding: 4rem 0;
    background-color: var(--color-white);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .project-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .project-img-box {
    position: relative;
    height: 220px;
    overflow: hidden;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .status-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    text-transform: uppercase;
  }

  .status-badge.active {
    background-color: #059669;
    color: #FFFFFF;
  }

  .status-badge.completed {
    background-color: var(--color-navy);
    color: var(--color-cyan);
  }

  .category-pill {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: rgba(31, 62, 101, 0.85);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
  }

  .project-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.85rem;
  }

  .project-title {
    font-size: 1.25rem;
    color: var(--color-navy);
  }

  .project-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .stack-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-navy);
    display: block;
    margin-bottom: 0.4rem;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-tag {
    background-color: var(--color-bg-light);
    color: var(--color-slate);
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .outcomes-box {
    background-color: rgba(5, 135, 189, 0.08);
    border-left: 3px solid var(--color-cyan);
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    color: var(--color-navy);
    border-radius: 0 4px 4px 0;
  }

  .project-team-row {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-light);
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
