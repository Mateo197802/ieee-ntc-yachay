---
import Layout from '@/layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="About Us | IEEE Nanotechnology Council Yachay Tech"
  description="Learn about the history, mission, vision, core goals, and IEEE benefits of the IEEE Nanotechnology Council Student Branch Chapter at Yachay Tech University."
>
  <!-- Inner Page Banner -->
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>About Us</span>
      </div>
      <h1 class="banner-title font-heading">ABOUT US</h1>
      <p class="banner-subtitle">Empowering students in nanoscience, nanotechnology, and interdisciplinary innovation.</p>
    </div>
  </section>

  <!-- About History & Overview Section -->
  <section class="about-content-section">
    <div class="site-container">
      <div class="about-grid">
        <div class="about-text-block">
          <span class="section-eyebrow">IEEE NTC YACHAY TECH</span>
          <h2 class="section-title">ADVANCING NANOSCIENCE AT YACHAY TECH</h2>
          <p>
            The IEEE Nanotechnology Council (NTC) Student Branch Chapter at Yachay Tech University is the pioneer student chapter in Ecuador dedicated to promoting education, interdisciplinary research, and technological development in nanotechnology.
          </p>
          <p>
            Established under IEEE Region 9 guidelines, our chapter serves as a bridge between undergraduate students, researchers, faculty advisors, and international scientific networks. We empower our members through hands-on laboratory workshops, research paper mentorship tracks, virtual reality simulations, and STEM outreach in regional schools.
          </p>
          <p>
            Through strategic regional collaboration and interdisciplinary projects, we foster leadership, academic excellence, and high-impact scientific publications within the Ecuadorian and international scientific ecosystem.
          </p>
        </div>

        <div class="about-image-block">
          <img 
            src={getHref('/assets/gallery/foto_con_bandera.jpg')} 
            alt="IEEE NTC Yachay Tech Chapter Members" 
            width="600" 
            height="450" 
            class="about-hero-img" 
          />
          <div class="img-caption">
            <span>IEEE NTC Yachay Tech Student Branch Chapter Delegation</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission, Vision & Values Section -->
  <section class="mission-vision-section">
    <div class="site-container">
      <div class="cards-3-grid">
        <div class="mv-card">
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <h3>OUR MISSION</h3>
          <p>
            To cultivate a vibrant scientific environment that fosters nanotechnology education, scientific research paper training, community outreach, and technical collaboration among Yachay Tech students.
          </p>
        </div>

        <div class="mv-card">
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3>OUR VISION</h3>
          <p>
            To become a premier Latin American student chapter recognized for research excellence, active participation in flagship IEEE conferences (such as IEEE NTC, LANANO, and TEMSCON), and community social impact.
          </p>
        </div>

        <div class="mv-card">
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h3>CORE GOALS</h3>
          <p>
            • Facilitate green synthesis laboratory training.<br>
            • Provide structured paper mentoring for LANANO.<br>
            • Expand STEM education in local high schools.<br>
            • Support student travel grants and IEEE awards.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits of Joining IEEE Section -->
  <section class="benefits-section">
    <div class="site-container">
      <div class="section-header text-center">
        <span class="section-eyebrow">MEMBERSHIP ADVANTAGES</span>
        <h2 class="section-title">WHY JOIN IEEE & IEEE NTC?</h2>
      </div>

      <div class="benefits-grid">
        <div class="benefit-box">
          <span class="b-number">01</span>
          <h4>IEEE Xplore Access & Research Grants</h4>
          <p>Access cutting-edge IEEE journals, conference papers, and eligibility for IEEE NTC Activity Grants and LANANO Travel Awards.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">02</span>
          <h4>Hands-on Workshops & Laboratory Training</h4>
          <p>Participate in specialized NanoSkills laboratory sessions, UV-Vis characterization, and Virtual Reality molecular simulations.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">03</span>
          <h4>Leadership & Global Networking</h4>
          <p>Connect with distinguished lecturers, industry experts, IEEE Region 9 officers, and assume leadership roles within chapter committees.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">04</span>
          <h4>Certified Participation & Resume Building</h4>
          <p>Receive official IEEE certificates for workshop completions, STEM volunteering, and research authorship.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
  }

  .about-content-section {
    padding: 4.5rem 0;
    background-color: var(--color-white);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .about-text-block p {
    font-size: 1rem;
    color: var(--color-text-dark);
    margin-bottom: 1.25rem;
    line-height: 1.65;
  }

  .about-image-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .about-hero-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    object-position: center 82%;
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-hover);
    border: 2px solid var(--color-cyan);
  }

  .img-caption {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.75rem;
    font-style: italic;
  }

  .mission-vision-section {
    padding: 4.5rem 0;
    background-color: var(--color-bg-light);
  }

  .cards-3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .mv-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2.25rem;
    box-shadow: var(--shadow-subtle);
    border-top: 4px solid var(--color-cyan);
  }

  .mv-icon {
    color: var(--color-cyan);
    margin-bottom: 1rem;
  }

  .mv-card h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
  }

  .mv-card p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .benefits-section {
    padding: 4.5rem 0;
    background-color: var(--color-white);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .benefit-box {
    background-color: var(--color-bg-light);
    border-radius: var(--border-radius-sm);
    padding: 1.75rem;
    border-left: 4px solid var(--color-navy);
  }

  .b-number {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-cyan);
    display: block;
  }

  .benefit-box h4 {
    font-size: 1.1rem;
    color: var(--color-navy);
    margin: 0.4rem 0;
  }

  .benefit-box p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-hero-img {
      height: 360px;
    }
    .cards-3-grid {
      grid-template-columns: 1fr;
    }
    .benefits-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
