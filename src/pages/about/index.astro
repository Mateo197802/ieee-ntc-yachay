---
import Layout from '@/layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="About Us | IEEE Nanotechnology Council Yachay Tech"
  description="Learn about the history, mission, vision, strategic goals, and benefits of the IEEE Nanotechnology Council Student Branch Chapter at Yachay Tech University."
>
  <!-- Inner Page Banner -->
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>About Us</span>
      </div>
      <h1 class="banner-title font-heading">ABOUT US</h1>
      <p class="banner-subtitle">Empowering students in nanoscience, nanotechnology, and interdisciplinary innovation.</p>
    </div>
  </section>

  <!-- About History & Overview Section -->
  <section class="about-content-section">
    <div class="site-container">
      <div class="about-grid">
        <div class="about-text-block">
          <span class="section-eyebrow">IEEE NTC YACHAY TECH</span>
          <h2 class="section-title">ADVANCING NANOSCIENCE AT YACHAY TECH</h2>
          <p>
            The IEEE Nanotechnology Council (NTC) Student Branch Chapter at Yachay Tech University is the pioneer chapter in Ecuador dedicated to fostering education, interdisciplinary research, and technological advancement in nanotechnology.
          </p>
          <p>
            Established under IEEE Region 9 guidelines, our chapter bridges students, researchers, faculty advisors, and international scientific networks. We empower members through hands-on laboratory workshops, scientific paper incubators, Virtual Reality simulations, and STEM outreach in regional schools.
          </p>
          <p>
            Through strategic alignment and rigorous technical projects, we foster leadership, academic excellence, and scientific publications impacting both Ecuador and the international scientific community.
          </p>
        </div>

        <div class="about-image-block">
          <img 
            src={getHref('/assets/gallery/foto_con_bandera.jpg')} 
            alt="IEEE NTC Yachay Tech Chapter Delegation" 
            width="600" 
            height="450" 
            class="about-hero-img" 
          />
          <div class="img-caption">
            <span>Official Delegation of the IEEE NTC Yachay Tech Student Branch Chapter</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission, Vision & Values Section -->
  <section class="mission-vision-section">
    <div class="site-container">
      <div class="cards-3-grid">
        <div class="mv-card">
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <h3>OUR MISSION</h3>
          <p>
            Cultivate a dynamic scientific environment advancing nanotechnology education, research paper publishing, community outreach, and technical collaboration among Yachay Tech students.
          </p>
        </div>

        <div class="mv-card">
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3>OUR VISION</h3>
          <p>
            To establish ourselves as a leading student chapter in Latin America, renowned for research excellence, active participation in international IEEE conferences (IEEE NTC, LANANO, TEMSCON), and social impact.
          </p>
        </div>

        <div class="mv-card">
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h3>STRATEGIC GOALS</h3>
          <p>
            • Experimental training in nanomaterial synthesis.<br>
            • Structured technical mentorship for IEEE LANANO 2026.<br>
            • Expansion of STEM outreach workshops in high schools.<br>
            • Administration of travel grants and IEEE awards.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits of Joining IEEE Section -->
  <section class="benefits-section">
    <div class="site-container">
      <div class="section-header text-center">
        <span class="section-eyebrow">MEMBERSHIP BENEFITS</span>
        <h2 class="section-title">WHY JOIN IEEE AND IEEE NTC?</h2>
      </div>

      <div class="benefits-grid">
        <div class="benefit-box">
          <span class="b-number">01</span>
          <h4>Access to IEEE Xplore & Activity Grants</h4>
          <p>Access to leading scientific journals, international conference proceedings, and eligibility for IEEE NTC Activity Grants and LANANO Travel Awards.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">02</span>
          <h4>Hands-on Workshops & Labs</h4>
          <p>Participation in NanoSkills laboratory sessions, UV-Vis characterization, green nanoparticle synthesis, and Virtual Reality molecular simulations.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">03</span>
          <h4>Leadership & Global Networking</h4>
          <p>Direct connection with Distinguished Lecturers, industry experts, IEEE Region 9 officers, and leadership roles on technical committees.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">04</span>
          <h4>Certification & Career Growth</h4>
          <p>Official IEEE certificates endorsing participation in workshops, STEM volunteering, and co-authorship in scientific publications.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
  }

  .about-content-section {
    padding: 4.5rem 0;
    background-color: var(--color-white);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .about-text-block p {
    font-size: 1rem;
    color: var(--color-text-dark);
    margin-bottom: 1.25rem;
    line-height: 1.65;
  }

  .about-image-block {
    position: relative;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-hover);
    border: 1px solid var(--color-border-light);
  }

  .about-hero-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .img-caption {
    background-color: var(--color-navy);
    color: var(--color-white);
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
    text-align: center;
  }

  .mission-vision-section {
    padding: 4.5rem 0;
    background-color: var(--color-bg-light);
  }

  .cards-3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .mv-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    border-top: 4px solid var(--color-cyan);
    transition: transform 0.2s ease;
  }

  .mv-card:hover {
    transform: translateY(-5px);
  }

  .mv-icon {
    color: var(--color-cyan);
    margin-bottom: 1.25rem;
  }

  .mv-card h3 {
    font-size: 1.2rem;
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  .mv-card p {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .benefits-section {
    padding: 5rem 0;
    background-color: var(--color-white);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .benefit-box {
    background-color: var(--color-bg-light);
    border-radius: var(--border-radius-md);
    padding: 2.25rem;
    border: 1px solid var(--color-border-light);
    position: relative;
  }

  .b-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: rgba(5, 135, 189, 0.2);
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    line-height: 1;
  }

  .benefit-box h4 {
    font-size: 1.15rem;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
    padding-right: 2rem;
  }

  .benefit-box p {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .about-grid,
    .cards-3-grid,
    .benefits-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
