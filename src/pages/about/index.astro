---
import Layout from '@/layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Sobre Nosotros | IEEE Nanotechnology Council Yachay Tech"
  description="Conoce la historia, misión, visión, objetivos estratégicos y beneficios del Capítulo Estudiantil IEEE Nanotechnology Council en Yachay Tech University."
>
  <!-- Inner Page Banner -->
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')} data-i18n-es="Inicio" data-i18n-en="Home">Inicio</a> &gt; <span data-i18n-es="Sobre Nosotros" data-i18n-en="About Us">Sobre Nosotros</span>
      </div>
      <h1 class="banner-title font-heading" data-i18n-es="SOBRE NOSOTROS" data-i18n-en="ABOUT US">SOBRE NOSOTROS</h1>
      <p class="banner-subtitle" data-i18n-es="Impulsando a estudiantes en nanociencia, nanotecnología e innovación interdisciplinaria." data-i18n-en="Empowering students in nanoscience, nanotechnology, and interdisciplinary innovation.">Impulsando a estudiantes en nanociencia, nanotecnología e innovación interdisciplinaria.</p>
    </div>
  </section>

  <!-- About History & Overview Section -->
  <section class="about-content-section">
    <div class="site-container">
      <div class="about-grid">
        <div class="about-text-block">
          <span class="section-eyebrow" data-i18n-es="IEEE NTC YACHAY TECH" data-i18n-en="IEEE NTC YACHAY TECH">IEEE NTC YACHAY TECH</span>
          <h2 class="section-title" data-i18n-es="IMPULSANDO LA NANOCIENCIA EN YACHAY TECH" data-i18n-en="ADVANCING NANOSCIENCE AT YACHAY TECH">IMPULSANDO LA NANOCIENCIA EN YACHAY TECH</h2>
          <p data-i18n-es="El Capítulo Estudiantil del IEEE Nanotechnology Council (NTC) en Yachay Tech University es el capítulo pionero en Ecuador dedicado a fomentar la educación, la investigación interdisciplinaria y el desarrollo tecnológico en nanotecnología." data-i18n-en="The IEEE Nanotechnology Council (NTC) Student Branch Chapter at Yachay Tech University is the pioneer chapter in Ecuador dedicated to fostering education, interdisciplinary research, and technological advancement in nanotechnology.">
            El Capítulo Estudiantil del IEEE Nanotechnology Council (NTC) en Yachay Tech University es el capítulo pionero en Ecuador dedicado a fomentar la educación, la investigación interdisciplinaria y el desarrollo tecnológico en nanotecnología.
          </p>
          <p data-i18n-es="Establecido bajo los lineamientos de IEEE Región 9, nuestro capítulo actúa como un puente entre estudiantes universitarios, investigadores, docentes asesores y redes científicas internacionales. Empoderamos a nuestros miembros mediante talleres prácticos de laboratorio, semilleros de redacción de artículos científicos, simulaciones en Realidad Virtual y vinculación STEM en colegios de la región." data-i18n-en="Established under IEEE Region 9 guidelines, our chapter bridges students, researchers, faculty advisors, and international scientific networks. We empower members through hands-on laboratory workshops, scientific paper incubators, Virtual Reality simulations, and STEM outreach in regional schools.">
            Establecido bajo los lineamientos de IEEE Región 9, nuestro capítulo actúa como un puente entre estudiantes universitarios, investigadores, docentes asesores y redes científicas internacionales. Empoderamos a nuestros miembros mediante talleres prácticos de laboratorio, semilleros de redacción de artículos científicos, simulaciones en Realidad Virtual y vinculación STEM en colegios de la región.
          </p>
          <p data-i18n-es="A través de una articulación estratégica y proyectos de alto rigor técnico, promovemos el liderazgo, la excelencia académica y publicaciones científicas con impacto en el ecosistema ecuatoriano e internacional." data-i18n-en="Through strategic alignment and rigorous technical projects, we foster leadership, academic excellence, and scientific publications impacting both Ecuador and the international scientific community.">
            A través de una articulación estratégica y proyectos de alto rigor técnico, promovemos el liderazgo, la excelencia académica y publicaciones científicas con impacto en el ecosistema ecuatoriano e internacional.
          </p>
        </div>

        <div class="about-image-block">
          <img 
            src={getHref('/assets/gallery/foto_con_bandera.jpg')} 
            alt="Delegación del Capítulo IEEE NTC Yachay Tech" 
            width="600" 
            height="450" 
            class="about-hero-img" 
          />
          <div class="img-caption">
            <span data-i18n-es="Delegación Oficial del Capítulo Estudiantil IEEE NTC Yachay Tech" data-i18n-en="Official Delegation of the IEEE NTC Yachay Tech Student Branch Chapter">Delegación Oficial del Capítulo Estudiantil IEEE NTC Yachay Tech</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission, Vision & Values Section -->
  <section class="mission-vision-section">
    <div class="site-container">
      <div class="cards-3-grid">
        <div class="mv-card">
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <h3 data-i18n-es="NUESTRA MISIÓN" data-i18n-en="OUR MISSION">NUESTRA MISIÓN</h3>
          <p data-i18n-es="Cultivar un entorno científico dinámico que impulse la formación en nanotecnología, la redacción de artículos de investigación, la vinculación social y la colaboración técnica entre los estudiantes de Yachay Tech." data-i18n-en="Cultivate a dynamic scientific environment advancing nanotechnology education, research paper publishing, community outreach, and technical collaboration among Yachay Tech students.">
            Cultivar un entorno científico dinámico que impulse la formación en nanotecnología, la redacción de artículos de investigación, la vinculación social y la colaboración técnica entre los estudiantes de Yachay Tech.
          </p>
        </div>

        <div class="mv-card">
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3 data-i18n-es="NUESTRA VISIÓN" data-i18n-en="OUR VISION">NUESTRA VISIÓN</h3>
          <p data-i18n-es="Consolidarnos como un capítulo estudiantil referente en América Latina, reconocido por su excelencia investigativa, participación activa en conferencias internacionales IEEE (como IEEE NTC, LANANO y TEMSCON) y su impacto social." data-i18n-en="To establish ourselves as a leading student chapter in Latin America, renowned for research excellence, active participation in international IEEE conferences (IEEE NTC, LANANO, TEMSCON), and social impact.">
            Consolidarnos como un capítulo estudiantil referente en América Latina, reconocido por su excelencia investigativa, participación activa en conferencias internacionales IEEE (como IEEE NTC, LANANO y TEMSCON) y su impacto social.
          </p>
        </div>

        <div class="mv-card">
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h3 data-i18n-es="OBJETIVOS ESTRATÉGICOS" data-i18n-en="STRATEGIC GOALS">OBJETIVOS ESTRATÉGICOS</h3>
          <p data-i18n-html-es="• Capacitación experimental en síntesis de nanomateriales.<br>• Mentoría técnica estructurada para IEEE LANANO 2026.<br>• Expansión de talleres de divulgación STEM en colegios.<br>• Gestión de becas de viaje y reconocimientos IEEE." data-i18n-html-en="• Experimental training in nanomaterial synthesis.<br>• Structured technical mentorship for IEEE LANANO 2026.<br>• Expansion of STEM outreach workshops in high schools.<br>• Administration of travel grants and IEEE awards.">
            • Capacitación experimental en síntesis de nanomateriales.<br>
            • Mentoría técnica estructurada para IEEE LANANO 2026.<br>
            • Expansión de talleres de divulgación STEM en colegios.<br>
            • Gestión de becas de viaje y reconocimientos IEEE.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits of Joining IEEE Section -->
  <section class="benefits-section">
    <div class="site-container">
      <div class="section-header text-center">
        <span class="section-eyebrow" data-i18n-es="VENTAJAS DE LA MEMBRESÍA" data-i18n-en="MEMBERSHIP BENEFITS">VENTAJAS DE LA MEMBRESÍA</span>
        <h2 class="section-title" data-i18n-es="¿POR QUÉ UNIRSE A IEEE Y AL IEEE NTC?" data-i18n-en="WHY JOIN IEEE AND IEEE NTC?">¿POR QUÉ UNIRSE A IEEE Y AL IEEE NTC?</h2>
      </div>

      <div class="benefits-grid">
        <div class="benefit-box">
          <span class="b-number">01</span>
          <h4 data-i18n-es="Acceso a IEEE Xplore y Fondos Concursables" data-i18n-en="Access to IEEE Xplore & Activity Grants">Acceso a IEEE Xplore y Fondos Concursables</h4>
          <p data-i18n-es="Acceso a revistas científicas de frontera, actas de conferencias internacionales y elegibilidad para fondos de financiamiento IEEE NTC Activity Grants y LANANO Travel Awards." data-i18n-en="Access to leading scientific journals, international conference proceedings, and eligibility for IEEE NTC Activity Grants and LANANO Travel Awards.">Acceso a revistas científicas de frontera, actas de conferencias internacionales y elegibilidad para fondos de financiamiento IEEE NTC Activity Grants y LANANO Travel Awards.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">02</span>
          <h4 data-i18n-es="Talleres Prácticos y Laboratorios" data-i18n-en="Hands-on Workshops & Labs">Talleres Prácticos y Laboratorios</h4>
          <p data-i18n-es="Participación en sesiones de laboratorio NanoSkills, caracterización UV-Vis, síntesis verde y simulaciones moleculares en Realidad Virtual." data-i18n-en="Participation in NanoSkills laboratory sessions, UV-Vis characterization, green nanoparticle synthesis, and Virtual Reality molecular simulations.">Participación en sesiones de laboratorio NanoSkills, caracterización UV-Vis, síntesis verde y simulaciones moleculares en Realidad Virtual.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">03</span>
          <h4 data-i18n-es="Liderazgo y Red de Contactos Global" data-i18n-en="Leadership & Global Networking">Liderazgo y Red de Contactos Global</h4>
          <p data-i18n-es="Conexión directa con conferencistas distinguidos, expertos de la industria, directivos de IEEE Región 9 y roles de liderazgo en comités técnicos." data-i18n-en="Direct connection with Distinguished Lecturers, industry experts, IEEE Region 9 officers, and leadership roles on technical committees.">Conexión directa con conferencistas distinguidos, expertos de la industria, directivos de IEEE Región 9 y roles de liderazgo en comités técnicos.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">04</span>
          <h4 data-i18n-es="Certificación y Fortalecimiento Profesional" data-i18n-en="Certification & Career Growth">Certificación y Fortalecimiento Profesional</h4>
          <p data-i18n-es="Certificados oficiales de IEEE que avalan la participación en talleres, voluntariado STEM y coautoría en publicaciones científicas." data-i18n-en="Official IEEE certificates endorsing participation in workshops, STEM volunteering, and co-authorship in scientific publications.">Certificados oficiales de IEEE que avalan la participación en talleres, voluntariado STEM y coautoría en publicaciones científicas.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
  }

  .about-content-section {
    padding: 4.5rem 0;
    background-color: var(--color-white);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .about-text-block p {
    font-size: 1rem;
    color: var(--color-text-dark);
    margin-bottom: 1.25rem;
    line-height: 1.65;
  }

  .about-image-block {
    position: relative;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-hover);
    border: 1px solid var(--color-border-light);
  }

  .about-hero-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .img-caption {
    background-color: var(--color-navy);
    color: var(--color-white);
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
    text-align: center;
  }

  .mission-vision-section {
    padding: 4.5rem 0;
    background-color: var(--color-bg-light);
  }

  .cards-3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .mv-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    border-top: 4px solid var(--color-cyan);
    transition: transform 0.2s ease;
  }

  .mv-card:hover {
    transform: translateY(-5px);
  }

  .mv-icon {
    color: var(--color-cyan);
    margin-bottom: 1.25rem;
  }

  .mv-card h3 {
    font-size: 1.2rem;
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  .mv-card p {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .benefits-section {
    padding: 5rem 0;
    background-color: var(--color-white);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .benefit-box {
    background-color: var(--color-bg-light);
    border-radius: var(--border-radius-md);
    padding: 2.25rem;
    border: 1px solid var(--color-border-light);
    position: relative;
  }

  .b-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: rgba(5, 135, 189, 0.2);
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    line-height: 1;
  }

  .benefit-box h4 {
    font-size: 1.15rem;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
    padding-right: 2rem;
  }

  .benefit-box p {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .about-grid,
    .cards-3-grid,
    .benefits-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
