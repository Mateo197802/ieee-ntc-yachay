---
import Layout from '@/layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

const YACHAY_CAMPUS_ALBUMS = [
  {
    id: 'yachay-science-hub',
    deckNumber: 1,
    title: 'Modern Science & Research Complex',
    subtitle: 'Nanotechnology Cleanrooms & Student Residences',
    coverImage: '/assets/about/yachay_modern_research_complex.png',
    totalPhotos: 2,
    badge: 'RESEARCH & INNOVATION',
    summary: 'Yachay Tech University houses Ecuador’s premier undergraduate and graduate nanotechnology facilities, advanced microscopy equipment, high-vacuum sputtering systems, and modern student residential complexes in Urcuquí.',
    topics: ['Nanotechnology Labs', 'Student Residences', 'Cleanrooms & PVD', 'Ecuador Ama la Vida'],
    slides: [
      {
        image: '/assets/about/yachay_modern_research_complex.png',
        title: 'Central Academic & Research Complex',
        desc: 'Home to the School of Physical Sciences & Nanotechnology and the School of Biological Sciences & Engineering, featuring state-of-the-art research laboratories, computational hubs, and collaborative classrooms.'
      },
      {
        image: '/assets/about/yachay_student_residences.jpg',
        title: 'Student Residence Campus & Iconic Monument',
        desc: 'Modern on-campus residential community housing over 1,500 students from all 24 provinces of Ecuador, centered around the iconic Ecuador Ama la Vida mosaic monument.'
      }
    ]
  },
  {
    id: 'yachay-heritage-nature',
    deckNumber: 2,
    title: 'Heritage Campus & Andean Landscape',
    subtitle: 'Historic San José Estate & High-Altitude Ecosystem',
    coverImage: '/assets/about/yachay_campus_walkway.jpg',
    totalPhotos: 2,
    badge: 'HERITAGE & CAMPUS LIFE',
    summary: 'Situated at 2,000 meters above sea level amidst the Imbabura mountains, the campus harmoniously merges restored 19th-century colonial hacienda architecture with pedestrian walkways and vibrant student life.',
    topics: ['Historic San José', 'Pedestrian Walkways', 'Andean Mountain Views', 'Academic Ceremonies'],
    slides: [
      {
        image: '/assets/about/yachay_campus_walkway.jpg',
        title: 'Pedestrian Walkways & Scenic Hillsides',
        desc: 'Sustainable pedestrian infrastructure connecting residential areas with faculty buildings across the scenic rolling landscape of the Urcuquí valley.'
      },
      {
        image: '/assets/about/yachay_historic_auditorium.png',
        title: 'San José Historic Campus & Central Auditorium',
        desc: 'Restored colonial heritage buildings serving as the ceremonial and cultural epicenter of Yachay Tech for international congresses, IEEE assemblies, and scientific summits.',
        position: 'center 88%'
      }
    ]
  }
];
---

<Layout 
  title="About Us | IEEE Nanotechnology Council Yachay Tech"
  description="Learn about the history, mission, vision, 2026 milestones, and strategic goals of the IEEE Nanotechnology Council Student Branch Chapter at Yachay Tech University."
>
  <!-- Inner Page Banner -->
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>About Us</span>
      </div>
      <span class="banner-eyebrow">PIONEERING NANOSCIENCE IN ECUADOR</span>
      <h1 class="banner-title font-heading">ABOUT OUR CHAPTER</h1>
      <p class="banner-subtitle">
        Founded on February 25, 2026, as the first IEEE Nanotechnology Council Student Branch Chapter in Ecuador and the fourth across Latin America.
      </p>
    </div>
  </section>

  <!-- About History & Institutional Narrative -->
  <section class="about-content-section">
    <div class="site-container">
      <div class="about-grid">
        <div class="about-text-block">
          <span class="section-eyebrow">OUR ORIGIN & PURPOSE</span>
          <h2 class="section-title">ADVANCING NANOTECHNOLOGY BEYOND THE LABORATORY</h2>
          
          <p>
            The <strong>IEEE Nanotechnology Council Student Chapter – Yachay Tech University</strong> was founded on <strong>February 25, 2026</strong>, establishing itself as the pioneer IEEE NTC chapter in Ecuador and the 4th in Latin America.
          </p>
          
          <p>
            We emerged at Yachay Tech University—the only academic institution in Ecuador offering an undergraduate degree in Nanotechnology—with the express purpose of connecting the cutting-edge scientific knowledge developed on our campus with national and international research networks.
          </p>

          <p>
            In our initial months of operation, we have built a thriving interdisciplinary community of <strong>44 individuals</strong> comprising 6 executive officers, 6 members, and 32 active volunteers. Together, we have launched three ongoing research initiatives, a cleanroom NanoSkills Workshop series, an international NanoTalk keynote, and international conference pipelines.
          </p>

          <p>
            Our flagship innovation initiative takes nanotechnology directly into communities: we developed an immersive laboratory environment using <strong>Meta Quest 3 Virtual Reality headsets</strong>, a transformative tool that has already allowed our team to visit regional high schools and pediatric hospital wards to provide hands-on scientific experiences to audiences without direct cleanroom access.
          </p>

          <div class="highlight-quote-box">
            <p>
              <em>"We firmly believe that nanotechnology must not remain confined within cleanroom walls. It must connect with people, spark curiosity, generate real opportunities, and transform communities."</em>
            </p>
          </div>
        </div>

        <div class="about-image-block">
          <img 
            src={getHref('/assets/gallery/foto_con_bandera.jpg')} 
            alt="IEEE NTC Yachay Tech Chapter Delegation" 
            width="600" 
            height="450" 
            class="about-hero-img" 
          />
          <div class="img-caption">
            <span>Official Delegation of the IEEE NTC Yachay Tech Student Branch Chapter</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Yachay Tech Campus Showcase Section: 2 3D Stacked Deck Interactive Carousels -->
  <section class="yachay-campus-section" id="campus-environment">
    <div class="site-container">
      <div class="section-header text-center">
        <span class="section-eyebrow">OUR UNIVERSITY & CAMPUS ENVIRONMENT</span>
        <h2 class="section-title font-heading">YACHAY TECH UNIVERSITY: CRADLE OF NANOSCIENCE</h2>
        <p class="section-subtitle">
          Located in the knowledge city of Urcuquí, Yachay Tech is Ecuador's leading research university, housing the nation's only Nanotechnology engineering degree, cutting-edge cleanrooms, and an inspiring Andean campus ecosystem.
        </p>
      </div>

      <div class="yachay-decks-grid">
        {YACHAY_CAMPUS_ALBUMS.map((album) => (
          <div class="yachay-deck-container">
            <button 
              type="button"
              class="yachay-stacked-trigger open-yachay-album-btn" 
              data-album={JSON.stringify(album)}
              aria-label={`Open campus gallery for ${album.title}`}
            >
              <!-- 3D Stacked Deck Visual Layers -->
              <div class="stacked-deck">
                <div class="deck-layer deck-layer-3" aria-hidden="true"></div>
                <div class="deck-layer deck-layer-2" aria-hidden="true"></div>
                <div class="deck-layer deck-layer-1">
                  <img 
                    src={getHref(album.coverImage)} 
                    alt={album.title} 
                    width="440" 
                    height="320" 
                    loading="lazy" 
                    class="deck-cover-img" 
                  />
                  <div class="cover-glow-overlay"></div>
                  <span class="deck-badge">{album.badge}</span>
                  <span class="photos-count-badge">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                    {album.totalPhotos} Photos
                  </span>
                  <div class="expand-prompt">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                    <span>CLICK TO EXPLORE CAMPUS</span>
                  </div>
                </div>
              </div>

              <!-- Campus Content Info Box -->
              <div class="yachay-deck-info">
                <h3 class="yachay-deck-title">{album.title}</h3>
                <span class="yachay-deck-subtitle">{album.subtitle}</span>
                <p class="yachay-deck-summary">{album.summary}</p>
                
                <div class="yachay-deck-topics">
                  {album.topics.map((t) => (
                    <span class="deck-topic-tag">{t}</span>
                  ))}
                </div>

                <div class="deck-action-bar">
                  <span class="deck-btn-label">OPEN CAMPUS GALLERY ({album.totalPhotos} PHOTOS) &rarr;</span>
                </div>
              </div>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mission, Vision & Strategic Values with Animated Dynamic Cards -->
  <section class="mission-vision-section">
    <div class="site-container">
      <div class="cards-3-grid">
        <!-- Card 1: Our Mission -->
        <div class="mv-card animated-pillar-card">
          <div class="card-accent-ribbon"></div>
          <div class="mv-icon-wrapper">
            <div class="icon-ambient-ring"></div>
            <div class="mv-icon">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" class="svg-ring-outer"/>
                <circle cx="12" cy="12" r="6" class="svg-ring-mid"/>
                <circle cx="12" cy="12" r="2" class="svg-ring-center" fill="currentColor"/>
              </svg>
            </div>
          </div>
          <h3>OUR MISSION</h3>
          <p>
            To drive innovation, science, and technology at the nanoscale through training, research, collaboration, and outreach, connecting students and young researchers with experts, scientific communities, and national and international opportunities.
          </p>
        </div>

        <!-- Card 2: Our Vision -->
        <div class="mv-card animated-pillar-card">
          <div class="card-accent-ribbon"></div>
          <div class="mv-icon-wrapper">
            <div class="icon-ambient-ring"></div>
            <div class="mv-icon">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" class="svg-eye-outer"/>
                <circle cx="12" cy="12" r="3.5" class="svg-eye-iris" fill="rgba(5, 135, 189, 0.25)"/>
                <circle cx="12" cy="12" r="1.5" class="svg-eye-pupil" fill="currentColor"/>
              </svg>
            </div>
          </div>
          <h3>OUR VISION</h3>
          <p>
            To be a leading benchmark for nanotechnology across Ecuador and Latin America, renowned for connecting talent, research, and innovation with international opportunities, strengthening the nano community, and bringing science to everyone.
          </p>
        </div>

        <!-- Card 3: Strategic Goals -->
        <div class="mv-card animated-pillar-card">
          <div class="card-accent-ribbon"></div>
          <div class="mv-icon-wrapper">
            <div class="icon-ambient-ring"></div>
            <div class="mv-icon">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2L2 7l10 5 10-5-10-5z" class="svg-layer-top" fill="rgba(5, 135, 189, 0.2)"/>
                <path d="M2 17l10 5 10-5" class="svg-layer-bottom"/>
                <path d="M2 12l10 5 10-5" class="svg-layer-mid"/>
              </svg>
            </div>
          </div>
          <h3>STRATEGIC GOALS</h3>
          <p>
            • Hands-on cleanroom training in thin-film sputtering.<br>
            • Structured technical mentorship for IEEE LANANO 2026.<br>
            • Expansion of VR STEM outreach in regional schools.<br>
            • Management of IEEE activity grants and DL lectures.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits of Joining IEEE Section -->
  <section class="benefits-section">
    <div class="site-container">
      <div class="section-header text-center">
        <span class="section-eyebrow">MEMBERSHIP ADVANTAGES</span>
        <h2 class="section-title">WHY JOIN IEEE & IEEE NTC?</h2>
      </div>

      <div class="benefits-grid">
        <div class="benefit-box">
          <span class="b-number">01</span>
          <h4>Access to IEEE Xplore & Activity Grants</h4>
          <p>Full access to leading scientific journals, conference proceedings, and chapter eligibility for IEEE NTC Activity Grants and LANANO Travel Sponsorships.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">02</span>
          <h4>Hands-on Workshops & Cleanrooms</h4>
          <p>Direct laboratory access for NanoSkills practical sessions, magnetron sputtering, thin-film characterization, and molecular VR simulations.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">03</span>
          <h4>Global Leadership & Networking</h4>
          <p>Direct contact with IEEE Distinguished Lecturers, international research mentors, Region 9 leaders, and technical committee positions.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">04</span>
          <h4>Career Endorsements & Certificates</h4>
          <p>Official IEEE certificates verifying workshop mastery, STEM volunteering hours, conference presentations, and co-authorship in indexed journals.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Web Platform Architecture & Lead Developer Mini-Section -->
  <section class="webmaster-credit-section" id="web-developer">
    <div class="site-container">
      <div class="webmaster-credit-card">
        <div class="webmaster-info-side">
          <span class="section-eyebrow">DIGITAL ARCHITECTURE & PLATFORM LEAD</span>
          <h2 class="webmaster-title font-heading">WEBSITE DESIGN & DEVELOPMENT</h2>
          <p class="webmaster-lead-text">
            This official web platform was designed and developed by <strong>Mateo Gavilanes</strong> (Vice Chair & Lead Developer, Biomedical Engineering student at Yachay Tech University).
          </p>
          <p class="webmaster-sub-text">
            Engineered with a high-performance modern static architecture, accessible responsive aesthetics, native light/dark theme synchronization, and interactive multi-media viewers to connect nanoscience with global academic communities.
          </p>
          
          <div class="webmaster-tags-row">
            <span class="credit-tag">Lead Web Architect</span>
            <span class="credit-tag">Biomedical Engineering</span>
            <span class="credit-tag">Vice Chair</span>
            <span class="credit-tag">Open Source Contributor</span>
          </div>

          <div class="webmaster-cta-row">
            <a 
              href="https://www.linkedin.com/in/isaac-mateo-g-55aa7a318/?locale=es" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-primary credit-btn"
            >
              <span>VIEW LINKEDIN PROFILE</span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25c-.97 0-1.75.79-1.75 1.76s.78 1.76 1.75 1.76 1.75-.79 1.75-1.76-.78-1.76-1.75-1.76z"/></svg>
            </a>

            <a 
              href="https://github.com/Mateo197802" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-outline-dark credit-btn"
            >
              <span>VIEW GITHUB PROFILE</span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
            </a>

            <a 
              href={getHref('/directive/#mateo-gavilanes')} 
              class="btn btn-outline-dark credit-btn"
            >
              <span>EXECUTIVE BIO</span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 4a4 4 0 0 1 4 4 4 4 0 0 1-4 4 4 4 0 0 1-4-4 4 4 0 0 1 4-4m0 10c4.42 0 8 1.79 8 4v2H4v-2c0-2.21 3.58-4 8-4z"/></svg>
            </a>
          </div>
        </div>

        <div class="webmaster-avatar-side">
          <div class="avatar-card-inner">
            <img 
              src={getHref('/assets/directive/mateo_gavilanes.jpg')} 
              alt="Mateo Gavilanes — Web Platform Developer & Vice Chair" 
              width="240" 
              height="240" 
              class="webmaster-portrait" 
            />
            <div class="avatar-meta">
              <strong class="avatar-name">Mateo Gavilanes</strong>
              <span class="avatar-role">Vice Chair & Web Architect</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Yachay Campus Gallery Modal Dialog -->
  <dialog id="yachay-gallery-modal" class="yachay-gallery-dialog">
    <div class="yachay-gallery-inner">
      <button class="yachay-gallery-close" id="yachay-gallery-close-btn" aria-label="Close gallery">&times;</button>
      
      <div class="yachay-gallery-header">
        <div class="modal-header-meta">
          <span class="modal-badge-badge" id="modal-yachay-badge">RESEARCH & INNOVATION</span>
          <span class="modal-counter-badge" id="modal-yachay-counter">Photo 1 of 2</span>
        </div>
        <h2 class="yachay-gallery-title font-heading" id="modal-yachay-title">Modern Science & Research Complex</h2>
        <p class="yachay-gallery-subtitle" id="modal-yachay-subtitle">Campus facilities and academic infrastructure</p>
      </div>

      <!-- Main Viewer Stage -->
      <div class="yachay-viewer-stage">
        <button class="viewer-nav-btn prev-btn" id="modal-yachay-prev-btn" aria-label="Previous photo">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        </button>

        <div class="yachay-slide-box">
          <img id="modal-yachay-img" src="" alt="Yachay Tech Campus View" class="yachay-current-img" />
          <div class="yachay-caption-bar">
            <h4 class="slide-title font-heading" id="modal-yachay-slide-title">Photo title</h4>
            <p class="slide-desc" id="modal-yachay-slide-desc">Photo description</p>
          </div>
        </div>

        <button class="viewer-nav-btn next-btn" id="modal-yachay-next-btn" aria-label="Next photo">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
      </div>

      <!-- Thumbnail Selector Strip -->
      <div class="yachay-thumb-strip" id="modal-yachay-thumbs">
        <!-- Thumbnails populated dynamically -->
      </div>

      <div class="gallery-footer-hint">
        <span>Use lateral arrows or keyboard &larr; / &rarr; to navigate photos</span>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3.5rem 0 4rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--color-cyan);
    margin-bottom: 0.5rem;
  }

  .banner-title {
    font-size: clamp(2.2rem, 3.8vw, 3rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.88);
    margin-top: 0.5rem;
    max-width: 800px;
    line-height: 1.6;
  }

  .about-content-section {
    padding: 5rem 0;
    background-color: var(--color-white);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  .about-text-block p {
    font-size: 0.98rem;
    color: var(--color-text-dark);
    margin-bottom: 1.25rem;
    line-height: 1.68;
  }

  .highlight-quote-box {
    background-color: var(--color-bg-light);
    border-left: 4px solid var(--color-cyan);
    padding: 1.25rem 1.5rem;
    border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0;
    margin-top: 1.5rem;
  }

  .highlight-quote-box p {
    margin: 0;
    color: var(--color-navy);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .about-image-block {
    position: relative;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-hover);
    border: 1px solid var(--color-border-light);
  }

  .about-hero-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .img-caption {
    background-color: var(--color-navy);
    color: var(--color-white);
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
    text-align: center;
  }

  /* Mission, Vision & Animated Cards */
  .mission-vision-section {
    padding: 5rem 0;
    background-color: var(--color-bg-light);
  }

  .cards-3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .mv-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2.75rem 2.25rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease;
  }

  /* Top Animated Accent Ribbon */
  .card-accent-ribbon {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--color-navy) 0%, var(--color-cyan) 50%, #34B0E8 100%);
    background-size: 200% 100%;
    transition: height 0.3s ease, background-position 0.6s ease;
  }

  .mv-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 35px -10px rgba(5, 135, 189, 0.2), 0 10px 20px -5px rgba(31, 62, 101, 0.12);
    border-color: rgba(5, 135, 189, 0.4);
  }

  .mv-card:hover .card-accent-ribbon {
    height: 5px;
    background-position: 100% 0;
  }

  /* Animated Icon Container & Glow Effects */
  .mv-icon-wrapper {
    position: relative;
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .icon-ambient-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(5, 135, 189, 0.18) 0%, rgba(4, 96, 142, 0.05) 70%, transparent 100%);
    border: 1px dashed rgba(5, 135, 189, 0.35);
    animation: rotateAmbientRing 12s linear infinite;
    transition: transform 0.4s ease, border-color 0.4s ease, background 0.4s ease;
  }

  .mv-card:hover .icon-ambient-ring {
    border-color: var(--color-cyan);
    border-style: solid;
    background: radial-gradient(circle, rgba(5, 135, 189, 0.3) 0%, rgba(5, 135, 189, 0.1) 70%, transparent 100%);
    transform: scale(1.18);
    box-shadow: 0 0 16px rgba(5, 135, 189, 0.4);
  }

  .mv-icon {
    position: relative;
    z-index: 2;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: rgba(5, 135, 189, 0.1);
    color: var(--color-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
    animation: subtleIconFloat 3.5s ease-in-out infinite;
  }

  .mv-card:nth-child(2) .mv-icon {
    animation-delay: 0.6s;
  }

  .mv-card:nth-child(3) .mv-icon {
    animation-delay: 1.2s;
  }

  .mv-card:hover .mv-icon {
    transform: scale(1.14) rotate(8deg);
    background-color: var(--color-cyan);
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(5, 135, 189, 0.45);
  }

  .mv-icon svg {
    display: block;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .mv-card:hover .mv-icon svg {
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.8));
  }

  /* Specific SVG Micro-animations */
  .svg-ring-center,
  .svg-eye-pupil {
    transition: transform 0.3s ease;
    transform-origin: center;
  }

  .mv-card:hover .svg-ring-center {
    animation: targetPulse 1.2s ease-in-out infinite;
  }

  .mv-card:hover .svg-eye-pupil {
    animation: eyeGlance 1.5s ease-in-out infinite;
  }

  .mv-card:hover .svg-layer-top {
    animation: layerFloat 1.2s ease-in-out infinite alternate;
  }

  @keyframes targetPulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.5);
    }
  }

  @keyframes eyeGlance {
    0%, 100% {
      transform: translateX(0);
    }
    30% {
      transform: translateX(1.5px);
    }
    70% {
      transform: translateX(-1.5px);
    }
  }

  @keyframes layerFloat {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-2px);
    }
  }

  @keyframes rotateAmbientRing {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes subtleIconFloat {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  .mv-card h3 {
    font-size: 1.25rem;
    color: var(--color-navy);
    margin-bottom: 1rem;
    letter-spacing: 0.3px;
    transition: color 0.2s ease;
  }

  .mv-card:hover h3 {
    color: var(--color-institutional-blue);
  }

  .mv-card p {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.62;
    margin: 0;
  }

  /* Benefits */
  .benefits-section {
    padding: 5.5rem 0;
    background-color: var(--color-white);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .benefit-box {
    background-color: var(--color-bg-light);
    border-radius: var(--border-radius-md);
    padding: 2.25rem;
    border: 1px solid var(--color-border-light);
    position: relative;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .benefit-box:hover {
    transform: translateY(-4px);
    border-color: var(--color-cyan);
    box-shadow: var(--shadow-hover);
  }

  .b-number {
    font-family: var(--font-heading);
    font-size: 2.75rem;
    color: rgba(5, 135, 189, 0.2);
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    line-height: 1;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .benefit-box:hover .b-number {
    color: rgba(5, 135, 189, 0.45);
    transform: scale(1.08);
  }

  .benefit-box h4 {
    font-size: 1.15rem;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
    padding-right: 2rem;
  }

  .benefit-box p {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Webmaster Credit Mini-Section */
  .webmaster-credit-section {
    padding: 4.5rem 0 5rem;
    background-color: var(--color-white);
    border-top: 1px solid var(--color-border-light);
  }

  .webmaster-credit-card {
    background: linear-gradient(135deg, rgba(7, 28, 52, 0.03) 0%, rgba(5, 135, 189, 0.06) 100%);
    border: 1px solid var(--color-border-light);
    border-left: 5px solid var(--color-cyan);
    border-radius: var(--border-radius-md);
    padding: 2.5rem 3rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
    box-shadow: var(--shadow-subtle);
  }

  .webmaster-title {
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    color: var(--color-navy);
    margin: 0.25rem 0 1rem;
    line-height: 1.2;
  }

  .webmaster-lead-text {
    font-size: 1.05rem;
    color: var(--color-text-dark);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .webmaster-lead-text strong {
    color: var(--color-navy);
  }

  .webmaster-sub-text {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .webmaster-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .credit-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 0.25rem 0.7rem;
    border-radius: 4px;
    background-color: var(--color-white);
    color: var(--color-navy);
    border: 1px solid var(--color-border-light);
  }

  .webmaster-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .credit-btn {
    font-size: 0.8rem;
    padding: 0.65rem 1.15rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .webmaster-avatar-side {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .avatar-card-inner {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 0.85rem;
    box-shadow: var(--shadow-hover);
    border: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 220px;
  }

  .webmaster-portrait {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: var(--border-radius-sm);
    margin-bottom: 0.75rem;
    background-color: #0c2340;
  }

  .avatar-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .avatar-name {
    font-size: 0.95rem;
    color: var(--color-navy);
  }

  .avatar-role {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-cyan);
  }

  @media (max-width: 960px) {
    .about-grid,
    .cards-3-grid,
    .benefits-grid {
      grid-template-columns: 1fr;
    }
    .webmaster-credit-card {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
      gap: 2rem;
    }
    .webmaster-avatar-side {
      order: -1;
    }
  }

  /* Yachay Tech Campus Showcase Section */
  .yachay-campus-section {
    padding: 5rem 0 5.5rem;
    background-color: var(--color-bg-light);
    border-top: 1px solid var(--color-border-light);
    border-bottom: 1px solid var(--color-border-light);
  }

  .yachay-decks-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
  }

  .yachay-deck-container {
    perspective: 1000px;
  }

  .yachay-stacked-trigger {
    background: var(--color-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-md);
    padding: 1.85rem;
    display: flex;
    flex-direction: column;
    width: 100%;
    text-align: left;
    cursor: pointer;
    box-shadow: var(--shadow-subtle);
    transition: all var(--transition-normal);
  }

  .yachay-stacked-trigger:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-cyan);
  }

  /* 3D Stacked Visual Layers */
  .stacked-deck {
    position: relative;
    width: 100%;
    height: 320px;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .deck-layer {
    position: absolute;
    width: 90%;
    height: 94%;
    border-radius: var(--border-radius-sm);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    transition: all var(--transition-normal);
  }

  .deck-layer-3 {
    background-color: #0c2340;
    transform: rotate(-4.5deg) translateY(10px);
    opacity: 0.6;
    z-index: 1;
  }

  .deck-layer-2 {
    background-color: #1f3e65;
    transform: rotate(3deg) translateY(5px);
    opacity: 0.85;
    z-index: 2;
  }

  .deck-layer-1 {
    background-color: #ffffff;
    transform: rotate(0deg);
    z-index: 3;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .yachay-stacked-trigger:hover .deck-layer-3 {
    transform: rotate(-8deg) translateY(15px) translateX(-6px);
  }

  .yachay-stacked-trigger:hover .deck-layer-2 {
    transform: rotate(5deg) translateY(8px) translateX(5px);
  }

  .yachay-stacked-trigger:hover .deck-layer-1 {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.25);
  }

  .deck-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-normal);
  }

  .cover-glow-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(7, 28, 52, 0.75) 100%);
    pointer-events: none;
  }

  .deck-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: var(--color-cyan);
    color: var(--color-white);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 0.3rem 0.65rem;
    border-radius: 4px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  }

  .photos-count-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: rgba(7, 28, 52, 0.85);
    color: var(--color-white);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.3rem 0.65rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    backdrop-filter: blur(4px);
  }

  .expand-prompt {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-navy);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 0.4rem 0.95rem;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    border: 1px solid var(--color-cyan);
    transition: all var(--transition-fast);
  }

  .yachay-stacked-trigger:hover .expand-prompt {
    background-color: var(--color-cyan);
    transform: translateX(-50%) scale(1.05);
  }

  /* Info Box */
  .yachay-deck-info {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .yachay-deck-title {
    font-size: 1.3rem;
    color: var(--color-navy);
    margin-bottom: 0.3rem;
    line-height: 1.3;
  }

  .yachay-deck-subtitle {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
    display: block;
  }

  .yachay-deck-summary {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .yachay-deck-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
  }

  .deck-topic-tag {
    font-size: 0.72rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background-color: var(--color-bg-light);
    color: var(--color-navy);
    border: 1px solid var(--color-border-light);
    font-weight: 600;
  }

  .deck-action-bar {
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border-light);
  }

  .deck-btn-label {
    font-size: 0.84rem;
    font-weight: 800;
    color: var(--color-institutional-blue);
    letter-spacing: 0.5px;
    transition: color var(--transition-fast);
  }

  .yachay-stacked-trigger:hover .deck-btn-label {
    color: var(--color-cyan);
  }

  /* Yachay Lightbox Modal Dialog */
  .yachay-gallery-dialog {
    border: none;
    border-radius: var(--border-radius-md);
    background: transparent;
    padding: 0;
    max-width: 840px;
    width: 95%;
    max-height: 94vh;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
  }

  .yachay-gallery-dialog::backdrop {
    background-color: rgba(7, 28, 52, 0.85);
    backdrop-filter: blur(8px);
  }

  .yachay-gallery-inner {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 1.75rem;
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: 94vh;
    overflow-y: auto;
  }

  .yachay-gallery-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: var(--color-bg-light);
    border: 1px solid var(--color-border-light);
    color: var(--color-navy);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.4rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
    z-index: 10;
  }

  .yachay-gallery-close:hover {
    background-color: var(--color-cyan);
    color: var(--color-white);
  }

  .yachay-gallery-header {
    margin-bottom: 1.25rem;
    padding-right: 2.5rem;
  }

  .modal-header-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .modal-badge-badge {
    background-color: var(--color-cyan);
    color: var(--color-white);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 0.25rem 0.65rem;
    border-radius: 3px;
  }

  .modal-counter-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    background-color: var(--color-bg-light);
    border: 1px solid var(--color-border-light);
    padding: 0.2rem 0.55rem;
    border-radius: 3px;
  }

  .yachay-gallery-title {
    font-size: 1.35rem;
    color: var(--color-navy);
    margin: 0 0 0.25rem;
  }

  .yachay-gallery-subtitle {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Viewer Stage */
  .yachay-viewer-stage {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .yachay-slide-box {
    flex: 1;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    background-color: #071c34;
    box-shadow: var(--shadow-hover);
  }

  .yachay-current-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
    background-color: #071c34;
  }

  .yachay-caption-bar {
    background-color: var(--color-navy);
    color: var(--color-white);
    padding: 1rem 1.25rem;
  }

  .slide-title {
    font-size: 1rem;
    margin: 0 0 0.25rem;
    color: var(--color-white);
  }

  .slide-desc {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    line-height: 1.5;
  }

  .viewer-nav-btn {
    background-color: var(--color-navy);
    color: var(--color-white);
    border: 1px solid var(--color-cyan);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .viewer-nav-btn:hover {
    background-color: var(--color-cyan);
    transform: scale(1.08);
  }

  /* Thumbnails Strip */
  .yachay-thumb-strip {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding: 0.5rem 0.25rem 0.75rem;
    margin-bottom: 0.5rem;
  }

  :global(.yachay-thumb-btn) {
    flex: 0 0 80px;
    height: 60px;
    border-radius: 4px;
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;
    background-color: #071c34;
    transition: all var(--transition-fast);
    opacity: 0.6;
  }

  :global(.yachay-thumb-btn:hover) {
    opacity: 0.9;
    border-color: var(--color-cyan);
  }

  :global(.yachay-thumb-btn.active) {
    opacity: 1;
    border-color: var(--color-cyan);
    box-shadow: 0 0 0 2px var(--color-cyan);
    transform: scale(1.05);
  }

  :global(.yachay-thumb-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-footer-hint {
    text-align: center;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 860px) {
    .yachay-decks-grid {
      grid-template-columns: 1fr;
    }
    .stacked-deck {
      height: 280px;
    }
    .yachay-current-img {
      height: 260px;
    }
  }

  /* Dark Mode Overrides for About Us */
  :global(html[data-theme="dark"]) .about-content-section,
  :global(html[data-theme="dark"]) .benefits-section {
    background-color: #071626;
  }

  :global(html[data-theme="dark"]) .mission-vision-section {
    background-color: #051324;
  }

  :global(html[data-theme="dark"]) .about-text-block p {
    color: #cbd5e1;
  }

  :global(html[data-theme="dark"]) .about-text-block strong {
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .highlight-quote-box {
    background-color: #071c34;
    border-left: 4px solid var(--color-cyan);
  }

  :global(html[data-theme="dark"]) .highlight-quote-box p,
  :global(html[data-theme="dark"]) .highlight-quote-box em {
    color: #e2e8f0;
  }

  :global(html[data-theme="dark"]) .mv-card {
    background-color: #0c2340;
    border-color: rgba(5, 135, 189, 0.25);
  }

  :global(html[data-theme="dark"]) .mv-card h3 {
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .mv-card p {
    color: #cbd5e1;
  }

  :global(html[data-theme="dark"]) .benefit-box {
    background-color: #0c2340;
    border-color: rgba(5, 135, 189, 0.25);
  }

  :global(html[data-theme="dark"]) .benefit-box h3 {
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .benefit-box p {
    color: #cbd5e1;
  }

  :global(html[data-theme="dark"]) .benefit-box .b-number {
    color: rgba(5, 135, 189, 0.35);
  }

  :global(html[data-theme="dark"]) .yachay-campus-section {
    background-color: #051324;
    border-color: rgba(5, 135, 189, 0.2);
  }

  :global(html[data-theme="dark"]) .yachay-stacked-trigger {
    background-color: #071c34;
    border-color: rgba(5, 135, 189, 0.25);
  }

  :global(html[data-theme="dark"]) .yachay-deck-title {
    color: #f1f5f9;
  }

  :global(html[data-theme="dark"]) .deck-topic-tag {
    background-color: #0c2340;
    color: #e2e8f0;
    border-color: rgba(5, 135, 189, 0.3);
  }

  :global(html[data-theme="dark"]) .yachay-gallery-inner {
    background-color: #071c34;
    border: 1px solid rgba(5, 135, 189, 0.3);
  }

  :global(html[data-theme="dark"]) .yachay-gallery-title {
    color: #f1f5f9;
  }

  :global(html[data-theme="dark"]) .modal-counter-badge {
    background-color: #0c2340;
    color: #f1f5f9;
    border-color: rgba(5, 135, 189, 0.3);
  }

  :global(html[data-theme="dark"]) .yachay-gallery-close {
    background-color: #0c2340;
    color: #f1f5f9;
    border-color: rgba(5, 135, 189, 0.3);
  }

  :global(html[data-theme="dark"]) .webmaster-credit-section {
    background-color: #051324;
    border-color: rgba(5, 135, 189, 0.2);
  }

  :global(html[data-theme="dark"]) .webmaster-credit-card {
    background: linear-gradient(135deg, rgba(7, 28, 52, 0.6) 0%, rgba(12, 35, 64, 0.8) 100%);
    border-color: rgba(5, 135, 189, 0.3);
  }

  :global(html[data-theme="dark"]) .webmaster-title,
  :global(html[data-theme="dark"]) .webmaster-lead-text strong,
  :global(html[data-theme="dark"]) .avatar-name {
    color: #f1f5f9;
  }

  :global(html[data-theme="dark"]) .webmaster-lead-text {
    color: #cbd5e1;
  }

  :global(html[data-theme="dark"]) .credit-tag,
  :global(html[data-theme="dark"]) .avatar-card-inner {
    background-color: #071c34;
    border-color: rgba(5, 135, 189, 0.3);
    color: #e2e8f0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('yachay-gallery-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('yachay-gallery-close-btn');
    const prevBtn = document.getElementById('modal-yachay-prev-btn');
    const nextBtn = document.getElementById('modal-yachay-next-btn');

    const badgeEl = document.getElementById('modal-yachay-badge');
    const counterEl = document.getElementById('modal-yachay-counter');
    const titleEl = document.getElementById('modal-yachay-title');
    const subtitleEl = document.getElementById('modal-yachay-subtitle');
    const imgEl = document.getElementById('modal-yachay-img') as HTMLImageElement | null;
    const slideTitleEl = document.getElementById('modal-yachay-slide-title');
    const slideDescEl = document.getElementById('modal-yachay-slide-desc');
    const thumbsContainer = document.getElementById('modal-yachay-thumbs');

    const triggerBtns = document.querySelectorAll('.open-yachay-album-btn');

    let currentAlbum: any = null;
    let currentSlideIndex = 0;

    const basePrefix = (window as any).__ASTRO_BASE_URL__ || document.querySelector('meta[name="base-url"]')?.getAttribute('content') || '/ieee-ntc-yachay';

    function getFullUrl(path: string) {
      if (!path) return '';
      if (path.startsWith('http')) return path;
      const cleanBase = basePrefix.replace(/\/$/, '');
      const cleanPath = path.startsWith('/') ? path : '/' + path;
      return `${cleanBase}${cleanPath}`;
    }

    function renderSlide(index: number) {
      if (!currentAlbum || !currentAlbum.slides || currentAlbum.slides.length === 0) return;
      currentSlideIndex = (index + currentAlbum.slides.length) % currentAlbum.slides.length;
      const slide = currentAlbum.slides[currentSlideIndex];

      if (badgeEl) badgeEl.textContent = currentAlbum.badge;
      if (counterEl) counterEl.textContent = `Photo ${currentSlideIndex + 1} of ${currentAlbum.slides.length}`;
      if (titleEl) titleEl.textContent = currentAlbum.title;
      if (subtitleEl) subtitleEl.textContent = currentAlbum.subtitle;

      if (imgEl) {
        imgEl.src = getFullUrl(slide.image);
        imgEl.alt = slide.title;
        imgEl.style.objectPosition = slide.position || 'center center';
      }
      if (slideTitleEl) slideTitleEl.textContent = slide.title;
      if (slideDescEl) slideDescEl.textContent = slide.desc;

      // Update active thumbnail
      const thumbBtns = thumbsContainer?.querySelectorAll('.yachay-thumb-btn');
      thumbBtns?.forEach((btn, idx) => {
        if (idx === currentSlideIndex) {
          btn.classList.add('active');
          btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          btn.classList.remove('active');
        }
      });
    }

    function openAlbum(albumData: any) {
      currentAlbum = albumData;
      currentSlideIndex = 0;

      // Build thumbnails
      if (thumbsContainer) {
        thumbsContainer.innerHTML = '';
        currentAlbum.slides.forEach((s: any, idx: number) => {
          const btn = document.createElement('button');
          btn.className = `yachay-thumb-btn ${idx === 0 ? 'active' : ''}`;
          btn.setAttribute('type', 'button');
          btn.setAttribute('aria-label', `Go to photo ${idx + 1}: ${s.title}`);
          btn.innerHTML = `<img src="${getFullUrl(s.image)}" alt="${s.title}" class="yachay-thumb-img" style="object-position: ${s.position || 'center center'};" />`;
          btn.addEventListener('click', () => renderSlide(idx));
          thumbsContainer.appendChild(btn);
        });
      }

      renderSlide(0);
      modal?.showModal();
    }

    triggerBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-album');
        if (raw) {
          try {
            const album = JSON.parse(raw);
            openAlbum(album);
          } catch (e) {
            console.error('Error parsing album data', e);
          }
        }
      });
    });

    closeBtn?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    prevBtn?.addEventListener('click', () => renderSlide(currentSlideIndex - 1));
    nextBtn?.addEventListener('click', () => renderSlide(currentSlideIndex + 1));

    document.addEventListener('keydown', (e) => {
      if (!modal?.open) return;
      if (e.key === 'ArrowLeft') {
        renderSlide(currentSlideIndex - 1);
      } else if (e.key === 'ArrowRight') {
        renderSlide(currentSlideIndex + 1);
      } else if (e.key === 'Escape') {
        modal.close();
      }
    });
  });
</script>
