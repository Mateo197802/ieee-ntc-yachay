---
import Layout from '@/layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Sobre Nosotros | IEEE Nanotechnology Council Yachay Tech"
  description="Conoce la historia, misión, visión, objetivos estratégicos y beneficios del Capítulo Estudiantil IEEE Nanotechnology Council en Yachay Tech University."
>
  <!-- Inner Page Banner -->
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Inicio</a> &gt; <span>Sobre Nosotros</span>
      </div>
      <h1 class="banner-title font-heading">SOBRE NOSOTROS</h1>
      <p class="banner-subtitle">Impulsando a estudiantes en nanociencia, nanotecnología e innovación interdisciplinaria.</p>
    </div>
  </section>

  <!-- About History & Overview Section -->
  <section class="about-content-section">
    <div class="site-container">
      <div class="about-grid">
        <div class="about-text-block">
          <span class="section-eyebrow">IEEE NTC YACHAY TECH</span>
          <h2 class="section-title">IMPULSANDO LA NANOCIENCIA EN YACHAY TECH</h2>
          <p>
            El Capítulo Estudiantil del IEEE Nanotechnology Council (NTC) en Yachay Tech University es el capítulo pionero en Ecuador dedicado a fomentar la educación, la investigación interdisciplinaria y el desarrollo tecnológico en nanotecnología.
          </p>
          <p>
            Establecido bajo los lineamientos de IEEE Región 9, nuestro capítulo actúa como un puente entre estudiantes universitarios, investigadores, docentes asesores y redes científicas internacionales. Empoderamos a nuestros miembros mediante talleres prácticos de laboratorio, semilleros de redacción de artículos científicos, simulaciones en Realidad Virtual y vinculación STEM en colegios de la región.
          </p>
          <p>
            A través de una articulación estratégica y proyectos de alto rigor técnico, promovemos el liderazgo, la excelencia académica y publicaciones científicas con impacto en el ecosistema ecuatoriano e internacional.
          </p>
        </div>

        <div class="about-image-block">
          <img 
            src={getHref('/assets/gallery/foto_con_bandera.jpg')} 
            alt="Delegación del Capítulo IEEE NTC Yachay Tech" 
            width="600" 
            height="450" 
            class="about-hero-img" 
          />
          <div class="img-caption">
            <span>Delegación Oficial del Capítulo Estudiantil IEEE NTC Yachay Tech</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission, Vision & Values Section -->
  <section class="mission-vision-section">
    <div class="site-container">
      <div class="cards-3-grid">
        <div class="mv-card">
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <h3>NUESTRA MISIÓN</h3>
          <p>
            Cultivar un entorno científico dinámico que impulse la formación en nanotecnología, la redacción de artículos de investigación, la vinculación social y la colaboración técnica entre los estudiantes de Yachay Tech.
          </p>
        </div>

        <div class="mv-card">
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3>NUESTRA VISIÓN</h3>
          <p>
            Consolidarnos como un capítulo estudiantil referente en América Latina, reconocido por su excelencia investigativa, participación activa en conferencias internacionales IEEE (como IEEE NTC, LANANO y TEMSCON) y su impacto social.
          </p>
        </div>

        <div class="mv-card">
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h3>OBJETIVOS ESTRATÉGICOS</h3>
          <p>
            • Capacitación experimental en síntesis de nanomateriales.<br>
            • Mentoría técnica estructurada para IEEE LANANO 2026.<br>
            • Expansión de talleres de divulgación STEM en colegios.<br>
            • Gestión de becas de viaje y reconocimientos IEEE.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits of Joining IEEE Section -->
  <section class="benefits-section">
    <div class="site-container">
      <div class="section-header text-center">
        <span class="section-eyebrow">VENTAJAS DE LA MEMBRESÍA</span>
        <h2 class="section-title">¿POR QUÉ UNIRSE A IEEE Y AL IEEE NTC?</h2>
      </div>

      <div class="benefits-grid">
        <div class="benefit-box">
          <span class="b-number">01</span>
          <h4>Acceso a IEEE Xplore y Fondos Concursables</h4>
          <p>Acceso a revistas científicas de frontera, actas de conferencias internacionales y elegibilidad para fondos de financiamiento IEEE NTC Activity Grants y LANANO Travel Awards.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">02</span>
          <h4>Talleres Prácticos y Laboratorios</h4>
          <p>Participación en sesiones de laboratorio NanoSkills, caracterización UV-Vis, síntesis verde y simulaciones moleculares en Realidad Virtual.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">03</span>
          <h4>Liderazgo y Red de Contactos Global</h4>
          <p>Conexión directa con conferencistas distinguidos, expertos de la industria, directivos de IEEE Región 9 y roles de liderazgo en comités técnicos.</p>
        </div>
        <div class="benefit-box">
          <span class="b-number">04</span>
          <h4>Certificación y Fortalecimiento Profesional</h4>
          <p>Certificados oficiales de IEEE que avalan la participación en talleres, voluntariado STEM y coautoría en publicaciones científicas.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
  }

  .about-content-section {
    padding: 4.5rem 0;
    background-color: var(--color-white);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .about-text-block p {
    font-size: 1rem;
    color: var(--color-text-dark);
    margin-bottom: 1.25rem;
    line-height: 1.65;
  }

  .about-image-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .about-hero-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    object-position: center center;
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-hover);
    border: 2px solid var(--color-cyan);
  }

  .img-caption {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.75rem;
    font-style: italic;
  }

  .mission-vision-section {
    padding: 4.5rem 0;
    background-color: var(--color-bg-light);
  }

  .cards-3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .mv-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2.25rem;
    box-shadow: var(--shadow-subtle);
    border-top: 4px solid var(--color-cyan);
  }

  .mv-icon {
    color: var(--color-cyan);
    margin-bottom: 1rem;
  }

  .mv-card h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
  }

  .mv-card p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .benefits-section {
    padding: 4.5rem 0;
    background-color: var(--color-white);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .benefit-box {
    background-color: var(--color-bg-light);
    border-radius: var(--border-radius-sm);
    padding: 1.75rem;
    border-left: 4px solid var(--color-navy);
  }

  .b-number {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-cyan);
    display: block;
  }

  .benefit-box h4 {
    font-size: 1.1rem;
    color: var(--color-navy);
    margin: 0.4rem 0;
  }

  .benefit-box p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-hero-img {
      height: 360px;
    }
    .cards-3-grid {
      grid-template-columns: 1fr;
    }
    .benefits-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
