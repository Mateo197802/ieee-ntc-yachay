---
import Layout from '@/layouts/Layout.astro';
import { EVENTS_DATA } from '@/data/events';
import { GALLERY_ALBUMS } from '@/data/gallery';

const upcomingEvents = EVENTS_DATA.filter((e) => e.category === 'Próximos');
const pastEvents = EVENTS_DATA.filter((e) => e.category === 'Pasados');

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Actividades y Eventos | IEEE Nanotechnology Council Yachay Tech"
  description="Explora los próximos talleres, eventos de vinculación, conferencias científicas y capacitaciones del Capítulo Estudiantil IEEE NTC Yachay Tech."
>
  <!-- Hero Inner Banner -->
  <section class="events-hero">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')} data-i18n-es="Inicio" data-i18n-en="Home">Inicio</a> &gt; <span data-i18n-es="Actividades" data-i18n-en="Activities">Actividades</span>
      </div>
      <span class="hero-eyebrow" data-i18n-es="ACTIVIDADES Y COMUNIDAD" data-i18n-en="ACTIVITIES & COMMUNITY">ACTIVIDADES Y COMUNIDAD</span>
      <h1 class="hero-title font-heading" data-i18n-es="ACTIVIDADES Y EVENTOS" data-i18n-en="ACTIVITIES & EVENTS">ACTIVIDADES Y EVENTOS</h1>
      <p class="hero-subtitle" data-i18n-es="Explora nuestros próximos webinars, talleres prácticos de laboratorio, conferencias internacionales y jornadas de vinculación comunitaria." data-i18n-en="Explore our upcoming webinars, hands-on lab workshops, international conferences, and community outreach sessions.">
        Explora nuestros próximos webinars, talleres prácticos de laboratorio, conferencias internacionales y jornadas de vinculación comunitaria.
      </p>
    </div>
  </section>

  <!-- Sticky Internal Navigation Bar -->
  <section class="subnav-bar">
    <div class="site-container">
      <div class="subnav-links">
        <a href="#upcoming" class="subnav-btn active" data-i18n-es={`Próximos Eventos (${upcomingEvents.length})`} data-i18n-en={`Upcoming Events (${upcomingEvents.length})`}>Próximos Eventos ({upcomingEvents.length})</a>
        <a href="#past" class="subnav-btn" data-i18n-es={`Eventos Pasados (${pastEvents.length})`} data-i18n-en={`Past Events (${pastEvents.length})`}>Eventos Pasados ({pastEvents.length})</a>
        <a href="#calendar" class="subnav-btn" data-i18n-es="Calendario Académico" data-i18n-en="Academic Calendar">Calendario Académico</a>
      </div>
    </div>
  </section>

  <!-- Upcoming Events Section -->
  <section class="events-section" id="upcoming">
    <div class="site-container">
      <div class="section-header">
        <span class="section-eyebrow" data-i18n-es="AGENDA Y WEBINARS" data-i18n-en="AGENDA & WEBINARS">AGENDA Y WEBINARS</span>
        <h2 class="section-title" data-i18n-es="PRÓXIMO EVENTO" data-i18n-en="UPCOMING EVENT">PRÓXIMO EVENTO</h2>
      </div>

      <div class="upcoming-single-wrapper">
        {upcomingEvents.map((event) => (
          <article class={`upcoming-featured-card ${!event.image ? 'no-image-card' : ''}`} id={event.slug}>
            {event.image && (
              <div class="upcoming-image-side">
                <img src={getHref(event.image)} alt={event.imageAlt} width="520" height="320" loading="eager" class="featured-img" />
                <div class="upcoming-badges-group">
                  <span class="upcoming-live-badge">
                    <span class="pulse-dot"></span>
                    <span data-i18n-es="PRÓXIMO EVENTO" data-i18n-en="UPCOMING EVENT">PRÓXIMO EVENTO</span>
                  </span>
                  <span class="type-pill" data-i18n-es={event.type} data-i18n-en={event.typeEn}>{event.type}</span>
                </div>
              </div>
            )}

            <div class="upcoming-content-side">
              {!event.image && (
                <div class="upcoming-badges-top">
                  <span class="upcoming-live-badge">
                    <span class="pulse-dot"></span>
                    <span data-i18n-es="PRÓXIMO EVENTO" data-i18n-en="UPCOMING EVENT">PRÓXIMO EVENTO</span>
                  </span>
                  <span class="type-pill" data-i18n-es={event.type} data-i18n-en={event.typeEn}>{event.type}</span>
                </div>
              )}
              <div class="meta-bar">
                <span class="meta-date">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
                  <span data-i18n-es={`${event.date} • ${event.time}`} data-i18n-en={`${event.dateEn} • ${event.timeEn}`}>{event.date} • {event.time}</span>
                </span>
                <span class="modality-tag" data-i18n-es={event.modality} data-i18n-en={event.modalityEn}>{event.modality}</span>
              </div>

              <h3 class="upcoming-title" data-i18n-es={event.title} data-i18n-en={event.titleEn}>{event.title}</h3>
              <p class="upcoming-description" data-i18n-es={event.description} data-i18n-en={event.descriptionEn}>{event.description}</p>

              <div class="location-info">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                <span data-i18n-es={event.location} data-i18n-en={event.locationEn}>{event.location}</span>
              </div>

              <div class="upcoming-action-bar">
                {event.registrationStatus === 'open' && event.registrationUrl ? (
                  <a href={event.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-i18n-es="REGISTRARSE AHORA" data-i18n-en="REGISTER NOW">
                    REGISTRARSE AHORA
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                ) : (
                  <button class="btn btn-secondary disabled-status-btn" disabled data-i18n-es="REGISTRO PRÓXIMAMENTE" data-i18n-en="REGISTRATION OPENING SOON">
                    REGISTRO PRÓXIMAMENTE
                  </button>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Past Events Section -->
  <section class="events-section bg-alt" id="past">
    <div class="site-container">
      <div class="section-header">
        <span class="section-eyebrow" data-i18n-es="HISTORIAL Y ARCHIVO" data-i18n-en="HISTORY & ARCHIVE">HISTORIAL Y ARCHIVO</span>
        <h2 class="section-title" data-i18n-es="EVENTOS PASADOS Y VINCULACIÓN" data-i18n-en="PAST EVENTS & OUTREACH">EVENTOS PASADOS Y VINCULACIÓN</h2>
      </div>

      <div class="past-events-grid">
        {pastEvents.map((event) => {
          const album = GALLERY_ALBUMS.find((a) => a.id === event.galleryAlbumId);
          return (
            <article class="event-grid-card" id={event.slug}>
              <div class="card-image-box">
                <img src={getHref(event.image)} alt={event.imageAlt} width="400" height="225" loading="lazy" class="grid-img" />
                <span class="type-pill past" data-i18n-es={event.type} data-i18n-en={event.typeEn}>{event.type}</span>
                <span class="status-completed-badge" data-i18n-es="COMPLETADO" data-i18n-en="COMPLETED">COMPLETADO</span>
              </div>

              <div class="card-body">
                <div class="card-meta">
                  <span class="meta-date-text" data-i18n-es={event.date} data-i18n-en={event.dateEn}>{event.date}</span>
                  <span class="modality-tag past" data-i18n-es={event.modality} data-i18n-en={event.modalityEn}>{event.modality}</span>
                </div>

                <h3 class="card-grid-title" data-i18n-es={event.title} data-i18n-en={event.titleEn}>{event.title}</h3>
                <p class="card-grid-desc" data-i18n-es={event.description} data-i18n-en={event.descriptionEn}>{event.description}</p>

                <div class="grid-location">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                  <span data-i18n-es={event.location} data-i18n-en={event.locationEn}>{event.location}</span>
                </div>

                <div class="card-actions-row">
                  {event.externalUrl ? (
                    <a href={event.externalUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark card-btn" data-i18n-es="VER PROGRAMA" data-i18n-en="VIEW PROGRAM">
                      VER PROGRAMA
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6v2H5v12h12v-6h2v6c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z"/></svg>
                    </a>
                  ) : album ? (
                    <button 
                      class="btn btn-outline-dark card-btn open-event-gallery-btn"
                      data-album={JSON.stringify(album)}
                      data-i18n-es={`VER FOTOS DE GALERÍA (${album.slides.length})`}
                      data-i18n-en={`VIEW GALLERY PHOTOS (${album.slides.length})`}
                    >
                      VER FOTOS DE GALERÍA ({album.slides.length})
                    </button>
                  ) : (
                    <a href={getHref('/gallery/')} class="btn btn-outline-dark card-btn" data-i18n-es="VER FOTOS DE GALERÍA" data-i18n-en="VIEW GALLERY PHOTOS">
                      VER FOTOS DE GALERÍA
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Compact Academic Calendar Block -->
  <section class="events-section" id="calendar">
    <div class="site-container">
      <div class="calendar-compact-card">
        <div class="calendar-info-side">
          <span class="section-eyebrow" data-i18n-es="CALENDARIO ACADÉMICO" data-i18n-en="ACADEMIC CALENDAR">CALENDARIO ACADÉMICO</span>
          <h2 class="calendar-title font-heading" data-i18n-es="CALENDARIO DEL CAPÍTULO 2026" data-i18n-en="CHAPTER CALENDAR 2026">CALENDARIO DEL CAPÍTULO 2026</h2>
          <p class="calendar-desc" data-i18n-es="Mantente informado sobre las próximas actividades, talleres técnicos, conferencias internacionales y fechas de convocatorias del capítulo." data-i18n-en="Stay informed about upcoming activities, technical workshops, international conferences, and chapter application deadlines.">
            Mantente informado sobre las próximas actividades, talleres técnicos, conferencias internacionales y fechas de convocatorias del capítulo.
          </p>
        </div>

        <div class="calendar-action-side">
          <div class="next-event-preview">
            <span class="preview-label" data-i18n-es="PRÓXIMO EVENTO CONFIRMADO" data-i18n-en="NEXT CONFIRMED EVENT">PRÓXIMO EVENTO CONFIRMADO</span>
            <strong class="preview-title" data-i18n-es="IEEE NTC Region 9 Student Virtual Summit" data-i18n-en="IEEE NTC Region 9 Student Virtual Summit">IEEE NTC Region 9 Student Virtual Summit</strong>
            <span class="preview-date" data-i18n-es="15 de Octubre de 2026 • Virtual" data-i18n-en="October 15, 2026 • Virtual">15 de Octubre de 2026 • Virtual</span>
          </div>

          <a href="#upcoming" class="btn btn-primary calendar-cta" data-i18n-es="VER PRÓXIMO EVENTO" data-i18n-en="VIEW UPCOMING EVENT">
            VER PRÓXIMO EVENTO
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Carousel Modal for Event Gallery -->
  <dialog id="event-gallery-modal" class="event-modal-dialog">
    <div class="event-modal-inner">
      <button class="event-modal-close" id="event-modal-close-btn" aria-label="Cerrar galería">&times;</button>
      
      <div class="event-modal-header">
        <div class="modal-header-top">
          <span class="event-modal-category" id="modal-album-category">VINCULACIÓN</span>
          <span class="modal-counter-badge" id="modal-slide-counter">Foto 1 de 4</span>
        </div>
        <h2 class="event-modal-title" id="modal-album-title">Título del Evento</h2>
        <p class="event-modal-summary" id="modal-album-summary">Resumen del evento</p>
      </div>

      <!-- Carousel Viewer Stage with Prominent Lateral Arrows -->
      <div class="event-carousel-stage">
        <button class="carousel-nav-btn prev-btn" id="modal-prev-btn" aria-label="Foto anterior">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        </button>
        
        <div class="carousel-slide-box">
          <img id="modal-slide-img" src="" alt="" class="carousel-main-img" />
          <div class="carousel-caption-bar">
            <h4 class="slide-title" id="modal-slide-title">Título de la foto</h4>
            <p class="slide-desc" id="modal-slide-desc">Descripción de la foto</p>
          </div>
        </div>

        <button class="carousel-nav-btn next-btn" id="modal-next-btn" aria-label="Foto siguiente">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
      </div>

      <div class="modal-keyboard-hint">
        <span data-i18n-es="Usa las flechas laterales o las teclas ← / → para navegar" data-i18n-en="Use lateral arrows or keyboard ← / → to navigate">Usa las flechas laterales o las teclas &#8592; / &#8594; para navegar</span>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  /* Hero Banner */
  .events-hero {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--color-cyan);
    margin-bottom: 0.5rem;
  }

  .hero-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
    max-width: 720px;
  }

  /* Subnav Sticky */
  .subnav-bar {
    background-color: var(--color-navy);
    position: sticky;
    top: 74px;
    z-index: 100;
    border-bottom: 1px solid rgba(5, 135, 189, 0.3);
    padding: 0.75rem 0;
  }

  .subnav-links {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
  }

  .subnav-btn {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .subnav-btn:hover, .subnav-btn.active {
    background-color: var(--color-cyan);
    color: #ffffff;
  }

  .events-section {
    padding: 4.5rem 0;
  }

  .events-section.bg-alt {
    background-color: var(--color-bg-light);
  }

  /* Featured Single Upcoming Card */
  .upcoming-single-wrapper {
    max-width: 100%;
    margin-top: 1.5rem;
  }

  .upcoming-featured-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    background-color: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-hover);
    border: 1px solid var(--color-border-light);
  }

  .upcoming-featured-card.no-image-card {
    display: block;
    background: linear-gradient(135deg, #071C34 0%, #0c2545 60%, #15325b 100%);
    border: 2px solid #0587bd;
    box-shadow: 0 12px 36px rgba(5, 135, 189, 0.25);
  }

  .upcoming-featured-card.no-image-card .upcoming-content-side {
    padding: 3rem 3.5rem;
    color: #ffffff;
  }

  .upcoming-featured-card.no-image-card .upcoming-title {
    color: #ffffff;
    font-size: 1.85rem;
    margin: 0.75rem 0 1rem;
    line-height: 1.25;
  }

  .upcoming-featured-card.no-image-card .upcoming-description {
    color: rgba(255, 255, 255, 0.88);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 960px;
    margin-bottom: 1.5rem;
  }

  .upcoming-featured-card.no-image-card .meta-date {
    color: var(--color-cyan);
    font-size: 0.95rem;
  }

  .upcoming-featured-card.no-image-card .location-info {
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .upcoming-badges-top {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .upcoming-image-side {
    position: relative;
    background-color: #071c34;
    min-height: 320px;
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .upcoming-badges-group {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    display: flex;
    gap: 0.5rem;
    z-index: 2;
  }

  .upcoming-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: #0587BD;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 0.35rem 0.8rem;
    border-radius: 20px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #ffffff;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .type-pill {
    background-color: rgba(7, 28, 52, 0.85);
    color: var(--color-cyan);
    border: 1px solid var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 0.8rem;
    border-radius: 20px;
    text-transform: uppercase;
  }

  .type-pill.past {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
  }

  .upcoming-content-side {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .meta-date {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-cyan);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .modality-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-navy);
    background-color: rgba(5, 135, 189, 0.12);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .modality-tag.past {
    background-color: #f0f4f8;
    color: var(--color-text-muted);
  }

  .upcoming-title {
    font-size: 1.5rem;
    color: var(--color-navy);
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .upcoming-description {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .location-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }

  .upcoming-action-bar {
    display: flex;
    gap: 1rem;
  }

  .disabled-status-btn {
    opacity: 0.85;
    cursor: not-allowed;
    background-color: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.65rem 1.5rem;
    border-radius: 6px;
    font-size: 0.88rem;
    font-weight: 700;
  }

  /* Past Events Grid */
  .past-events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .event-grid-card {
    background-color: #ffffff;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .event-grid-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .card-image-box {
    position: relative;
    height: 190px;
    background-color: #06192e;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .grid-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .event-grid-card:hover .grid-img {
    transform: scale(1.03);
  }

  .status-completed-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.7rem;
