---
import Layout from '@/layouts/Layout.astro';
import { EVENTS_DATA } from '@/data/events';

const upcomingEvents = EVENTS_DATA.filter((e) => e.category === 'Upcoming');
const pastEvents = EVENTS_DATA.filter((e) => e.category === 'Past');

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Events & Activities | IEEE Nanotechnology Council Yachay Tech"
  description="Explore upcoming workshops, past outreach events, webinars, and technical conferences hosted by IEEE Nanotechnology Council Yachay Tech."
>
  <!-- Hero Inner Banner -->
  <section class="events-hero">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>Activities</span>
      </div>
      <span class="hero-eyebrow">ACTIVITIES & COMMUNITY</span>
      <h1 class="hero-title font-heading">EVENTS & ACTIVITIES</h1>
      <p class="hero-subtitle">
        Explore upcoming programs, workshops, conferences, outreach initiatives, and highlights from our chapter.
      </p>
    </div>
  </section>

  <!-- Sticky Internal Navigation Bar -->
  <section class="subnav-bar">
    <div class="site-container">
      <div class="subnav-links">
        <a href="#upcoming" class="subnav-btn active">Upcoming Event ({upcomingEvents.length})</a>
        <a href="#past" class="subnav-btn">Past Events ({pastEvents.length})</a>
        <a href="#calendar" class="subnav-btn">Academic Calendar</a>
      </div>
    </div>
  </section>

  <!-- Upcoming Events Section -->
  <section class="events-section" id="upcoming">
    <div class="site-container">
      <div class="section-header">
        <span class="section-eyebrow">AGENDA & WEBINARS</span>
        <h2 class="section-title">UPCOMING EVENT</h2>
      </div>

      <div class="upcoming-single-wrapper">
        {upcomingEvents.map((event) => (
          <article class="upcoming-featured-card" id={event.slug}>
            <div class="upcoming-image-side">
              <img src={getHref(event.image)} alt={event.imageAlt} width="520" height="320" loading="eager" class="featured-img" />
              <span class="type-pill">{event.type}</span>
            </div>

            <div class="upcoming-content-side">
              <div class="meta-bar">
                <span class="meta-date">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
                  {event.date} • {event.time}
                </span>
                <span class="modality-tag">{event.modality}</span>
              </div>

              <h3 class="upcoming-title">{event.title}</h3>
              <p class="upcoming-description">{event.description}</p>

              <div class="location-info">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                <span>{event.location}</span>
              </div>

              <div class="upcoming-action-bar">
                {event.registrationStatus === 'open' && event.registrationUrl ? (
                  <a href={event.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                    REGISTER NOW
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                ) : (
                  <button class="btn btn-secondary disabled-status-btn" disabled>
                    REGISTRATION OPENING SOON
                  </button>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Past Events Compact 3-Column Grid Section -->
  <section class="events-section bg-alt" id="past">
    <div class="site-container">
      <div class="section-header">
        <span class="section-eyebrow">ARCHIVE & HISTORY</span>
        <h2 class="section-title">PAST EVENTS & OUTREACH</h2>
      </div>

      <div class="past-events-grid">
        {pastEvents.map((event) => (
          <article class="event-grid-card" id={event.slug}>
            <div class="card-image-box">
              <img src={getHref(event.image)} alt={event.imageAlt} width="400" height="225" loading="lazy" class="grid-img" />
              <span class="type-pill past">{event.type}</span>
              <span class="status-completed-badge">COMPLETED</span>
            </div>

            <div class="card-body">
              <div class="card-meta">
                <span class="meta-date-text">{event.date}</span>
                <span class="modality-tag past">{event.modality}</span>
              </div>

              <h3 class="card-grid-title">{event.title}</h3>
              <p class="card-grid-desc">{event.description}</p>

              <div class="grid-location">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                <span>{event.location}</span>
              </div>

              <div class="card-actions-row">
                {event.externalUrl ? (
                  <a href={event.externalUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark card-btn">
                    VIEW PROGRAM
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6v2H5v12h12v-6h2v6c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z"/></svg>
                  </a>
                ) : (
                  <a href={getHref('/gallery/')} class="btn btn-outline-dark card-btn">
                    VIEW GALLERY PHOTOS
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Compact Academic Calendar Block -->
  <section class="events-section" id="calendar">
    <div class="site-container">
      <div class="calendar-compact-card">
        <div class="calendar-info-side">
          <span class="section-eyebrow">ACADEMIC SCHEDULE</span>
          <h2 class="calendar-title font-heading">CHAPTER CALENDAR 2026</h2>
          <p class="calendar-desc">
            Stay informed about upcoming chapter activities, workshops, scientific conferences, and academic deadlines.
          </p>
        </div>

        <div class="calendar-action-side">
          <div class="next-event-preview">
            <span class="preview-label">NEXT CONFIRMED EVENT</span>
            <strong class="preview-title">IEEE NTC Region 9 Student Virtual Summit</strong>
            <span class="preview-date">October 15, 2026 • Online</span>
          </div>

          <a href="#upcoming" class="btn btn-primary calendar-cta">
            VIEW UPCOMING EVENT
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Compact Events Hero Banner */
  .events-hero {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 2.8rem 0 3.2rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.5rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--color-cyan);
    margin-bottom: 0.4rem;
  }

  .hero-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.4rem;
    max-width: 680px;
  }

  /* Subnav Sticky Anchor Bar */
  .subnav-bar {
    background-color: #ffffff;
    border-bottom: 1px solid var(--color-border-light);
    padding: 0.85rem 0;
    position: sticky;
    top: 74px;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .subnav-links {
    display: flex;
    gap: 0.75rem;
  }

  .subnav-btn {
    padding: 0.45rem 1.1rem;
    border-radius: 20px;
    background-color: var(--color-bg-light);
    color: var(--color-navy);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .subnav-btn:hover,
  .subnav-btn.active {
    background-color: var(--color-cyan);
    color: #ffffff;
  }

  /* Sections */
  .events-section {
    padding: 3.5rem 0;
    background-color: #ffffff;
  }

  .events-section.bg-alt {
    background-color: var(--color-bg-light);
  }

  .section-header {
    margin-bottom: 2rem;
  }

  /* Sole Upcoming Event Horizontal Featured Card */
  .upcoming-single-wrapper {
    max-width: 1100px;
  }

  .upcoming-featured-card {
    display: grid;
    grid-template-columns: 420px 1fr;
    background-color: #ffffff;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .upcoming-featured-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .upcoming-image-side {
    position: relative;
    height: 100%;
    min-height: 260px;
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .type-pill {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: var(--color-cyan);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .type-pill.past {
    background-color: var(--color-slate);
  }

  .upcoming-content-side {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .meta-date {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-cyan);
  }

  .modality-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-navy);
    background-color: rgba(5, 135, 189, 0.12);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .modality-tag.past {
    background-color: rgba(70, 93, 100, 0.12);
    color: var(--color-slate);
  }

  .upcoming-title {
    font-size: 1.4rem;
    color: var(--color-navy);
    line-height: 1.25;
  }

  .upcoming-description {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .location-info {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-slate);
    font-weight: 500;
  }

  .upcoming-action-bar {
    margin-top: auto;
    padding-top: 1rem;
  }

  .disabled-status-btn {
    background-color: rgba(31, 62, 101, 0.1);
    color: var(--color-navy);
    border-color: rgba(31, 62, 101, 0.2);
    cursor: not-allowed;
    opacity: 0.85;
  }

  /* Past Events 3-Column Compact Grid Architecture */
  .past-events-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    align-items: stretch;
  }

  .event-grid-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    background-color: #ffffff;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .event-grid-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .card-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-navy);
    overflow: hidden;
  }

  .grid-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .status-completed-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(16, 42, 71, 0.85);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 20px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .meta-date-text {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-cyan);
  }

  .card-grid-title {
    font-size: 1.15rem;
    color: var(--color-navy);
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .card-grid-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .grid-location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--color-slate);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .card-actions-row {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .card-btn {
    width: 100%;
    font-size: 0.8rem;
    padding: 0.55rem 0.85rem;
  }

  /* Compact Academic Calendar Card */
  .calendar-compact-card {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 100%);
    color: #ffffff;
    border-radius: var(--border-radius-md);
    padding: 2.25rem 2.5rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    align-items: center;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-cyan);
  }

  .calendar-title {
    font-size: 1.75rem;
    color: #ffffff;
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .calendar-desc {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.82);
    max-width: 580px;
  }

  .calendar-action-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
  }

  .next-event-preview {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(5, 135, 189, 0.3);
    padding: 0.85rem 1.25rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: right;
  }

  .preview-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-cyan);
    letter-spacing: 1px;
  }

  .preview-title {
    font-size: 0.92rem;
    color: #ffffff;
  }

  .preview-date {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .calendar-cta {
    font-size: 0.82rem;
    padding: 0.65rem 1.25rem;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1100px) and (min-width: 768px) {
    .past-events-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }

    .upcoming-featured-card {
      grid-template-columns: 1fr;
    }

    .calendar-compact-card {
      grid-template-columns: 1fr;
    }

    .calendar-action-side {
      align-items: flex-start;
    }

    .next-event-preview {
      text-align: left;
    }
  }

  @media (max-width: 767px) {
    .past-events-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .upcoming-featured-card {
      grid-template-columns: 1fr;
    }

    .calendar-compact-card {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }

    .calendar-action-side {
      align-items: flex-start;
      width: 100%;
    }

    .next-event-preview {
      text-align: left;
      width: 100%;
    }

    .calendar-cta {
      width: 100%;
    }
  }
</style>
