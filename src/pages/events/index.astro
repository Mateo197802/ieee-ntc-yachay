---
import Layout from '@/layouts/Layout.astro';
import { EVENTS_DATA } from '@/data/events';
import { GALLERY_ALBUMS } from '@/data/gallery';

const upcomingEvents = EVENTS_DATA.filter((e) => e.category === 'Upcoming');
const pastEvents = EVENTS_DATA.filter((e) => e.category === 'Past');

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Activities & Events | IEEE Nanotechnology Council Yachay Tech"
  description="Explore our chronological archive of hands-on cleanroom workshops, international conferences, hospital VR outreach, school STEM programs, and academic seminars."
>
  <!-- Hero Inner Banner -->
  <section class="events-hero">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>Activities</span>
      </div>
      <span class="hero-eyebrow">CHRONOLOGICAL ARCHIVE & COMMUNITY IMPACT</span>
      <h1 class="hero-title font-heading">ACTIVITIES & EVENTS</h1>
      <p class="hero-subtitle">
        Documenting our journey across hands-on cleanroom workshops, international IEEE conferences, humanitarian VR hospital visits, pre-university STEM outreach, and expert global seminars.
      </p>
    </div>
  </section>

  <!-- Sticky Internal Navigation Bar -->
  <section class="subnav-bar">
    <div class="site-container">
      <div class="subnav-links">
        <a href="#upcoming" class="subnav-btn active">Upcoming Event ({upcomingEvents.length})</a>
        <a href="#past" class="subnav-btn">Past Events Archive ({pastEvents.length})</a>
        <a href="#calendar" class="subnav-btn">Academic Calendar</a>
      </div>
    </div>
  </section>

  <!-- Upcoming Events Section -->
  <section class="events-section" id="upcoming">
    <div class="site-container">
      <div class="section-header">
        <span class="section-eyebrow">AGENDA & WEBINARS</span>
        <h2 class="section-title">UPCOMING EVENT</h2>
      </div>

      <div class="upcoming-single-wrapper">
        {upcomingEvents.map((event) => (
          <article class={`upcoming-featured-card ${!event.image ? 'no-image-card' : ''}`} id={event.slug}>
            {event.image && (
              <div class="upcoming-image-side">
                <img src={getHref(event.image)} alt={event.imageAlt} width="520" height="320" loading="eager" class="featured-img" />
                <div class="upcoming-badges-group">
                  <span class="upcoming-live-badge">
                    <span class="pulse-dot"></span>
                    <span>UPCOMING EVENT</span>
                  </span>
                  <span class="type-pill">{event.type}</span>
                </div>
              </div>
            )}

            <div class="upcoming-content-side">
              {!event.image && (
                <div class="upcoming-badges-top">
                  <span class="upcoming-live-badge">
                    <span class="pulse-dot"></span>
                    <span>UPCOMING EVENT</span>
                  </span>
                  <span class="type-pill">{event.type}</span>
                </div>
              )}
              <div class="meta-bar">
                <span class="meta-date">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
                  <span>{event.date} • {event.time}</span>
                </span>
                <span class="modality-tag">{event.modality}</span>
              </div>

              <h3 class="upcoming-title">{event.title}</h3>
              <p class="upcoming-description">{event.description}</p>

              <div class="event-meta-breakdown">
                {event.who && (
                  <div class="meta-point">
                    <strong>Participants:</strong> <span>{event.who}</span>
                  </div>
                )}
                {event.objective && (
                  <div class="meta-point">
                    <strong>Objective:</strong> <span>{event.objective}</span>
                  </div>
                )}
                {event.impact && (
                  <div class="meta-point">
                    <strong>Expected Impact:</strong> <span>{event.impact}</span>
                  </div>
                )}
              </div>

              <div class="location-info">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                <span>{event.location}</span>
              </div>

              <div class="upcoming-action-bar">
                {event.registrationStatus === 'open' && event.registrationUrl ? (
                  <a href={event.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                    REGISTER NOW
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                ) : (
                  <button class="btn btn-secondary disabled-status-btn" disabled>
                    REGISTRATION OPENING SOON
                  </button>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Past Events Section -->
  <section class="events-section bg-alt" id="past">
    <div class="site-container">
      <div class="section-header">
        <span class="section-eyebrow">OFFICIAL CHRONOLOGY & IMPACT</span>
        <h2 class="section-title">PAST EVENTS & COMMUNITY INITIATIVES</h2>
      </div>

      <div class="past-events-grid">
        {pastEvents.map((event) => {
          const album = GALLERY_ALBUMS.find((a) => a.id === event.galleryAlbumId);
          return (
            <article class="event-grid-card" id={event.slug}>
              <div class="card-image-box">
                <img src={getHref(event.image)} alt={event.imageAlt} width="400" height="225" loading="lazy" class="grid-img" />
                <span class="type-pill past">{event.type}</span>
                <span class="status-completed-badge">COMPLETED</span>
              </div>

              <div class="card-body">
                <div class="card-meta">
                  <span class="meta-date-text">{event.date}</span>
                  <span class="modality-tag past">{event.modality}</span>
                </div>

                <h3 class="card-grid-title">{event.title}</h3>
                <p class="card-grid-desc">{event.description}</p>

                <!-- Detailed 5-Point Impact Card Section -->
                {(event.who || event.objective || event.impact) && (
                  <div class="event-mini-details">
                    {event.who && (
                      <div class="mini-detail-row">
                        <strong>Who Participated:</strong> <span>{event.who}</span>
                      </div>
                    )}
                    {event.objective && (
                      <div class="mini-detail-row">
                        <strong>Objective:</strong> <span>{event.objective}</span>
                      </div>
                    )}
                    {event.impact && (
                      <div class="mini-detail-row impact-row">
                        <strong>Impact:</strong> <span>{event.impact}</span>
                      </div>
                    )}
                  </div>
                )}

                <div class="grid-location">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                  <span>{event.location}</span>
                </div>

                <div class="card-actions-row">
                  {event.externalUrl ? (
                    <a href={event.externalUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark card-btn">
                      VIEW PROGRAM / PLATFORM
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6v2H5v12h12v-6h2v6c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z"/></svg>
                    </a>
                  ) : album ? (
                    <button 
                      class="btn btn-outline-dark card-btn open-event-gallery-btn"
                      data-album={JSON.stringify(album)}
                    >
                      VIEW GALLERY PHOTOS ({album.slides.length})
                    </button>
                  ) : (
                    <a href={getHref('/gallery/')} class="btn btn-outline-dark card-btn">
                      VIEW GALLERY PHOTOS
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Compact Academic Calendar Block -->
  <section class="events-section" id="calendar">
    <div class="site-container">
      <div class="calendar-compact-card">
        <div class="calendar-info-side">
          <span class="section-eyebrow">ACADEMIC CALENDAR</span>
          <h2 class="calendar-title font-heading">CHAPTER CALENDAR 2026</h2>
          <p class="calendar-desc">
            Stay informed about upcoming activities, technical workshops, international conferences, and chapter application deadlines.
          </p>
        </div>

        <div class="calendar-action-side">
          <div class="next-event-preview">
            <span class="preview-label">NEXT CONFIRMED EVENT</span>
            <strong class="preview-title">IEEE NTC Region 9 Student Virtual Summit</strong>
            <span class="preview-date">October 15, 2026 • Virtual</span>
          </div>

          <a href="#upcoming" class="btn btn-primary calendar-cta">
            VIEW UPCOMING EVENT
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Carousel Modal for Event Gallery -->
  <dialog id="event-gallery-modal" class="event-modal-dialog">
    <div class="event-modal-inner">
      <button class="event-modal-close" id="event-modal-close-btn" aria-label="Close gallery">&times;</button>
      
      <div class="event-modal-header">
        <div class="modal-header-top">
          <span class="event-modal-category" id="modal-album-category">OUTREACH</span>
          <span class="modal-counter-badge" id="modal-slide-counter">Photo 1 of 4</span>
        </div>
        <h2 class="event-modal-title" id="modal-album-title">Event Title</h2>
        <p class="event-modal-summary" id="modal-album-summary">Event Summary</p>
      </div>

      <!-- Carousel Viewer Stage with Lateral Arrows -->
      <div class="event-carousel-stage">
        <button class="carousel-nav-btn prev-btn" id="modal-prev-btn" aria-label="Previous photo">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        </button>
        
        <div class="carousel-slide-box">
          <img id="modal-slide-img" src="" alt="" class="carousel-main-img" />
          <div class="carousel-caption-bar">
            <h4 class="slide-title" id="modal-slide-title">Photo title</h4>
            <p class="slide-desc" id="modal-slide-desc">Photo description</p>
          </div>
        </div>

        <button class="carousel-nav-btn next-btn" id="modal-next-btn" aria-label="Next photo">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
      </div>

      <div class="modal-keyboard-hint">
        <span>Use lateral arrows or keyboard ← / → to navigate</span>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  /* Hero Banner */
  .events-hero {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3.5rem 0 4rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--color-cyan);
    margin-bottom: 0.5rem;
  }

  .hero-title {
    font-size: clamp(2.2rem, 3.8vw, 3rem);
    color: var(--color-white);
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.88);
    margin-top: 0.5rem;
    max-width: 820px;
    line-height: 1.6;
  }

  /* Subnav Bar */
  .subnav-bar {
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border-light);
    position: sticky;
    top: 74px;
    z-index: 900;
  }

  .subnav-links {
    display: flex;
    gap: 1.5rem;
  }

  .subnav-btn {
    padding: 1rem 0;
    color: var(--color-text-muted);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 3px solid transparent;
    transition: all var(--transition-fast);
  }

  .subnav-btn:hover,
  .subnav-btn.active {
    color: var(--color-cyan);
    border-bottom-color: var(--color-cyan);
  }

  /* Events Common */
  .events-section {
    padding: 4.5rem 0;
  }

  .events-section.bg-alt {
    background-color: var(--color-bg-light);
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-eyebrow {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: var(--color-cyan);
    display: block;
    margin-bottom: 0.35rem;
  }

  .section-title {
    font-size: 1.85rem;
    color: var(--color-navy);
  }

  /* Upcoming Featured Card */
  .upcoming-single-wrapper {
    max-width: 960px;
    margin: 0 auto;
  }

  .upcoming-featured-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-hover);
    border: 1px solid var(--color-border-light);
    display: grid;
    grid-template-columns: 1fr 1.25fr;
  }

  .upcoming-featured-card.no-image-card {
    grid-template-columns: 1fr;
  }

  .upcoming-image-side {
    position: relative;
    background-color: #071C34;
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .upcoming-badges-group {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: flex;
    gap: 0.5rem;
  }

  .upcoming-badges-top {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .upcoming-live-badge {
    background-color: rgba(7, 28, 52, 0.9);
    color: var(--color-white);
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--color-cyan);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10B981;
    box-shadow: 0 0 8px #10B981;
  }

  .type-pill {
    background-color: var(--color-cyan);
    color: var(--color-white);
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .upcoming-content-side {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  .upcoming-featured-card.no-image-card .upcoming-content-side {
    padding: 3rem 3.5rem;
  }

  .meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .meta-date {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-cyan);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .modality-tag {
    background-color: var(--color-bg-light);
    color: var(--color-navy);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .upcoming-title {
    font-size: 1.6rem;
    color: var(--color-navy);
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .upcoming-description {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .event-meta-breakdown {
    background-color: var(--color-bg-light);
    border-radius: var(--border-radius-sm);
    padding: 1.25rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid var(--color-border-light);
  }

  .meta-point {
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .meta-point strong {
    color: var(--color-navy);
    margin-right: 0.35rem;
  }

  .meta-point span {
    color: var(--color-text-muted);
  }

  .location-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-dark);
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .upcoming-action-bar {
    margin-top: auto;
  }

  .disabled-status-btn {
    opacity: 0.7;
    cursor: not-allowed;
    background-color: var(--color-bg-light);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-light);
  }

  /* Past Events Grid */
  .past-events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .event-grid-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .event-grid-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-cyan);
  }

  .card-image-box {
    position: relative;
    height: 190px;
    background-color: #0c2340;
    overflow: hidden;
  }

  .grid-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-normal);
  }

  .event-grid-card:hover .grid-img {
    transform: scale(1.04);
  }

  .type-pill.past {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
  }

  .status-completed-badge {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background-color: rgba(7, 28, 52, 0.85);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .meta-date-text {
    color: var(--color-cyan);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .modality-tag.past {
    font-size: 0.72rem;
    padding: 0.15rem 0.5rem;
  }

  .card-grid-title {
    font-size: 1.15rem;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .card-grid-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-mini-details {
    background-color: var(--color-bg-light);
    border-radius: 4px;
    padding: 0.85rem;
    font-size: 0.78rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border: 1px solid var(--color-border-light);
    margin-bottom: 1.25rem;
  }

  .mini-detail-row strong {
    color: var(--color-navy);
  }

  .mini-detail-row span {
    color: var(--color-text-muted);
  }

  .mini-detail-row.impact-row span {
    color: var(--color-institutional-blue);
    font-weight: 600;
  }

  .grid-location {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    margin-top: auto;
  }

  .card-actions-row {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-light);
  }

  .card-btn {
    width: 100%;
    text-align: center;
    justify-content: center;
    font-size: 0.82rem;
  }

  /* Academic Calendar Block */
  .calendar-compact-card {
    background: linear-gradient(135deg, var(--color-navy) 0%, #0d2a4e 100%);
    border-radius: var(--border-radius-md);
    padding: 3rem;
    color: var(--color-white);
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
    border: 1px solid var(--color-cyan);
  }

  .calendar-title {
    color: var(--color-white);
    font-size: 1.75rem;
    margin: 0.25rem 0 1rem;
  }

  .calendar-desc {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .calendar-action-side {
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: var(--border-radius-sm);
    padding: 1.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .preview-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-cyan);
    letter-spacing: 1px;
    display: block;
    margin-bottom: 0.25rem;
  }

  .preview-title {
    font-size: 1.05rem;
    color: var(--color-white);
    display: block;
    line-height: 1.35;
  }

  .preview-date {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.7);
    display: block;
