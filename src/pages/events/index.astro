</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const baseUrl = '/ieee-ntc-yachay';
    function resolveUrl(path: string) {
      if (!path) return '';
      if (path.startsWith('http') || path.startsWith(baseUrl)) return path;
      return `${baseUrl.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
    }

    const modal = document.getElementById('event-gallery-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('event-modal-close-btn');
    const prevBtn = document.getElementById('modal-prev-btn');
    const nextBtn = document.getElementById('modal-next-btn');

    const catEl = document.getElementById('modal-album-category');
    const titleEl = document.getElementById('modal-album-title');
    const summaryEl = document.getElementById('modal-album-summary');

    const slideImg = document.getElementById('modal-slide-img') as HTMLImageElement | null;
    const counterEl = document.getElementById('modal-slide-counter');
    const slideTitleEl = document.getElementById('modal-slide-title');
    const slideDescEl = document.getElementById('modal-slide-desc');

    let currentAlbum: any = null;
    let currentIndex = 0;

    function renderSlide(idx: number) {
      if (!currentAlbum || !currentAlbum.slides || currentAlbum.slides.length === 0) return;
      currentIndex = (idx + currentAlbum.slides.length) % currentAlbum.slides.length;
      const slide = currentAlbum.slides[currentIndex];

      if (slideImg) slideImg.src = resolveUrl(slide.image);
      if (catEl) catEl.textContent = currentAlbum.category.toUpperCase();
      if (titleEl) titleEl.textContent = currentAlbum.title;
      if (summaryEl) summaryEl.textContent = currentAlbum.summary;
      if (counterEl) counterEl.textContent = `Photo ${currentIndex + 1} of ${currentAlbum.slides.length}`;
      if (slideTitleEl) slideTitleEl.textContent = slide.title;
      if (slideDescEl) slideDescEl.textContent = slide.caption;
    }

    document.querySelectorAll('.open-event-gallery-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-album');
        if (!raw || !modal) return;
        currentAlbum = JSON.parse(raw);
        currentIndex = 0;

        renderSlide(0);
        modal.showModal();
      });
    });

    prevBtn?.addEventListener('click', () => renderSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => renderSlide(currentIndex + 1));

    document.addEventListener('keydown', (e) => {
      if (modal?.open) {
        if (e.key === 'ArrowLeft') renderSlide(currentIndex - 1);
        if (e.key === 'ArrowRight') renderSlide(currentIndex + 1);
      }
    });

    closeBtn?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  });
</script>
