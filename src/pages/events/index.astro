---
import Layout from '@/layouts/Layout.astro';
import { EVENTS_DATA } from '@/data/events';

const upcomingEvents = EVENTS_DATA.filter((e) => e.category === 'Upcoming');
const pastEvents = EVENTS_DATA.filter((e) => e.category === 'Past');

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Events & Activities | IEEE Nanotechnology Council Yachay Tech"
  description="Explore upcoming workshops, past outreach events, webinars, and technical conferences hosted by IEEE Nanotechnology Council Yachay Tech."
>
  <section class="inner-banner">
    <div class="container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>Events</span>
      </div>
      <h1 class="banner-title font-heading">EVENTS & ACTIVITIES</h1>
      <p class="banner-subtitle">Workshops, technical conferences, webinars, and community STEM outreach activities.</p>
    </div>
  </section>

  <!-- Navigation Anchors Bar -->
  <section class="subnav-bar">
    <div class="container">
      <div class="subnav-links">
        <a href="#upcoming" class="subnav-btn">Upcoming Events ({upcomingEvents.length})</a>
        <a href="#past" class="subnav-btn">Past Events ({pastEvents.length})</a>
        <a href="#calendar" class="subnav-btn">Academic Calendar</a>
      </div>
    </div>
  </section>

  <!-- Upcoming Events Section -->
  <section class="events-section" id="upcoming">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">AGENDA & WEBINARS</span>
        <h2 class="section-title">UPCOMING EVENTS</h2>
      </div>

      <div class="events-grid">
        {upcomingEvents.map((event) => (
          <article class="event-detailed-card" id={event.slug}>
            <div class="event-image-side">
              <img src={getHref(event.image)} alt={event.title} width="400" height="260" loading="lazy" class="card-img" />
              <span class="type-pill">{event.type}</span>
            </div>

            <div class="event-content-side">
              <div class="event-meta-bar">
                <span class="meta-item">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
                  {event.date} • {event.time}
                </span>
                <span class="modality-tag">{event.modality}</span>
              </div>

              <h3 class="card-title">{event.title}</h3>
              <p class="card-summary">{event.description}</p>

              <div class="event-location-info">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                <span>{event.location}</span>
              </div>

              <div class="card-action-bar">
                {event.registrationUrl ? (
                  <a href={event.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                    REGISTER NOW
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                ) : (
                  <span class="btn btn-secondary disabled-btn">Registration Pending</span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Past Events Section -->
  <section class="events-section bg-alt" id="past">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">ARCHIVE & HISTORY</span>
        <h2 class="section-title">PAST EVENTS & OUTREACH</h2>
      </div>

      <div class="events-grid">
        {pastEvents.map((event) => (
          <article class="event-detailed-card" id={event.slug}>
            <div class="event-image-side">
              <img src={getHref(event.image)} alt={event.title} width="400" height="260" loading="lazy" class="card-img" />
              <span class="type-pill past">{event.type}</span>
            </div>

            <div class="event-content-side">
              <div class="event-meta-bar">
                <span class="meta-item">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
                  {event.date}
                </span>
                <span class="modality-tag past">{event.modality}</span>
              </div>

              <h3 class="card-title">{event.title}</h3>
              <p class="card-summary">{event.description}</p>

              <div class="event-location-info">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                <span>{event.location}</span>
              </div>

              <div class="card-action-bar">
                <a href={getHref('/gallery/')} class="btn btn-outline-dark">
                  VIEW GALLERY PHOTOS
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Calendar Integration Section -->
  <section class="events-section" id="calendar">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-eyebrow">ACADEMIC SCHEDULE</span>
        <h2 class="section-title">CHAPTER CALENDAR 2026</h2>
        <p class="section-desc">Sync our Google Calendar to stay updated with workshop dates and submission deadlines.</p>
      </div>

      <div class="calendar-box">
        <div class="calendar-placeholder">
          <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <h3>Official IEEE NTC Google Calendar Integration</h3>
          <p>Subscribe to automatically add chapter activities to your calendar application.</p>
          <a href="https://calendar.google.com" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            SUBSCRIBE TO GOOGLE CALENDAR
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-deep-blue) 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: 2.5rem;
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
  }

  .subnav-bar {
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border-light);
    padding: 1rem 0;
    position: sticky;
    top: var(--header-height);
    z-index: 100;
  }

  .subnav-links {
    display: flex;
    gap: 1rem;
  }

  .subnav-btn {
    padding: 0.5rem 1.25rem;
    border-radius: 20px;
    background-color: var(--color-bg-light);
    color: var(--color-navy);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .subnav-btn:hover {
    background-color: var(--color-cyan);
    color: var(--color-white);
  }

  .events-section {
    padding: 4rem 0;
    background-color: var(--color-white);
  }

  .events-section.bg-alt {
    background-color: var(--color-bg-light);
  }

  .events-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .event-detailed-card {
    display: grid;
    grid-template-columns: 360px 1fr;
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .event-detailed-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .event-image-side {
    position: relative;
    height: 100%;
    min-height: 240px;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .type-pill {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: var(--color-cyan);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    text-transform: uppercase;
  }

  .type-pill.past {
    background-color: var(--color-slate);
  }

  .event-content-side {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .event-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-cyan);
  }

  .modality-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-navy);
    background-color: rgba(5, 135, 189, 0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .card-title {
    font-size: 1.35rem;
    color: var(--color-navy);
  }

  .card-summary {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .event-location-info {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-slate);
    font-weight: 500;
  }

  .card-action-bar {
    margin-top: auto;
    padding-top: 1rem;
  }

  .calendar-box {
    background-color: var(--color-bg-light);
    border: 2px dashed var(--color-cyan);
    border-radius: var(--border-radius-md);
    padding: 3.5rem 2rem;
    text-align: center;
  }

  .calendar-placeholder {
    max-width: 500px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: var(--color-navy);
  }

  .calendar-placeholder h3 {
    font-family: var(--font-heading);
    font-size: 1.4rem;
  }

  .calendar-placeholder p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .event-detailed-card {
      grid-template-columns: 1fr;
    }
    .event-image-side {
      height: 200px;
    }
  }
</style>
