---
import Layout from '@/layouts/Layout.astro';
import { DIRECTIVE_DATA } from '@/data/directive';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

function getInitials(name: string) {
  return name
    .split(' ')
    .filter((n) => n.length > 0 && n !== 'De' && n !== 'La')
    .slice(0, 2)
    .map((n) => n[0].toUpperCase())
    .join('');
}
---

<Layout 
  title="Directiva | IEEE Nanotechnology Council Yachay Tech"
  description="Conoce a la junta directiva fundadora y webmasters del Capítulo Estudiantil IEEE Nanotechnology Council en Yachay Tech University."
>
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Inicio</a> &gt; <span>Directiva</span>
      </div>
      <span class="banner-eyebrow">LIDERAZGO ESTUDIANTIL</span>
      <h1 class="banner-title font-heading">JUNTA DIRECTIVA FUNDADORA</h1>
      <p class="banner-subtitle">
        Conoce a los estudiantes que lideran IEEE NTC Yachay Tech a través de la investigación, el desarrollo académico, la divulgación científica, la comunicación digital y la innovación con impacto social.
      </p>
    </div>
  </section>

  <section class="directive-section">
    <div class="site-container">
      <!-- 3x2 Grid for 6 Executive Members -->
      <div class="directive-grid">
        {DIRECTIVE_DATA.map((member) => (
          <article class="directive-card" id={member.id}>
            <!-- Profile Avatar Box -->
            <div class="directive-avatar-container">
              {member.image ? (
                <img 
                  src={getHref(member.image)} 
                  alt={member.name} 
                  width="400" 
                  height="380" 
                  class="directive-img" 
                  loading="lazy" 
                />
              ) : (
                <div class="avatar-placeholder" aria-label={`Avatar para ${member.name}`}>
                  <div class="nano-pattern-overlay" aria-hidden="true"></div>
                  <span class="avatar-initials">{getInitials(member.name)}</span>
                  <span class="avatar-tag">IEEE NTC YACHAY TECH</span>
                </div>
              )}
              <span class="term-pill">DIRECTIVA FUNDADORA</span>
            </div>

            <!-- Profile Info Content -->
            <div class="directive-content">
              <h2 class="member-name">{member.name}</h2>
              <p class="member-role">{member.role}</p>
              <p class="member-program">{member.academicProgram}</p>
              
              <p class="member-summary">{member.bio.split('\n\n')[0]}</p>

              <div class="member-interests">
                {member.focusAreas.slice(0, 3).map((tag) => (
                  <span class="interest-tag">{tag}</span>
                ))}
              </div>

              <!-- Action Bar -->
              <div class="directive-actions">
                <button 
                  class="btn btn-primary profile-modal-btn" 
                  data-member={JSON.stringify(member)}
                  aria-label={`Ver perfil completo de ${member.name}`}
                >
                  VER PERFIL COMPLETO
                </button>
                {member.linkedin && (
                  <a 
                    href={member.linkedin} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="linkedin-btn" 
                    aria-label={`${member.name} en LinkedIn`}
                  >
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Profile Detail Modal -->
  <dialog id="profile-modal" class="profile-modal">
    <div class="modal-dialog-content">
      <button id="modal-close-btn" class="modal-close-btn" aria-label="Cerrar modal de perfil">&times;</button>
      <div class="modal-body" id="modal-body-container">
        <!-- Dynamically populated via JS -->
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--color-cyan);
    margin-bottom: 0.5rem;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
    max-width: 720px;
  }

  .directive-section {
    padding: 4rem 0 5rem;
    background-color: var(--color-bg-light);
  }

  /* 3x2 Grid Desktop Architecture */
  .directive-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    align-items: stretch;
  }

  .directive-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    background-color: #ffffff;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .directive-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  /* Avatar Box */
  .directive-avatar-container {
    position: relative;
    width: 100%;
    height: 380px;
    background-color: #122844;
    overflow: hidden;
  }

  .directive-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 0.4s ease;
  }

  .directive-card:hover .directive-img {
    transform: scale(1.03);
  }

  .avatar-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #102642 0%, #1A385C 100%);
    position: relative;
  }

  .nano-pattern-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: radial-gradient(var(--color-cyan) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.15;
  }

  .avatar-initials {
    font-family: var(--font-heading);
    font-size: 3.2rem;
    color: var(--color-cyan);
    letter-spacing: 2px;
    z-index: 2;
    text-shadow: 0 0 16px rgba(5, 135, 189, 0.4);
  }

  .avatar-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 0.25rem;
    z-index: 2;
  }

  .term-pill {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(31, 62, 101, 0.85);
    backdrop-filter: blur(4px);
    color: var(--color-cyan);
    border: 1px solid var(--color-cyan);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    z-index: 3;
  }

  /* Card Content */
  .directive-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 24px;
  }

  .member-name {
    font-size: 1.25rem;
    color: var(--color-navy);
    margin-bottom: 0.25rem;
    line-height: 1.25;
  }

  .member-role {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-cyan);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.25rem;
  }

  .member-program {
    font-size: 0.78rem;
    color: var(--color-text-dark);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .member-summary {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .member-interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .interest-tag {
    font-size: 0.72rem;
    font-weight: 600;
    background-color: var(--color-bg-alt);
    color: var(--color-navy);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .directive-actions {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .profile-modal-btn {
    flex: 1;
    font-size: 0.82rem;
    padding: 0.6rem 1rem;
  }

  .linkedin-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background-color: rgba(31, 62, 101, 0.08);
    color: var(--color-navy);
    border-radius: var(--border-radius-sm);
    transition: all 0.2s ease;
    text-decoration: none;
    flex-shrink: 0;
  }

  .linkedin-btn:hover {
    background-color: var(--color-cyan);
    color: #ffffff;
  }

  /* Modal Styling */
  .profile-modal {
    border: none;
    border-radius: 12px;
    padding: 0;
    max-width: 720px;
    width: 92vw;
    background: #ffffff;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    margin: auto;
  }

  .profile-modal::backdrop {
    background: rgba(7, 28, 52, 0.75);
    backdrop-filter: blur(4px);
  }

  .modal-dialog-content {
    position: relative;
    padding: 2.5rem;
    max-height: 85vh;
    overflow-y: auto;
  }

  .modal-close-btn {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: transparent;
    border: none;
    font-size: 2rem;
    color: var(--color-navy);
    cursor: pointer;
  }

  /* Responsive Rules */
  @media (max-width: 1100px) and (min-width: 768px) {
    .directive-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media (max-width: 767px) {
    .directive-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('profile-modal') as HTMLDialogElement | null;
    const modalBody = document.getElementById('modal-body-container');
    const closeBtn = document.getElementById('modal-close-btn');

    document.querySelectorAll('.profile-modal-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const rawData = btn.getAttribute('data-member');
        if (!rawData || !modal || !modalBody) return;

        const member = JSON.parse(rawData);
        const bioParagraphs = member.bio ? member.bio.split('\n\n') : [];

        modalBody.innerHTML = `
          <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div style="border-bottom: 2px solid #0587BD; padding-bottom: 0.75rem;">
              <span style="font-size: 0.8rem; font-weight: 700; color: #0587BD; text-transform: uppercase;">${member.role} · IEEE NTC YACHAY TECH</span>
              <h2 style="font-size: 1.6rem; color: #1F3E65; margin-top: 0.25rem;">${member.name}</h2>
              <p style="font-size: 0.85rem; color: #465D64; margin-top: 0.25rem; font-weight: 600;">${member.academicProgram}</p>
            </div>
            
            <div style="font-size: 0.95rem; color: #2D3748; line-height: 1.65; display: flex; flex-direction: column; gap: 0.85rem;">
              ${bioParagraphs.map((p: string) => `<p>${p}</p>`).join('')}
            </div>

            <div style="margin-top: 0.5rem;">
              <h4 style="font-size: 0.9rem; color: #1F3E65; margin-bottom: 0.5rem;">Áreas de Enfoque e Investigación</h4>
              <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                ${member.focusAreas.map((tag: string) => `<span style="font-size: 0.78rem; background: #EBF1F6; color: #1F3E65; font-weight: 600; padding: 0.3rem 0.7rem; border-radius: 4px;">${tag}</span>`).join('')}
              </div>
            </div>

            <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #EBF1F6; display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.85rem; color: #465D64;">Contacto: <strong>${member.email}</strong></span>
              ${member.linkedin ? `
                <a href="${member.linkedin}" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 0.5rem; background-color: #0587BD; color: #ffffff; padding: 0.6rem 1.2rem; border-radius: 4px; text-decoration: none; font-weight: 700; font-size: 0.85rem;">
                  CONECTAR EN LINKEDIN
                </a>
              ` : ''}
            </div>
          </div>
        `;

        modal.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => {
      modal?.close();
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  });
</script>
