---
import Layout from '@/layouts/Layout.astro';
import { DIRECTIVE_MEMBERS } from '@/data/directive';

const executiveBoard = DIRECTIVE_MEMBERS.filter((m) => m.category === 'Executive Board');
const coordinators = DIRECTIVE_MEMBERS.filter((m) => m.category === 'Coordinators');
const advisors = DIRECTIVE_MEMBERS.filter((m) => m.category === 'Advisors');

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Directive & Leadership | IEEE Nanotechnology Council Yachay Tech"
  description="Meet the executive officers, committee leaders, and faculty advisors of IEEE Nanotechnology Council Yachay Tech Student Branch."
>
  <section class="inner-banner">
    <div class="container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>Directive</span>
      </div>
      <h1 class="banner-title font-heading">DIRECTIVE & LEADERSHIP</h1>
      <p class="banner-subtitle">Executive board officers and coordinators leading IEEE NTC Yachay Tech Student Branch.</p>
    </div>
  </section>

  <!-- Executive Board Section -->
  <section class="directive-section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">CHAPTER GOVERNANCE</span>
        <h2 class="section-title">EXECUTIVE BOARD (2025 - 2026)</h2>
      </div>

      <div class="directive-grid">
        {executiveBoard.map((member) => (
          <div class="member-card">
            <div class="member-photo-box">
              <img src={getHref(member.photo)} alt={member.name} width="320" height="260" loading="lazy" class="member-photo" />
              <span class="term-badge">{member.term}</span>
            </div>

            <div class="member-body">
              <h3 class="member-name">{member.name}</h3>
              <p class="member-role">{member.role}</p>
              <p class="member-bio">{member.bio}</p>

              <div class="member-contact">
                <a href={`mailto:${member.email}`} class="contact-link" title="Send Email">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                  {member.email}
                </a>
                {member.linkedin && (
                  <a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn Profile">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Coordinators Section -->
  <section class="directive-section bg-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">OPERATIONAL LEADS</span>
        <h2 class="section-title">COMMITTEE COORDINATORS</h2>
      </div>

      <div class="directive-grid">
        {coordinators.map((member) => (
          <div class="member-card">
            <div class="member-photo-box">
              <img src={getHref(member.photo)} alt={member.name} width="320" height="260" loading="lazy" class="member-photo" />
              <span class="term-badge">{member.term}</span>
            </div>

            <div class="member-body">
              <h3 class="member-name">{member.name}</h3>
              <p class="member-role">{member.role}</p>
              <p class="member-bio">{member.bio}</p>

              <div class="member-contact">
                <a href={`mailto:${member.email}`} class="contact-link">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                  {member.email}
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Faculty Advisors Section -->
  <section class="directive-section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">ACADEMIC ADVISORY</span>
        <h2 class="section-title">FACULTY ADVISORS</h2>
      </div>

      <div class="directive-grid">
        {advisors.map((member) => (
          <div class="member-card pending-card">
            <div class="member-photo-box">
              <div class="placeholder-photo">
                <svg viewBox="0 0 24 24" width="48" height="48" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
              </div>
              <span class="pending-badge">Pending Confirmation</span>
            </div>

            <div class="member-body">
              <h3 class="member-name">{member.name}</h3>
              <p class="member-role">{member.role}</p>
              <p class="member-bio">{member.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-deep-blue) 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: 2.5rem;
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
  }

  .directive-section {
    padding: 4rem 0;
    background-color: var(--color-white);
  }

  .directive-section.bg-alt {
    background-color: var(--color-bg-light);
  }

  .directive-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .member-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .member-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .member-photo-box {
    position: relative;
    height: 220px;
    background-color: var(--color-bg-alt);
    overflow: hidden;
  }

  .member-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder-photo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: var(--color-bg-alt);
    color: var(--color-slate);
  }

  .term-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background-color: var(--color-navy);
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
  }

  .pending-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background-color: #D97706;
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
  }

  .member-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.5rem;
  }

  .member-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .member-role {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-cyan);
    text-transform: uppercase;
  }

  .member-bio {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;

    margin-bottom: 0.5rem;
  }

  .member-contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-light);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--color-institutional-blue);
    text-decoration: none;
    font-weight: 600;
  }

  .contact-link:hover {
    color: var(--color-cyan);
  }

  .social-btn {
    color: var(--color-slate);
    transition: color 0.2s ease;
  }

  .social-btn:hover {
    color: var(--color-cyan);
  }

  @media (max-width: 1024px) {
    .directive-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .directive-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
