---
import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/config/site';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Contact | IEEE Nanotechnology Council Yachay Tech"
  description="Get in touch with the IEEE Nanotechnology Council Student Branch Chapter at Yachay Tech University. Inquire about volunteering, memberships, workshops, or research collaborations."
>
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>Contact</span>
      </div>
      <span class="banner-eyebrow">DIRECT COMMUNICATION & COLLABORATION</span>
      <h1 class="banner-title font-heading">CONTACT US</h1>
      <p class="banner-subtitle">Have questions about becoming a volunteer, IEEE NTC memberships, laboratory workshops, or research collaborations? We are here to help.</p>
    </div>
  </section>

  <section class="contact-section" id="contact">
    <div class="site-container">
      <div class="contact-grid">
        <!-- Contact Form Column -->
        <div class="contact-form-card" id="contact-form-card">
          <h2 class="form-title font-heading">SEND US A MESSAGE</h2>
          <p class="form-desc">Fill out the form below and our executive board will get back to you within 24 to 48 hours.</p>

          <form id="contact-form" action="https://formspree.io/f/demo" method="POST" class="contact-form" novalidate>
            <!-- Honeypot Bot Field -->
            <div class="sr-only" aria-hidden="true">
              <label for="bot-field">Do not fill this field if human:</label>
              <input type="text" id="bot-field" name="bot-field" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form-group">
              <label for="fullName">Full Name <span class="required">*</span></label>
              <input type="text" id="fullName" name="name" required placeholder="e.g. Jane Doe" class="form-control" />
              <span class="error-msg" id="error-name">Please enter your full name.</span>
            </div>

            <div class="form-group">
              <label for="email">Institutional or Personal Email <span class="required">*</span></label>
              <input type="email" id="email" name="email" required placeholder="e.g. jane.doe@university.edu" class="form-control" />
              <span class="error-msg" id="error-email">Please enter a valid email address.</span>
            </div>

            <div class="form-group">
              <label for="subject">Subject / Inquiry Type <span class="required">*</span></label>
              <select id="subject" name="subject" required class="form-control">
                <option value="">Select a topic...</option>
                <option value="volunteer">Become a Volunteer & Join Chapter Activities</option>
                <option value="membership">IEEE & NTC Official Membership Inquiry</option>
                <option value="lanano">LANANO 2026 Research Incubator</option>
                <option value="workshop">Workshops & Conferences Registration</option>
                <option value="outreach">STEM Outreach & School Visits</option>
                <option value="general">General Inquiry / Support</option>
              </select>
              <span class="error-msg" id="error-subject">Please select a subject.</span>
            </div>

            <div class="form-group">
              <label for="message">Message <span class="required">*</span></label>
              <textarea id="message" name="message" rows="5" required placeholder="Write the details of your inquiry or volunteer application..." class="form-control"></textarea>
              <span class="error-msg" id="error-message">Please write your message.</span>
            </div>

            <div class="form-group checkbox-group">
              <input type="checkbox" id="privacyConsent" name="privacyConsent" required />
              <label for="privacyConsent">I agree that IEEE NTC Yachay Tech may process my contact details to reply to my request.</label>
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="submit-btn">
              <span>SEND MESSAGE</span>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
            </button>

            <!-- Success Alert Banner -->
            <div class="form-status success" id="form-status-success" style="display: none;" role="alert">
              <strong>Message Sent Successfully!</strong> Thank you for reaching out to IEEE NTC Yachay Tech. We will reply shortly.
            </div>
          </form>
        </div>

        <!-- Location & Contact Info Column -->
        <div class="contact-info-column">
          <!-- Fast Volunteer & Membership Direct Card -->
          <div class="info-card volunteer-quick-card">
            <h2 class="card-title font-heading">LOOKING TO JOIN US?</h2>
            <div class="quick-join-desc">
              <p><strong>Volunteers:</strong> No active IEEE membership is needed to collaborate with us. Just send us a message or contact us on Instagram!</p>
              <p><strong>Official Members:</strong> Reach out to register your active IEEE number and join our executive working committees.</p>
            </div>
          </div>

          <div class="info-card">
            <h2 class="card-title font-heading">INSTITUTIONAL HEADQUARTERS</h2>
            
            <ul class="info-list">
              <li>
                <div class="info-icon">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                </div>
                <div>
                  <strong>Campus {siteConfig.location.institution}</strong>
                  <p>Hacienda San José, {siteConfig.location.city}<br>Imbabura, {siteConfig.location.country}</p>
                </div>
              </li>

              <li>
                <div class="info-icon">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                </div>
                <div>
                  <strong>Official Email</strong>
                  <p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
                </div>
              </li>

              <li>
                <div class="info-icon">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                </div>
                <div>
                  <strong>LinkedIn</strong>
                  <p><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">IEEE NTC Yachay Tech</a></p>
                </div>
              </li>

              <li>
                <div class="info-icon">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </div>
                <div>
                  <strong>Instagram</strong>
                  <p><a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer">@ntc.yachaytech</a></p>
                </div>
              </li>
            </ul>
          </div>

          <!-- Interactive Campus Map Frame with Exact GPS Coordinates -->
          <div class="map-card">
            <div class="map-header">
              <h3 class="map-heading">YACHAY TECH CAMPUS MAP</h3>
              <a 
                href="https://www.bing.com/maps?cp=0.405614~-78.174637&lvl=16&ppois=0.4056141674518585_-78.17463684082031_Yachay+Tech+University" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="map-external-link"
              >
                <span>Open in Maps</span>
                <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6v2H5v12h12v-6h2v6c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z"/></svg>
              </a>
            </div>
            <div class="map-embed-wrapper">
              <iframe 
                src="https://maps.google.com/maps?q=0.4056141674518585,-78.17463684082031+(Universidad+Yachay+Tech)&hl=en&z=16&output=embed" 
                width="100%" 
                height="240" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade"
                title="Universidad Yachay Tech Campus Map (0.405614, -78.174637)"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3.5rem 0 4rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--color-cyan);
    margin-bottom: 0.5rem;
  }

  .banner-title {
    font-size: clamp(2.2rem, 3.8vw, 3rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.88);
    margin-top: 0.5rem;
    max-width: 800px;
    line-height: 1.6;
  }

  .contact-section {
    padding: 4.5rem 0 6rem;
    background-color: var(--color-bg-light);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
  }

  .contact-form-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2.5rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    transition: box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .contact-form-card.highlighted-form {
    border-color: var(--color-cyan);
    box-shadow: 0 0 20px rgba(5, 135, 189, 0.25);
  }

  .form-title {
    font-size: 1.5rem;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }

  .form-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-navy);
  }

  .required {
    color: #ef4444;
  }

  .form-control {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-sm);
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-control:focus {
    outline: none;
    border-color: var(--color-cyan);
    box-shadow: 0 0 0 3px rgba(5, 135, 189, 0.15);
  }

  .checkbox-group {
    flex-direction: row;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .checkbox-group input {
    margin-top: 0.25rem;
  }

  .checkbox-group label {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-weight: 400;
    line-height: 1.4;
  }

  .error-msg {
    display: none;
    color: #ef4444;
    font-size: 0.78rem;
    font-weight: 500;
  }

  .form-status {
    padding: 1rem;
    border-radius: var(--border-radius-sm);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .form-status.success {
    background-color: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  /* Info Column */
  .contact-info-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .info-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2.25rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
  }

  .volunteer-quick-card {
    background: linear-gradient(135deg, var(--color-navy) 0%, #153258 100%);
    color: #ffffff;
    border-color: var(--color-cyan);
  }

  .volunteer-quick-card .card-title {
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .quick-join-desc p {
    font-size: 0.88rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 0.5rem;
  }

  .quick-join-desc p:last-child {
    margin-bottom: 0;
  }

  .card-title {
    font-size: 1.2rem;
    color: var(--color-navy);
    margin-bottom: 1.5rem;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .info-list li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .info-icon {
    color: var(--color-cyan);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .info-list strong {
    display: block;
    font-size: 0.92rem;
    color: var(--color-navy);
    margin-bottom: 0.2rem;
  }

  .info-list p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin: 0;
  }

  .info-list a {
    color: var(--color-cyan);
    text-decoration: none;
    font-weight: 500;
  }

  .info-list a:hover {
    text-decoration: underline;
  }

  .map-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 1.5rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
  }

  .map-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .map-heading {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0;
    letter-spacing: 0.5px;
  }

  .map-external-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--color-cyan);
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .map-external-link:hover {
    color: var(--color-institutional-blue);
    text-decoration: underline;
  }

  .map-embed-wrapper {
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    background-color: #f0f4f8;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const topic = params.get('topic');
    const subjectSelect = document.getElementById('subject') as HTMLSelectElement | null;
    const formCard = document.getElementById('contact-form-card');
    const nameInput = document.getElementById('fullName');

    if (topic && subjectSelect) {
      if (topic === 'volunteer') {
        subjectSelect.value = 'volunteer';
      } else if (topic === 'membership') {
        subjectSelect.value = 'membership';
      }

      if (formCard) {
        formCard.classList.add('highlighted-form');
        formCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      if (nameInput) {
        setTimeout(() => {
          nameInput.focus();
        }, 500);
      }
    }
  });
</script>
