---
import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/config/site';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="Contacto | IEEE Nanotechnology Council Yachay Tech"
  description="Ponte en contacto con el Capítulo Estudiantil IEEE Nanotechnology Council en Yachay Tech University. Escríbenos, consulta sobre membresías o únete a nuestros semilleros."
>
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')} data-i18n-es="Inicio" data-i18n-en="Home">Inicio</a> &gt; <span data-i18n-es="Contacto" data-i18n-en="Contact">Contacto</span>
      </div>
      <h1 class="banner-title font-heading" data-i18n-es="CONTÁCTANOS" data-i18n-en="CONTACT US">CONTÁCTANOS</h1>
      <p class="banner-subtitle" data-i18n-es="¿Tienes preguntas sobre membresías IEEE NTC, talleres de laboratorio o colaboraciones de investigación? Estamos a tu disposición." data-i18n-en="Have questions about IEEE NTC memberships, laboratory workshops, or research collaborations? We are here to help.">¿Tienes preguntas sobre membresías IEEE NTC, talleres de laboratorio o colaboraciones de investigación? Estamos a tu disposición.</p>
    </div>
  </section>

  <section class="contact-section">
    <div class="site-container">
      <div class="contact-grid">
        <!-- Contact Form Column -->
        <div class="contact-form-card">
          <h2 class="form-title font-heading" data-i18n-es="ENVÍANOS UN MENSAJE" data-i18n-en="SEND US A MESSAGE">ENVÍANOS UN MENSAJE</h2>
          <p class="form-desc" data-i18n-es="Completa el siguiente formulario y nuestra junta directiva se pondrá en contacto contigo en un plazo de 24 a 48 horas." data-i18n-en="Fill out the form below and our executive board will get back to you within 24 to 48 hours.">Completa el siguiente formulario y nuestra junta directiva se pondrá en contacto contigo en un plazo de 24 a 48 horas.</p>

          <form id="contact-form" action="https://formspree.io/f/demo" method="POST" class="contact-form" novalidate>
            <!-- Honeypot Bot Field -->
            <div class="sr-only" aria-hidden="true">
              <label for="bot-field">No llenar este campo si eres humano:</label>
              <input type="text" id="bot-field" name="bot-field" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form-group">
              <label for="fullName"><span data-i18n-es="Nombre Completo" data-i18n-en="Full Name">Nombre Completo</span> <span class="required">*</span></label>
              <input type="text" id="fullName" name="name" required placeholder="Ej. María Gabriela Pérez" data-i18n-placeholder-es="Ej. María Gabriela Pérez" data-i18n-placeholder-en="e.g. Jane Doe" class="form-control" />
              <span class="error-msg" id="error-name" data-i18n-es="Por favor ingresa tu nombre completo." data-i18n-en="Please enter your full name.">Por favor ingresa tu nombre completo.</span>
            </div>

            <div class="form-group">
              <label for="email"><span data-i18n-es="Correo Institucional o Personal" data-i18n-en="Institutional or Personal Email">Correo Institucional o Personal</span> <span class="required">*</span></label>
              <input type="email" id="email" name="email" required placeholder="Ej. maria.perez@yachaytech.edu.ec" data-i18n-placeholder-es="Ej. maria.perez@yachaytech.edu.ec" data-i18n-placeholder-en="e.g. jane.doe@university.edu" class="form-control" />
              <span class="error-msg" id="error-email" data-i18n-es="Por favor ingresa un correo electrónico válido." data-i18n-en="Please enter a valid email address.">Por favor ingresa un correo electrónico válido.</span>
            </div>

            <div class="form-group">
              <label for="subject"><span data-i18n-es="Asunto" data-i18n-en="Subject">Asunto</span> <span class="required">*</span></label>
              <select id="subject" name="subject" required class="form-control">
                <option value="" data-i18n-es="Selecciona un tema..." data-i18n-en="Select a topic...">Selecciona un tema...</option>
                <option value="membership" data-i18n-es="Información y Membresía IEEE NTC" data-i18n-en="IEEE NTC Info & Membership">Información y Membresía IEEE NTC</option>
                <option value="lanano" data-i18n-es="Semillero de Investigación LANANO 2026" data-i18n-en="LANANO 2026 Research Incubator">Semillero de Investigación LANANO 2026</option>
                <option value="workshop" data-i18n-es="Inscripción a Talleres y Conferencias" data-i18n-en="Workshops & Conferences Registration">Inscripción a Talleres y Conferencias</option>
                <option value="outreach" data-i18n-es="Vinculación y Visitas a Colegios STEM" data-i18n-en="STEM Outreach & School Visits">Vinculación y Visitas a Colegios STEM</option>
                <option value="general" data-i18n-es="Consulta General / Soporte" data-i18n-en="General Inquiry / Support">Consulta General / Soporte</option>
              </select>
              <span class="error-msg" id="error-subject" data-i18n-es="Por favor selecciona un asunto." data-i18n-en="Please select a subject.">Por favor selecciona un asunto.</span>
            </div>

            <div class="form-group">
              <label for="message"><span data-i18n-es="Mensaje" data-i18n-en="Message">Mensaje</span> <span class="required">*</span></label>
              <textarea id="message" name="message" rows="5" required placeholder="Escribe los detalles de tu consulta..." data-i18n-placeholder-es="Escribe los detalles de tu consulta..." data-i18n-placeholder-en="Write the details of your inquiry..." class="form-control"></textarea>
              <span class="error-msg" id="error-message" data-i18n-es="Por favor escribe tu mensaje." data-i18n-en="Please write your message.">Por favor escribe tu mensaje.</span>
            </div>

            <div class="form-group checkbox-group">
              <input type="checkbox" id="privacyConsent" name="privacyConsent" required />
              <label for="privacyConsent" data-i18n-es="Acepto que IEEE NTC Yachay Tech procese mis datos de contacto para responder a mi solicitud." data-i18n-en="I agree that IEEE NTC Yachay Tech may process my contact details to reply to my request.">Acepto que IEEE NTC Yachay Tech procese mis datos de contacto para responder a mi solicitud.</label>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
              <span data-i18n-es="ENVIAR MENSAJE" data-i18n-en="SEND MESSAGE">ENVIAR MENSAJE</span>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
            </button>

            <!-- Success Alert Banner -->
            <div class="form-status success" id="form-status-success" style="display: none;" role="alert" data-i18n-html-es="<strong>¡Mensaje Enviado con Éxito!</strong> Gracias por comunicarte con IEEE NTC Yachay Tech. Te responderemos a la brevedad." data-i18n-html-en="<strong>Message Sent Successfully!</strong> Thank you for reaching out to IEEE NTC Yachay Tech. We will reply shortly.">
              <strong>¡Mensaje Enviado con Éxito!</strong> Gracias por comunicarte con IEEE NTC Yachay Tech. Te responderemos a la brevedad.
            </div>
          </form>
        </div>

        <!-- Location & Contact Info Column -->
        <div class="contact-info-column">
          <div class="info-card">
            <h2 class="card-title font-heading" data-i18n-es="SEDE INSTITUCIONAL Y UBICACIÓN" data-i18n-en="INSTITUTIONAL HEADQUARTERS">SEDE INSTITUCIONAL Y UBICACIÓN</h2>
            
            <ul class="info-list">
              <li>
                <div class="info-icon">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                </div>
                <div>
                  <strong>Campus {siteConfig.location.institution}</strong>
                  <p>Hacienda San José, {siteConfig.location.city}<br>Imbabura, {siteConfig.location.country}</p>
                </div>
              </li>

              <li>
                <div class="info-icon">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                </div>
                <div>
                  <strong data-i18n-es="Correo Oficial" data-i18n-en="Official Email">Correo Oficial</strong>
                  <p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
                </div>
              </li>

              <li>
                <div class="info-icon">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                </div>
                <div>
                  <strong>LinkedIn</strong>
                  <p><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">IEEE NTC Yachay Tech</a></p>
                </div>
              </li>

              <li>
                <div class="info-icon">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </div>
                <div>
                  <strong>Instagram</strong>
                  <p><a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer">@ntc.yachaytech</a></p>
                </div>
              </li>
            </ul>
          </div>

          <!-- Interactive Google Maps Frame -->
          <div class="map-card">
            <h3 class="map-heading" data-i18n-es="MAPA DEL CAMPUS YACHAY TECH" data-i18n-en="YACHAY TECH CAMPUS MAP">MAPA DEL CAMPUS YACHAY TECH</h3>
            <div class="map-embed-wrapper">
              <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15959.056122606558!2d-78.1884067!3d0.4285871!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e2a39281dd61d0d%3A0xa19fbc7c014798e6!2sUniversidad%20Yachay%20Tech!5e0!3m2!1sen!2sec!4v1700000000000!5m2!1sen!2sec" 
                width="100%" 
                height="220" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade"
                title="Mapa de ubicación de Yachay Tech University"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
    max-width: 760px;
  }

  .contact-section {
    padding: 4.5rem 0;
    background-color: var(--color-bg-light);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
  }

  .contact-form-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2.5rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
  }

  .form-title {
    font-size: 1.5rem;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }

  .form-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-navy);
  }

  .required {
    color: #ef4444;
  }

  .form-control {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-sm);
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-control:focus {
    outline: none;
    border-color: var(--color-cyan);
    box-shadow: 0 0 0 3px rgba(5, 135, 189, 0.15);
  }

  .checkbox-group {
    flex-direction: row;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .checkbox-group input {
    margin-top: 0.25rem;
  }

  .checkbox-group label {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-weight: 400;
    line-height: 1.4;
  }

  .error-msg {
    display: none;
    color: #ef4444;
    font-size: 0.78rem;
    font-weight: 500;
  }

  .form-status {
    padding: 1rem;
    border-radius: var(--border-radius-sm);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .form-status.success {
    background-color: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  /* Info Column */
  .contact-info-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .info-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2.25rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
  }

  .card-title {
    font-size: 1.2rem;
    color: var(--color-navy);
    margin-bottom: 1.5rem;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .info-list li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .info-icon {
    color: var(--color-cyan);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .info-list strong {
    display: block;
    font-size: 0.92rem;
    color: var(--color-navy);
    margin-bottom: 0.2rem;
  }

  .info-list p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin: 0;
  }

  .info-list a {
    color: var(--color-cyan);
    text-decoration: none;
    font-weight: 500;
  }

  .info-list a:hover {
    text-decoration: underline;
  }

  .map-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 1.5rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
  }

  .map-heading {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
    letter-spacing: 0.5px;
  }

  .map-embed-wrapper {
    border-radius: var(--border-radius-sm);
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
