---
import Layout from '@/layouts/Layout.astro';
import { OPPORTUNITIES_DATA } from '@/data/opportunities';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

const categories = ['Todas', 'Becas de Viaje', 'Programas IEEE', 'Voluntariado'];
---

<Layout 
  title="Oportunidades | IEEE Nanotechnology Council Yachay Tech"
  description="Explora becas de viaje, convocatorias de voluntariado, fondos de investigación y programas de desarrollo profesional de IEEE."
>
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Inicio</a> &gt; <span>Oportunidades</span>
      </div>
      <span class="banner-eyebrow">DESARROLLO ESTUDIANTIL</span>
      <h1 class="banner-title font-heading">OPORTUNIDADES Y CONVOCATORIAS</h1>
      <p class="banner-subtitle">
        Explora becas de viaje, subvenciones para conferencias, voluntariado en comités y programas internacionales de desarrollo académico.
      </p>
    </div>
  </section>

  <section class="opps-section">
    <div class="site-container">
      <!-- Category Filter Pills -->
      <div class="filter-pills-bar">
        {categories.map((cat, idx) => (
          <button 
            class={`filter-pill ${idx === 0 ? 'active' : ''}`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Opportunities Grid -->
      <div class="opps-grid" id="opportunities-grid">
        {OPPORTUNITIES_DATA.map((opp) => (
          <article class="opp-card" data-cat={opp.category} id={opp.id}>
            <div class="opp-header">
              <span class="opp-cat">{opp.category}</span>
              <span class={`opp-status ${opp.status.toLowerCase()}`}>{opp.status}</span>
            </div>

            <div class="opp-body">
              <h2 class="opp-title">{opp.title}</h2>
              <p class="opp-institution">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/></svg>
                {opp.institution}
              </p>
              <p class="opp-summary">{opp.description}</p>

              <div class="opp-meta-row">
                <span class="meta-deadline">
                  <strong>Fecha Límite:</strong> {opp.deadline}
                </span>
                <span class="meta-modality">{opp.modality}</span>
              </div>

              <div class="opp-footer">
                <a href={opp.officialUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
                  POSTULAR / MÁS INFORMACIÓN
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Chapter CTA Box -->
      <div class="opportunities-cta-box">
        <div class="cta-info">
          <h3>¿BUSCAS MÁS OPORTUNIDADES PARA ESTUDIANTES IEEE?</h3>
          <p>Contacta a los directivos del capítulo para recibir asesoría sobre becas de viaje IEEE, postulación de artículos y fondos concursables.</p>
        </div>
        <a href={getHref('/contact/')} class="btn btn-primary">
          CONTACTAR A LA DIRECTIVA
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--color-cyan);
    margin-bottom: 0.5rem;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
    max-width: 720px;
  }

  .opps-section {
    padding: 3.5rem 0 5rem;
    background-color: var(--color-bg-light);
  }

  .filter-pills-bar {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    padding: 0.5rem 1.25rem;
    border-radius: 20px;
    background-color: var(--color-white);
    color: var(--color-navy);
    border: 1px solid var(--color-border-light);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-pill:hover,
  .filter-pill.active {
    background-color: var(--color-cyan);
    color: var(--color-white);
    border-color: var(--color-cyan);
  }

  .opps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 3.5rem;
  }

  .opp-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .opp-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .opp-header {
    background-color: var(--color-navy);
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .opp-cat {
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .opp-status {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    text-transform: uppercase;
  }

  .opp-status.abierta {
    background-color: rgba(16, 185, 129, 0.2);
    color: #10B981;
    border: 1px solid #10B981;
  }

  .opp-status.próximamente {
    background-color: rgba(245, 158, 11, 0.2);
    color: #F59E0B;
    border: 1px solid #F59E0B;
  }

  .opp-status.cerrada {
    background-color: rgba(239, 68, 68, 0.2);
    color: #EF4444;
    border: 1px solid #EF4444;
  }

  .opp-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .opp-title {
    font-size: 1.15rem;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }

  .opp-institution {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--color-cyan);
    font-weight: 600;
    margin-bottom: 0.85rem;
  }

  .opp-summary {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .opp-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    margin-bottom: 1rem;
  }

  .meta-modality {
    background-color: var(--color-bg-alt);
    color: var(--color-navy);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .opp-footer {
    display: flex;
    justify-content: flex-end;
  }

  /* Chapter CTA Box */
  .opportunities-cta-box {
    background: linear-gradient(135deg, var(--color-navy) 0%, #152A47 100%);
    color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border: 2px solid var(--color-cyan);
  }

  .cta-info h3 {
    font-size: 1.25rem;
    color: var(--color-white);
    margin-bottom: 0.5rem;
  }

  .cta-info p {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 900px) {
    .opps-grid {
      grid-template-columns: 1fr;
    }

    .opportunities-cta-box {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.opp-card');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        const cat = pill.getAttribute('data-category');

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-cat');
          if (cat === 'Todas' || cardCat === cat) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>
