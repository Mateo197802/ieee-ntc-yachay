---
import Layout from '@/layouts/Layout.astro';
import { OPPORTUNITIES_DATA } from '@/data/opportunities';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

const categories = ['All', 'Conferences', 'Competitions', 'Training', 'Volunteer', 'Leadership', 'Travel Grants'];
---

<Layout 
  title="Opportunities | IEEE Nanotechnology Council Yachay Tech"
  description="Explore international conferences, student design competitions, training programs, volunteering calls, chapter leadership, and travel reimbursement policies from IEEE NTC."
>
  <!-- Hero Inner Banner -->
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <span>Opportunities</span>
      </div>
      <span class="banner-eyebrow">GLOBAL ACADEMIC & RESEARCH HORIZONS</span>
      <h1 class="banner-title font-heading">OPPORTUNITIES & CALLS</h1>
      <p class="banner-subtitle">
        Connect with international conferences, design competitions, summer internships, specialized seasonal schools, and global leadership committees under the IEEE Nanotechnology Council.
      </p>
    </div>
  </section>

  <!-- Main Opportunities Section -->
  <section class="opps-section">
    <div class="site-container">
      <!-- Category Filter Pills Bar -->
      <div class="filter-pills-bar" role="tablist" aria-label="Opportunity Categories">
        {categories.map((cat, idx) => (
          <button 
            class={`filter-pill ${idx === 0 ? 'active' : ''}`}
            data-category={cat}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Opportunities Dynamic Grid -->
      <div class="opps-grid" id="opportunities-grid">
        {OPPORTUNITIES_DATA.map((opp) => (
          <article class="opp-card" data-cat={opp.category} id={opp.id}>
            <div class="opp-header">
              <div class="opp-header-tags">
                <span class="opp-cat">{opp.category}</span>
                <span class="opp-modality">{opp.modality}</span>
              </div>
              <span class={`opp-status ${opp.status.toLowerCase()}`}>{opp.status}</span>
            </div>

            <div class="opp-body">
              <h2 class="opp-title">{opp.title}</h2>
              
              <div class="opp-org-row">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/></svg>
                <span>{opp.institution}</span>
              </div>

              <p class="opp-summary">{opp.description}</p>

              <div class="opp-details-box">
                <div class="detail-item">
                  <strong class="detail-label">Location:</strong>
                  <span class="detail-val">{opp.location}</span>
                </div>
                {opp.dates && (
                  <div class="detail-item">
                    <strong class="detail-label">Event Dates:</strong>
                    <span class="detail-val">{opp.dates}</span>
                  </div>
                )}
                <div class="detail-item">
                  <strong class="detail-label">Deadline / Term:</strong>
                  <span class="detail-val highlight-val">{opp.deadline}</span>
                </div>
                <div class="detail-item">
                  <strong class="detail-label">Target Audience:</strong>
                  <span class="detail-val">{opp.targetAudience}</span>
                </div>
              </div>

              {opp.benefits && opp.benefits.length > 0 && (
                <div class="opp-benefits-list">
                  <strong class="benefits-title">Key Highlights:</strong>
                  <ul>
                    {opp.benefits.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="opp-footer">
                <a href={opp.officialUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-block">
                  <span>OFFICIAL PORTAL & APPLICATION</span>
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Prominent "JOIN THE CHAPTER" Section -->
      <section class="join-chapter-section" id="join-us">
        <div class="join-chapter-header text-center">
          <span class="section-eyebrow">GET INVOLVED</span>
          <h2 class="join-title font-heading">JOIN THE CHAPTER</h2>
          <p class="join-subtitle">
            Do you want to learn, research, and connect with the nanotechnology community? Discover how you can participate and make an impact.
          </p>
        </div>

        <div class="join-cards-grid">
          <!-- Pathway 1: Volunteer -->
          <div class="join-path-card">
            <div class="path-icon-box">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
            </div>
            <h3 class="path-title">BECOME A VOLUNTEER</h3>
            <p class="path-desc">
              Join our dynamic team to collaborate on hands-on workshops, high school outreach, hospital visits, and scientific events. 
              <strong>No paid IEEE membership is required</strong> to volunteer and collaborate with our team. However, registered members receive priority registration and preferential access to exclusive technical programs.
            </p>
            <div class="path-action">
              <a href={getHref('/contact/?topic=volunteer#contact-form')} class="btn btn-primary path-btn">
                <span>BECOME A VOLUNTEER &rarr;</span>
              </a>
            </div>
          </div>

          <!-- Pathway 2: Official IEEE Membership -->
          <div class="join-path-card featured-path">
            <div class="path-badge">RECOMMENDED FOR RESEARCHERS</div>
            <div class="path-icon-box">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            </div>
            <h3 class="path-title">IEEE & NTC MEMBERSHIP</h3>
            <p class="path-desc">
              Unlock the full power of global IEEE membership. Gain direct access to IEEE Xplore digital library discounts, student travel grants, conference discounts (IEEE-NANO, LANANO), and eligibility for official chapter executive leadership roles.
            </p>
            <div class="path-action dual-btn-row">
              <button class="btn btn-primary open-opps-membership-modal-btn path-btn">
                <span>MEMBERSHIP GUIDE &rarr;</span>
              </button>
              <a href="https://www.ieee.org/membership/join/index.html" target="_blank" rel="noopener noreferrer" class="btn btn-outline-light path-btn">
                <span>JOIN ON IEEE.ORG ↗</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </section>

  <!-- Interactive Modal for IEEE Membership Step-by-Step Guide -->
  <dialog id="opps-membership-guide-modal" class="membership-modal-dialog">
    <div class="membership-modal-inner">
      <button class="membership-modal-close" id="opps-membership-modal-close-btn" aria-label="Close guide">&times;</button>
      
      <div class="modal-badge-top">OFFICIAL IEEE ONBOARDING</div>
      <h2 class="guide-modal-title font-heading">HOW TO OBTAIN YOUR IEEE & NTC MEMBERSHIP</h2>
      <p class="guide-modal-subtitle">
        Follow these 3 simple steps to access international IEEE privileges, digital libraries, and student grant opportunities.
      </p>

      <div class="guide-steps-list">
        <div class="step-card">
          <div class="step-number-box">1</div>
          <div class="step-content">
            <h4>Create Account on IEEE.org</h4>
            <p>
              Visit <a href="https://www.ieee.org/membership/join/index.html" target="_blank" rel="noopener noreferrer">ieee.org/join</a>. Select <strong>Student Membership</strong> and use your university email address to receive subsidized student regional fees (Region 9).
            </p>
          </div>
        </div>

        <div class="step-card">
          <div class="step-number-box">2</div>
          <div class="step-content">
            <h4>Add the Nanotechnology Council (NTC)</h4>
            <p>
              In the society and council selection section, check the <strong>IEEE Nanotechnology Council (NTC)</strong> to receive society publications, conference discounts, and seasonal school access.
            </p>
          </div>
        </div>

        <div class="step-card">
          <div class="step-number-box">3</div>
          <div class="step-content">
            <h4>Notify IEEE NTC Yachay Tech Secretariat</h4>
            <p>
              Once you receive your 8-digit IEEE Member Number, send it to us via our contact form or official email so we can formally register your local branch affiliation and invite you to our executive committees.
            </p>
          </div>
        </div>
      </div>

      <div class="guide-modal-actions">
        <a href="https://www.ieee.org/membership/join/index.html" target="_blank" rel="noopener noreferrer" class="btn btn-primary modal-action-btn">
          <span>GO TO IEEE.ORG JOIN PORTAL ↗</span>
        </a>
        <a href={getHref('/contact/?topic=membership#contact-form')} class="btn btn-outline-dark modal-action-btn">
          <span>CONTACT OUR SECRETARIAT &rarr;</span>
        </a>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3.5rem 0 4rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--color-cyan);
    margin-bottom: 0.5rem;
  }

  .banner-title {
    font-size: clamp(2.2rem, 3.8vw, 3rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.88);
    margin-top: 0.5rem;
    max-width: 820px;
    line-height: 1.6;
  }

  .opps-section {
    padding: 4.5rem 0 6rem;
    background-color: var(--color-bg-light);
  }

  /* Filter Pills */
  .filter-pills-bar {
    display: flex;
    gap: 0.65rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    padding: 0.5rem 1.35rem;
    border-radius: 25px;
    background-color: var(--color-white);
    color: var(--color-navy);
    border: 1px solid var(--color-border-light);
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover {
    background-color: var(--color-bg-alt);
    border-color: var(--color-cyan);
    color: var(--color-cyan);
  }

  .filter-pill.active {
    background-color: var(--color-cyan);
    color: var(--color-white);
    border-color: var(--color-cyan);
    box-shadow: 0 4px 12px rgba(5, 135, 189, 0.3);
  }

  /* Opportunities Grid */
  .opps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.25rem;
  }

  .opp-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .opp-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-cyan);
  }

  .opp-header {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-deep-blue) 100%);
    padding: 1.1rem 1.6rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .opp-header-tags {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .opp-cat {
    color: var(--color-cyan);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }

  .opp-modality {
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .opp-status {
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .opp-status.open {
    background-color: rgba(16, 185, 129, 0.2);
    color: #10B981;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  .opp-status.upcoming {
    background-color: rgba(245, 158, 11, 0.2);
    color: #F59E0B;
    border: 1px solid rgba(245, 158, 11, 0.4);
  }

  .opp-status.continuous {
    background-color: rgba(5, 135, 189, 0.25);
    color: var(--color-cyan);
    border: 1px solid var(--color-cyan);
  }

  .opp-body {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .opp-title {
    font-size: 1.3rem;
    color: var(--color-navy);
    margin-bottom: 0.6rem;
    line-height: 1.35;
  }

  .opp-org-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-cyan);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .opp-summary {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1.4rem;
  }

  .opp-details-box {
    background-color: var(--color-bg-light);
    border-radius: var(--border-radius-sm);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    border: 1px solid var(--color-border-light);
    margin-bottom: 1.4rem;
  }

  .detail-item {
    display: flex;
    font-size: 0.85rem;
    gap: 0.5rem;
    align-items: baseline;
  }

  .detail-label {
    color: var(--color-navy);
    font-weight: 700;
    min-width: 125px;
    flex-shrink: 0;
  }

  .detail-val {
    color: var(--color-text-dark);
  }

  .detail-val.highlight-val {
    color: var(--color-institutional-blue);
    font-weight: 700;
  }

  .opp-benefits-list {
    margin-bottom: 1.75rem;
  }

  .benefits-title {
    font-size: 0.82rem;
    color: var(--color-navy);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 0.4rem;
  }

  .opp-benefits-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .opp-benefits-list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.84rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .opp-benefits-list li::before {
    content: "•";
    color: var(--color-cyan);
    font-weight: bold;
    position: absolute;
    left: 0;
  }

  .opp-footer {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-light);
  }

  /* Join the Chapter Section */
  .join-chapter-section {
    margin-top: 5.5rem;
    padding-top: 4rem;
    border-top: 2px dashed var(--color-border-light);
  }

  .join-title {
    font-size: 2.2rem;
    color: var(--color-navy);
    margin: 0.25rem 0 0.5rem;
  }

  .join-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 680px;
    margin: 0 auto 3rem;
  }

  .join-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .join-path-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2.75rem 2.25rem;
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-subtle);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .join-path-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
  }

  .join-path-card.featured-path {
    background: linear-gradient(135deg, var(--color-navy) 0%, #15345b 100%);
    color: #ffffff;
    border-color: var(--color-cyan);
  }

  .path-badge {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    background-color: var(--color-cyan);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 20px;
    letter-spacing: 0.5px;
  }

  .path-icon-box {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: rgba(5, 135, 189, 0.12);
    color: var(--color-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .featured-path .path-icon-box {
    background-color: rgba(255, 255, 255, 0.15);
    color: var(--color-white);
  }

  .path-title {
    font-size: 1.35rem;
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  .featured-path .path-title {
    color: #ffffff;
  }

  .path-desc {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .featured-path .path-desc {
    color: rgba(255, 255, 255, 0.88);
  }

  .dual-btn-row {
    display: flex;
    gap: 0.75rem;
    margin-top: auto;
    flex-wrap: wrap;
  }

  .dual-btn-row .btn {
    flex: 1;
    min-width: 150px;
  }

  .path-action {
    margin-top: auto;
  }

  .path-btn {
    font-size: 0.88rem;
    padding: 0.75rem 1rem;
  }

  /* Membership Step-by-Step Modal Dialog */
  .membership-modal-dialog {
    border: none;
    padding: 0;
    background: transparent;
  }

  .membership-modal-inner {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 2.5rem;
    position: relative;
    border-top: 4px solid var(--color-cyan);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    width: 100%;
    max-width: 680px;
  }

  .membership-modal-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: none;
    border: none;
    font-size: 1.85rem;
    color: var(--color-navy);
    cursor: pointer;
    line-height: 1;
  }

  .modal-badge-top {
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 0.4rem;
  }

  .guide-modal-title {
    font-size: 1.5rem;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
    line-height: 1.25;
  }

  .guide-modal-subtitle {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .guide-steps-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .step-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background-color: var(--color-bg-light);
    border-radius: var(--border-radius-sm);
    padding: 1.25rem;
    border: 1px solid var(--color-border-light);
  }

  .step-number-box {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--color-navy);
    color: var(--color-cyan);
    font-family: var(--font-heading);
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-content h4 {
    font-size: 1rem;
    color: var(--color-navy);
    margin-bottom: 0.35rem;
  }

  .step-content p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .step-content a {
    color: var(--color-cyan);
    font-weight: 700;
    text-decoration: underline;
  }

  .guide-modal-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .modal-action-btn {
    flex: 1;
    text-align: center;
    font-size: 0.88rem;
    padding: 0.75rem 1rem;
  }

  @media (max-width: 1080px) {
    .opps-grid,
    .join-cards-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .guide-modal-actions {
      flex-direction: column;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Category pills filter
    const pills = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.opp-card');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => {
          p.classList.remove('active');
          p.setAttribute('aria-selected', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-selected', 'true');

        const cat = pill.getAttribute('data-category') || 'All';

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-cat') || '';
          if (cat === 'All' || cardCat === cat) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Membership Modal
    const modal = document.getElementById('opps-membership-guide-modal') as HTMLDialogElement | null;
    const openBtns = document.querySelectorAll('.open-opps-membership-modal-btn');
    const closeBtn = document.getElementById('opps-membership-modal-close-btn');

    openBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        modal?.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => {
      modal?.close();
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  });
</script>
