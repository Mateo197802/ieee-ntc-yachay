---
import Layout from '@/layouts/Layout.astro';
import { OPPORTUNITIES_DATA } from '@/data/opportunities';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

const categories = [
  { es: 'Todas', en: 'All' },
  { es: 'Becas de Viaje', en: 'Travel Grants' },
  { es: 'Programas IEEE', en: 'IEEE Programs' },
  { es: 'Voluntariado', en: 'Volunteering' }
];
---

<Layout 
  title="Oportunidades | IEEE Nanotechnology Council Yachay Tech"
  description="Explora becas de viaje, convocatorias de voluntariado, fondos de investigación y programas de desarrollo profesional de IEEE."
>
  <section class="inner-banner">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')} data-i18n-es="Inicio" data-i18n-en="Home">Inicio</a> &gt; <span data-i18n-es="Oportunidades" data-i18n-en="Opportunities">Oportunidades</span>
      </div>
      <span class="banner-eyebrow" data-i18n-es="DESARROLLO ESTUDIANTIL" data-i18n-en="STUDENT DEVELOPMENT">DESARROLLO ESTUDIANTIL</span>
      <h1 class="banner-title font-heading" data-i18n-es="OPORTUNIDADES Y CONVOCATORIAS" data-i18n-en="OPPORTUNITIES & CALLS">OPORTUNIDADES Y CONVOCATORIAS</h1>
      <p class="banner-subtitle" data-i18n-es="Explora becas de viaje, subvenciones para conferencias, voluntariado en comités y programas internacionales de desarrollo académico." data-i18n-en="Explore travel grants, conference sponsorships, committee volunteering, and international academic development programs.">
        Explora becas de viaje, subvenciones para conferencias, voluntariado en comités y programas internacionales de desarrollo académico.
      </p>
    </div>
  </section>

  <section class="opps-section">
    <div class="site-container">
      <!-- Category Filter Pills -->
      <div class="filter-pills-bar">
        {categories.map((cat, idx) => (
          <button 
            class={`filter-pill ${idx === 0 ? 'active' : ''}`}
            data-category={cat.es}
            data-i18n-es={cat.es}
            data-i18n-en={cat.en}
          >
            {cat.es}
          </button>
        ))}
      </div>

      <!-- Opportunities Grid -->
      <div class="opps-grid" id="opportunities-grid">
        {OPPORTUNITIES_DATA.map((opp) => (
          <article class="opp-card" data-cat={opp.category} id={opp.id}>
            <div class="opp-header">
              <span class="opp-cat" data-i18n-es={opp.category} data-i18n-en={opp.categoryEn}>{opp.category}</span>
              <span class={`opp-status ${opp.status.toLowerCase()}`} data-i18n-es={opp.status} data-i18n-en={opp.statusEn}>{opp.status}</span>
            </div>

            <div class="opp-body">
              <h2 class="opp-title" data-i18n-es={opp.title} data-i18n-en={opp.titleEn}>{opp.title}</h2>
              <p class="opp-institution">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/></svg>
                <span data-i18n-es={opp.institution} data-i18n-en={opp.institutionEn}>{opp.institution}</span>
              </p>
              <p class="opp-summary" data-i18n-es={opp.description} data-i18n-en={opp.descriptionEn}>{opp.description}</p>

              <div class="opp-meta-row">
                <span class="meta-deadline">
                  <strong data-i18n-es="Fecha Límite:" data-i18n-en="Deadline:">Fecha Límite:</strong> <span data-i18n-es={opp.deadline} data-i18n-en={opp.deadlineEn}>{opp.deadline}</span>
                </span>
                <span class="meta-modality" data-i18n-es={opp.modality} data-i18n-en={opp.modalityEn}>{opp.modality}</span>
              </div>

              <div class="opp-footer">
                <a href={opp.officialUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm" data-i18n-es="POSTULAR / MÁS INFORMACIÓN" data-i18n-en="APPLY / MORE INFO">
                  POSTULAR / MÁS INFORMACIÓN
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Chapter CTA Box -->
      <div class="opportunities-cta-box">
        <div class="cta-info">
          <h3 data-i18n-es="¿BUSCAS MÁS OPORTUNIDADES PARA ESTUDIANTES IEEE?" data-i18n-en="LOOKING FOR MORE IEEE STUDENT OPPORTUNITIES?">¿BUSCAS MÁS OPORTUNIDADES PARA ESTUDIANTES IEEE?</h3>
          <p data-i18n-es="Contacta a los directivos del capítulo para recibir asesoría sobre becas de viaje IEEE, postulación de artículos y fondos concursables." data-i18n-en="Contact chapter officers for guidance on IEEE travel grants, paper submissions, and competitive activity funds.">Contacta a los directivos del capítulo para recibir asesoría sobre becas de viaje IEEE, postulación de artículos y fondos concursables.</p>
        </div>
        <a href={getHref('/contact/')} class="btn btn-primary" data-i18n-es="CONTACTAR A LA DIRECTIVA" data-i18n-en="CONTACT DIRECTIVE">
          CONTACTAR A LA DIRECTIVA
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-banner {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3rem 0 3.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .banner-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--color-cyan);
    margin-bottom: 0.5rem;
  }

  .banner-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-white);
  }

  .banner-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.5rem;
    max-width: 760px;
  }

  .opps-section {
    padding: 4.5rem 0;
    background-color: var(--color-bg-light);
  }

  .filter-pills-bar {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    padding: 0.45rem 1.25rem;
    border-radius: 20px;
    background-color: var(--color-white);
    color: var(--color-navy);
    border: 1px solid var(--color-border-light);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-pill:hover,
  .filter-pill.active {
    background-color: var(--color-cyan);
    color: var(--color-white);
    border-color: var(--color-cyan);
  }

  .opps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .opp-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .opp-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .opp-header {
    background-color: var(--color-navy);
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .opp-cat {
    color: var(--color-cyan);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .opp-status {
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .opp-status.abierta, .opp-status.open {
    background-color: rgba(16, 185, 129, 0.2);
    color: #10B981;
  }

  .opp-status.próximamente, .opp-status.upcoming {
    background-color: rgba(245, 158, 11, 0.2);
    color: #F59E0B;
  }

  .opp-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .opp-title {
    font-size: 1.25rem;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .opp-institution {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-cyan);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .opp-summary {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 1.5rem;
  }

  .opp-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-light);
    margin-bottom: 1.25rem;
    margin-top: auto;
    font-size: 0.85rem;
  }

  .meta-deadline {
    color: var(--color-navy);
  }

  .meta-modality {
    background-color: var(--color-bg-light);
    color: var(--color-navy);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .opp-footer {
    display: flex;
    justify-content: flex-end;
  }

  .opportunities-cta-box {
    margin-top: 3.5rem;
    background: linear-gradient(135deg, var(--color-navy) 0%, #0c2545 100%);
    border-radius: 12px;
    padding: 2.5rem 3rem;
    color: #ffffff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    border: 1px solid var(--color-cyan);
  }

  .cta-info h3 {
    font-size: 1.35rem;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .cta-info p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .opps-grid {
      grid-template-columns: 1fr;
    }
    .opportunities-cta-box {
      flex-direction: column;
      text-align: center;
      padding: 2rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.opp-card');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        const cat = pill.getAttribute('data-category') || 'Todas';

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-cat') || '';
          if (cat === 'Todas' || cat === 'All' || cardCat === cat) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>
