---
import Layout from '@/layouts/Layout.astro';
import { NANONEWS_ISSUES } from '@/data/nanonews';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}
---

<Layout 
  title="NanoNews Bulletin | IEEE Nanotechnology Council Yachay Tech"
  description="Explore our periodic visual publications, chapter onboarding roadmaps, and high-impact scientific writing guides. Read full multi-page visual documents."
  currentPath="/nanonews/"
>
  <!-- Inner Page Banner -->
  <section class="nanonews-hero">
    <div class="site-container">
      <div class="breadcrumb">
        <a href={getHref('/')}>Home</a> &gt; <a href={getHref('/gallery/')}>Media</a> &gt; <span>NanoNews</span>
      </div>
      <span class="hero-eyebrow">EDITORIAL SERIES & SCIENTIFIC INFOGRAPHICS</span>
      <h1 class="hero-title font-heading">NANONEWS BULLETIN</h1>
      <p class="hero-subtitle">
        Explore our periodic visual publications, chapter onboarding roadmaps, and high-impact scientific writing guides. Click any edition to read the full multi-page visual document.
      </p>
    </div>
  </section>

  <!-- NanoNews Grid Section -->
  <section class="nanonews-main-section">
    <div class="site-container">
      <div class="nanonews-grid">
        {NANONEWS_ISSUES.map((issue) => (
          <div class="nanonews-card-container">
            <button 
              class="nanonews-stacked-trigger open-nanonews-btn" 
              data-issue={JSON.stringify(issue)}
              aria-label={`Open full reader for ${issue.title}`}
            >
              <!-- 3D Stacked Deck Layers -->
              <div class="stacked-deck">
                <div class="deck-layer deck-layer-3" aria-hidden="true"></div>
                <div class="deck-layer deck-layer-2" aria-hidden="true"></div>
                <div class="deck-layer deck-layer-1">
                  <img 
                    src={getHref(issue.coverImage)} 
                    alt={issue.title} 
                    width="380" 
                    height="480" 
                    loading="lazy" 
                    class="nanonews-cover-img" 
                  />
                  <div class="cover-glow-overlay"></div>
                  <span class="issue-badge">EDITION #{issue.issueNumber}</span>
                  <span class="pages-badge">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
                    {issue.totalPages} Pages
                  </span>
                  <div class="expand-prompt">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                    <span>CLICK TO READ ISSUE</span>
                  </div>
                </div>
              </div>

              <!-- Content Summary Box -->
              <div class="nanonews-info-box">
                <h2 class="nanonews-title">{issue.title}</h2>
                <span class="nanonews-subtitle">{issue.subtitle}</span>
                <p class="nanonews-summary">{issue.summary}</p>
                <div class="nanonews-topics">
                  {issue.topics.map((t) => (
                    <span class="topic-tag">{t}</span>
                  ))}
                </div>
                <div class="read-action-bar">
                  <span class="read-btn-label">OPEN FULL DOCUMENT ({issue.totalPages} PAGES) &rarr;</span>
                </div>
              </div>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive NanoNews Reader Modal Dialog -->
  <dialog id="nanonews-modal" class="nanonews-modal-dialog">
    <div class="nanonews-modal-inner">
      <button class="nanonews-modal-close" id="nanonews-close-btn" aria-label="Close reader">&times;</button>
      
      <div class="nanonews-modal-header">
        <div class="modal-header-meta">
          <span class="modal-badge-issue" id="reader-issue-badge">EDITION #1</span>
          <span class="modal-counter-badge" id="reader-page-counter">Page 1 of 6</span>
        </div>
        <h2 class="nanonews-modal-title" id="reader-title-display">NanoNews Title</h2>
        <p class="nanonews-modal-subtitle" id="reader-subtitle-display">Subtitle description</p>
      </div>

      <!-- Main Document Viewer Viewport -->
      <div class="nanonews-viewer-stage">
        <button class="viewer-nav-btn prev-btn" id="reader-prev-btn" aria-label="Previous page">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        </button>

        <div class="viewer-page-wrapper">
          <img id="reader-page-img" src="" alt="NanoNews Page View" class="reader-current-img" />
        </div>

        <button class="viewer-nav-btn next-btn" id="reader-next-btn" aria-label="Next page">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
      </div>

      <!-- Bottom Thumbnail Selector Bar -->
      <div class="nanonews-thumb-strip" id="reader-thumb-strip">
        <!-- Thumbnails rendered dynamically via Javascript -->
      </div>

      <div class="reader-footer-hint">
        <span>Use lateral arrows or keyboard &larr; / &rarr; to flip through pages</span>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  /* Hero Banner */
  .nanonews-hero {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 60%, #152A47 100%);
    color: var(--color-white);
    padding: 3.5rem 0 4rem;
    border-bottom: 3px solid var(--color-cyan);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-cyan);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--color-cyan);
    margin-bottom: 0.5rem;
  }

  .hero-title {
    font-size: clamp(2.2rem, 3.8vw, 3rem);
    color: var(--color-white);
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.88);
    margin-top: 0.5rem;
    max-width: 820px;
    line-height: 1.6;
  }

  /* Main Section */
  .nanonews-main-section {
    padding: 4.5rem 0;
    background-color: var(--color-bg-light);
  }

  .nanonews-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
  }

  .nanonews-card-container {
    perspective: 1000px;
  }

  .nanonews-stacked-trigger {
    background: var(--color-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-md);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    width: 100%;
    text-align: left;
    cursor: pointer;
    box-shadow: var(--shadow-subtle);
    transition: all var(--transition-normal);
  }

  .nanonews-stacked-trigger:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-cyan);
  }

  /* 3D Stacked Deck Visual Effect */
  .stacked-deck {
    position: relative;
    width: 100%;
    height: 440px;
    margin-bottom: 1.75rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .deck-layer {
    position: absolute;
    width: 85%;
    height: 94%;
    border-radius: var(--border-radius-sm);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    transition: all var(--transition-normal);
  }

  .deck-layer-3 {
    background-color: #0c2340;
    transform: rotate(-5deg) translateY(12px);
    opacity: 0.6;
    z-index: 1;
  }

  .deck-layer-2 {
    background-color: #1f3e65;
    transform: rotate(3.5deg) translateY(6px);
    opacity: 0.85;
    z-index: 2;
  }

  .deck-layer-1 {
    background-color: #ffffff;
    transform: rotate(0deg);
    z-index: 3;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .nanonews-stacked-trigger:hover .deck-layer-3 {
    transform: rotate(-9deg) translateY(18px) translateX(-8px);
  }

  .nanonews-stacked-trigger:hover .deck-layer-2 {
    transform: rotate(6deg) translateY(10px) translateX(6px);
  }

  .nanonews-stacked-trigger:hover .deck-layer-1 {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.25);
  }

  .nanonews-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-normal);
  }

  .cover-glow-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(7, 28, 52, 0.7) 100%);
    pointer-events: none;
  }

  .issue-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: var(--color-cyan);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  }

  .pages-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: rgba(7, 28, 52, 0.85);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    backdrop-filter: blur(4px);
  }

  .expand-prompt {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-navy);
    color: var(--color-white);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 0.45rem 1rem;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    border: 1px solid var(--color-cyan);
    transition: all var(--transition-fast);
  }

  .nanonews-stacked-trigger:hover .expand-prompt {
    background-color: var(--color-cyan);
    transform: translateX(-50%) scale(1.05);
  }

  /* Info Box */
  .nanonews-info-box {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .nanonews-title {
    font-size: 1.35rem;
    color: var(--color-navy);
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }

  .nanonews-subtitle {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-cyan);
    margin-bottom: 0.85rem;
    display: block;
  }

  .nanonews-summary {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .nanonews-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
  }

  .topic-tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    background-color: var(--color-bg-light);
    color: var(--color-navy);
    border: 1px solid var(--color-border-light);
    font-weight: 600;
  }

  .read-action-bar {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-light);
  }

  .read-btn-label {
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--color-institutional-blue);
    letter-spacing: 0.5px;
    transition: color var(--transition-fast);
  }

  .nanonews-stacked-trigger:hover .read-btn-label {
    color: var(--color-cyan);
  }

  /* Modal Reader Dialog */
  .nanonews-modal-dialog {
    border: none;
    border-radius: var(--border-radius-md);
    background: transparent;
    padding: 0;
    max-width: 780px;
    width: 95%;
    max-height: 94vh;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
  }

  .nanonews-modal-dialog::backdrop {
    background-color: rgba(7, 28, 52, 0.85);
    backdrop-filter: blur(8px);
  }

  .nanonews-modal-inner {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 1.75rem;
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: 94vh;
    overflow-y: auto;
  }

  .nanonews-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: var(--color-bg-light);
    border: 1px solid var(--color-border-light);
    color: var(--color-navy);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.4rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
    z-index: 10;
  }

  .nanonews-modal-close:hover {
    background-color: var(--color-cyan);
    color: var(--color-white);
  }

  .nanonews-modal-header {
    margin-bottom: 1.25rem;
    padding-right: 2.5rem;
  }

  .modal-header-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .modal-badge-issue {
    background-color: var(--color-cyan);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 0.25rem 0.65rem;
    border-radius: 3px;
  }

  .modal-counter-badge {
    background-color: var(--color-bg-light);
    color: var(--color-navy);
    border: 1px solid var(--color-border-light);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 3px;
  }

  .nanonews-modal-title {
    font-size: 1.35rem;
    color: var(--color-navy);
    margin: 0 0 0.25rem;
  }

  .nanonews-modal-subtitle {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Viewer Viewport Stage */
  .nanonews-viewer-stage {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .viewer-page-wrapper {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #071c34;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    min-height: 480px;
    max-height: 60vh;
    box-shadow: var(--shadow-hover);
  }

  .reader-current-img {
    max-width: 100%;
    max-height: 60vh;
    object-fit: contain;
    display: block;
    transition: opacity var(--transition-fast);
  }

  .viewer-nav-btn {
    background-color: var(--color-navy);
    color: var(--color-white);
    border: 1px solid var(--color-cyan);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .viewer-nav-btn:hover {
    background-color: var(--color-cyan);
    transform: scale(1.08);
  }

  /* Thumbnails Strip */
  .nanonews-thumb-strip {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding: 0.5rem 0.25rem 0.75rem;
    margin-bottom: 0.5rem;
  }

  :global(.reader-thumb-btn) {
    flex: 0 0 60px;
    height: 80px;
    border-radius: 4px;
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;
    background-color: #071c34;
    transition: all var(--transition-fast);
    opacity: 0.6;
  }

  :global(.reader-thumb-btn:hover) {
    opacity: 0.9;
    border-color: var(--color-cyan);
  }

  :global(.reader-thumb-btn.active) {
    opacity: 1;
    border-color: var(--color-cyan);
    box-shadow: 0 0 0 2px var(--color-cyan);
    transform: scale(1.05);
  }

  :global(.reader-thumb-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reader-footer-hint {
    text-align: center;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 860px) {
    .nanonews-grid {
      grid-template-columns: 1fr;
    }
    .stacked-deck {
      height: 380px;
    }
  }

  /* Dark mode overrides */
  :global(html[data-theme="dark"]) .nanonews-main-section {
    background-color: #051324;
  }

  :global(html[data-theme="dark"]) .nanonews-stacked-trigger {
    background-color: #071c34;
    border-color: rgba(5, 135, 189, 0.25);
  }

  :global(html[data-theme="dark"]) .nanonews-title {
    color: #f1f5f9;
  }

  :global(html[data-theme="dark"]) .topic-tag {
    background-color: #0c2340;
    color: #e2e8f0;
    border-color: rgba(5, 135, 189, 0.3);
  }

  :global(html[data-theme="dark"]) .nanonews-modal-inner {
    background-color: #071c34;
    border: 1px solid rgba(5, 135, 189, 0.3);
  }

  :global(html[data-theme="dark"]) .nanonews-modal-title {
    color: #f1f5f9;
  }

  :global(html[data-theme="dark"]) .modal-counter-badge {
    background-color: #0c2340;
    color: #f1f5f9;
    border-color: rgba(5, 135, 189, 0.3);
  }

  :global(html[data-theme="dark"]) .nanonews-modal-close {
    background-color: #0c2340;
    color: #f1f5f9;
    border-color: rgba(5, 135, 189, 0.3);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const baseUrl = '/ieee-ntc-yachay';
    function resolveUrl(path: string) {
      if (!path) return '';
      if (path.startsWith('http') || path.startsWith(baseUrl)) return path;
      return `${baseUrl.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
    }

    const modal = document.getElementById('nanonews-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('nanonews-close-btn');
    const prevBtn = document.getElementById('reader-prev-btn');
    const nextBtn = document.getElementById('reader-next-btn');

    const badgeEl = document.getElementById('reader-issue-badge');
    const counterEl = document.getElementById('reader-page-counter');
    const titleEl = document.getElementById('reader-title-display');
    const subtitleEl = document.getElementById('reader-subtitle-display');
    const pageImg = document.getElementById('reader-page-img') as HTMLImageElement | null;
    const thumbStrip = document.getElementById('reader-thumb-strip');

    let currentIssue: any = null;
    let currentPageIndex = 0;

    function renderPage(idx: number) {
      if (!currentIssue || !currentIssue.pages || currentIssue.pages.length === 0) return;
      currentPageIndex = (idx + currentIssue.pages.length) % currentIssue.pages.length;
      
      const pageSrc = resolveUrl(currentIssue.pages[currentPageIndex]);
      if (pageImg) pageImg.src = pageSrc;

      if (badgeEl) badgeEl.textContent = `EDITION #${currentIssue.issueNumber}`;
      if (counterEl) counterEl.textContent = `Page ${currentPageIndex + 1} of ${currentIssue.totalPages}`;
      if (titleEl) titleEl.textContent = currentIssue.title;
      if (subtitleEl) subtitleEl.textContent = currentIssue.subtitle;

      // Update active thumbnail
      if (thumbStrip) {
        const thumbs = thumbStrip.querySelectorAll('.reader-thumb-btn');
        thumbs.forEach((t, i) => {
          if (i === currentPageIndex) {
            t.classList.add('active');
            t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          } else {
            t.classList.remove('active');
          }
        });
      }
    }

    function buildThumbnails(issue: any) {
      if (!thumbStrip) return;
      thumbStrip.innerHTML = '';

      issue.pages.forEach((pagePath: string, i: number) => {
        const btn = document.createElement('button');
        btn.className = `reader-thumb-btn ${i === 0 ? 'active' : ''}`;
        btn.setAttribute('aria-label', `Go to page ${i + 1}`);

        const img = document.createElement('img');
        img.src = resolveUrl(pagePath);
        img.alt = `Page ${i + 1} thumbnail`;
        img.className = 'reader-thumb-img';

        btn.appendChild(img);
        btn.addEventListener('click', () => renderPage(i));
        thumbStrip.appendChild(btn);
      });
    }

    document.querySelectorAll('.open-nanonews-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-issue');
        if (!raw || !modal) return;
        currentIssue = JSON.parse(raw);
        currentPageIndex = 0;

        buildThumbnails(currentIssue);
        renderPage(0);
        modal.showModal();
      });
    });

    prevBtn?.addEventListener('click', () => renderPage(currentPageIndex - 1));
    nextBtn?.addEventListener('click', () => renderPage(currentPageIndex + 1));

    document.addEventListener('keydown', (e) => {
      if (modal?.open) {
        if (e.key === 'ArrowLeft') renderPage(currentPageIndex - 1);
        if (e.key === 'ArrowRight') renderPage(currentPageIndex + 1);
      }
    });

    closeBtn?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  });
</script>
