---
import Layout from '@/layouts/Layout.astro';
import { EVENTS_DATA } from '@/data/events';
import { PROJECTS_DATA } from '@/data/projects';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

const upcomingStripEvents = EVENTS_DATA.slice(0, 3);
---

<Layout 
  title="IEEE Nanotechnology Council - Yachay Tech Student Branch"
  description="Official website of the IEEE Nanotechnology Council Student Branch Chapter at Yachay Tech University. First in Ecuador, fourth in Latin America. Empowering the next generation of nanoscience innovators."
>
  <!-- Hero Section -->
  <section class="hero-home">
    <div class="site-container hero-container">
      <div class="hero-text-col">
        <div class="hero-pre-badge">
          <span class="pulse-dot"></span>
          <span>1ST IN ECUADOR · 4TH IN LATIN AMERICA</span>
        </div>
        
        <h1 class="hero-title font-heading">
          EMPOWERING THE NEXT GENERATION OF INNOVATORS THROUGH <span class="highlight-cyan">NANOTECHNOLOGY</span>
        </h1>
        
        <p class="hero-description">
          We connect students and young researchers passionate about nanotechnology, materials science, and biomedical innovation to research, collaborate, publish, and create real scientific and social impact.
        </p>

        <div class="hero-cta-group">
          <a href="#join-chapter" class="btn btn-primary hero-btn">
            <span>JOIN OUR COMMUNITY</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href={getHref('/events/')} class="btn btn-outline-light hero-btn">
            <span>VIEW ACTIVITIES</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
          </a>
        </div>
      </div>

      <div class="hero-image-col">
        <div class="hero-img-wrapper">
          <img 
            src={getHref('/assets/gallery/directiva_star_pose.png')} 
            alt="IEEE NTC Yachay Tech Executive Officers Team" 
            width="600" 
            height="600" 
            class="hero-img"
            loading="eager"
          />
          <div class="hero-badge-pill">
            <span class="badge-dot"></span>
            <span>Founded February 25, 2026 · Yachay Tech</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Curved Wave Transition -->
    <div class="hero-wave-bottom" aria-hidden="true">
      <svg viewBox="0 0 1440 60" preserveAspectRatio="none" fill="#FFFFFF">
        <path d="M0,0 C480,50 960,50 1440,0 L1440,60 L0,60 Z"></path>
      </svg>
    </div>
  </section>

  <!-- 2026 LIVE GROWTH METRICS BAR -->
  <section class="stats-growth-section">
    <div class="site-container">
      <div class="stats-card-wrapper">
        <div class="stats-header-bar">
          <div class="stats-title-group">
            <span class="stats-indicator-dot"></span>
            <h2 class="stats-main-heading">2026 CHAPTER GROWTH & IMPACT METRICS</h2>
          </div>
          <span class="stats-milestone-pill">PIONEERING IN ECUADOR</span>
        </div>

        <div class="stats-grid">
          <div class="stat-box">
            <div class="stat-number">44</div>
            <div class="stat-label">Community Members & Volunteers</div>
            <div class="stat-subtext">6 Officers · 6 Members · 32 Volunteers</div>
          </div>

          <div class="stat-box">
            <div class="stat-number">3</div>
            <div class="stat-label">Active Projects in Development</div>
            <div class="stat-subtext">VR NanoLab · Logic Lock · LANANO</div>
          </div>

          <div class="stat-box">
            <div class="stat-number">1</div>
            <div class="stat-label">NanoSkills Workshop Series</div>
            <div class="stat-subtext">Cleanroom Sputtering & Thin Films</div>
          </div>

          <div class="stat-box">
            <div class="stat-number">1</div>
            <div class="stat-label">NanoTalks International Edition</div>
            <div class="stat-subtext">Keynote with CSIC Spain</div>
          </div>

          <div class="stat-box stat-highlight-box">
            <div class="stat-number">282+</div>
            <div class="stat-label">Instagram Community Followers</div>
            <div class="stat-subtext">@ntc.yachaytech</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 Pillars Section with Animated Dynamic Cards -->
  <section class="pillars-section">
    <div class="site-container">
      <div class="section-header text-center">
        <span class="section-eyebrow">INSTITUTIONAL IDENTITY</span>
        <h2 class="section-title">OUR PILLARS & STRATEGIC FOUNDATIONS</h2>
      </div>

      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="pillar-top-ribbon"></div>
          <div class="pillar-icon-box">
            <div class="pillar-ambient-halo"></div>
            <div class="pillar-icon-circle">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
          </div>
          <h3 class="pillar-title font-heading">WHO WE ARE</h3>
          <p class="pillar-desc">
            Founded on February 25, 2026, we are the 1st IEEE Nanotechnology Council Chapter in Ecuador and 4th in Latin America, born at Yachay Tech University, home to Ecuador's only undergraduate Nanotechnology degree program.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-top-ribbon"></div>
          <div class="pillar-icon-box">
            <div class="pillar-ambient-halo"></div>
            <div class="pillar-icon-circle">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2" fill="currentColor"/></svg>
            </div>
          </div>
          <h3 class="pillar-title font-heading">OUR MISSION</h3>
          <p class="pillar-desc">
            To drive innovation, science, and technology at the nanoscale through education, research, collaboration, and outreach, connecting students and young researchers with experts, scientific communities, and global opportunities.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-top-ribbon"></div>
          <div class="pillar-icon-box">
            <div class="pillar-ambient-halo"></div>
            <div class="pillar-icon-circle">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3.5" fill="currentColor"/></svg>
            </div>
          </div>
          <h3 class="pillar-title font-heading">OUR VISION</h3>
          <p class="pillar-desc">
            To be a leading benchmark in nanotechnology across Ecuador and Latin America, renowned for connecting talent, research, and innovation with international opportunities and taking science beyond the laboratory.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-top-ribbon"></div>
          <div class="pillar-icon-box">
            <div class="pillar-ambient-halo"></div>
            <div class="pillar-icon-circle">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
          </div>
          <h3 class="pillar-title font-heading">OUR GOALS</h3>
          <p class="pillar-desc">
            Empower students through hands-on cleanroom equipment training, structured IEEE publication incubators, and Virtual Reality simulations that bring nanoscale science into schools and hospitals.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-top-ribbon"></div>
          <div class="pillar-icon-box">
            <div class="pillar-ambient-halo"></div>
            <div class="pillar-icon-circle">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"/><path d="M3.6 9h16.8"/><path d="M3.6 15h16.8"/><path d="M11.5 3a17 17 0 0 0 0 18"/><path d="M12.5 3a17 17 0 0 1 0 18"/></svg>
            </div>
          </div>
          <h3 class="pillar-title font-heading">OUR COMMUNITY</h3>
          <p class="pillar-desc">
            A passionate network of 44 members, officers, and volunteers working collaboratively on research, laboratory workshops, public television broadcasts, and community service.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dark Strip "Upcoming Events" -->
  <section class="events-strip-section">
    <div class="site-container">
      <div class="strip-header">
        <div class="strip-header-left">
          <span class="strip-eyebrow-dot"></span>
          <h2 class="strip-title">FEATURED ACTIVITIES</h2>
        </div>
        <a href={getHref('/events/')} class="strip-view-all">
          VIEW FULL CHRONOLOGY &rarr;
        </a>
      </div>

      <div class="strip-events-grid">
        {upcomingStripEvents.map((evt) => (
          <article class="strip-card">
            {evt.image ? (
              <div class="strip-card-img-box">
                <img src={getHref(evt.image)} alt={evt.imageAlt} width="160" height="90" loading="lazy" class="strip-img" />
              </div>
            ) : (
              <div class="strip-card-img-box strip-card-icon-box">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="#0587bd" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
              </div>
            )}
            <div class="strip-card-content">
              <span class="strip-date">{evt.date}</span>
              <h3 class="strip-card-title">{evt.title}</h3>
              <span class="strip-location">{evt.location}</span>
              <a href={getHref('/events/')} class="strip-card-link">VIEW DETAILS &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive "JOIN THE CHAPTER" Section -->
  <section class="home-join-section" id="join-chapter">
    <div class="site-container">
      <div class="join-box-wrapper">
        <div class="join-header text-center">
          <span class="section-eyebrow">COMMUNITY ENGAGEMENT</span>
          <h2 class="join-main-title font-heading">JOIN THE CHAPTER</h2>
          <p class="join-main-desc">
            Do you want to learn, research, and connect with the nanotechnology community? Discover how you can participate and make an impact.
          </p>
        </div>

        <div class="home-join-grid">
          <!-- Option 1: Volunteer -->
          <div class="home-join-card">
            <div class="join-card-icon">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor" aria-hidden="true"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
            </div>
            <h3 class="join-card-heading">BECOME A VOLUNTEER</h3>
            <p class="join-card-text">
              Simply get in touch with us to collaborate on our workshops, hospital visits, and public events. 
              <strong>No paid IEEE membership is required</strong> to volunteer. Active volunteers gain hands-on experience and preferential access to chapter programs.
            </p>
            <a href={getHref('/contact/?topic=volunteer#contact-form')} class="btn btn-primary join-action-btn">
              <span>BECOME A VOLUNTEER &rarr;</span>
            </a>
          </div>

          <!-- Option 2: IEEE Membership -->
          <div class="home-join-card featured-join">
            <div class="join-tag">OFFICIAL RECOGNITION</div>
            <div class="join-card-icon">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            </div>
            <h3 class="join-card-heading">IEEE & NTC MEMBERSHIP</h3>
            <p class="join-card-text">
              Obtain your formal IEEE and IEEE Nanotechnology Council student membership. Access IEEE Xplore digital library discounts, student travel grants, conference discounts, and executive leadership eligibility.
            </p>
            <div class="dual-btn-row">
              <button class="btn btn-primary open-membership-modal-btn join-action-btn">
                <span>MEMBERSHIP GUIDE &rarr;</span>
              </button>
              <a href="https://www.ieee.org/membership/join/index.html" target="_blank" rel="noopener noreferrer" class="btn btn-outline-light join-action-btn">
                <span>JOIN ON IEEE.ORG ↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom Row: Projects, Latest News, Gallery Highlights -->
  <section class="home-bottom-row">
    <div class="site-container bottom-grid">
      <!-- Column 1: Projects & Initiatives -->
      <div class="bottom-col">
        <div class="col-header">
          <h2 class="col-title font-heading">PROJECTS & INITIATIVES</h2>
          <a href={getHref('/projects/')} class="col-link">VIEW ALL &rarr;</a>
        </div>

        <div class="projects-mini-grid">
          <div class="mini-proj-item">
            <div class="mini-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M19 19v2H5v-2h14zm-4-9l1.41-1.41-3.54-3.54-1.41 1.41 3.54 3.54zM8.5 11C7.12 11 6 9.88 6 8.5S7.12 6 8.5 6 11 7.12 11 8.5 9.88 11 8.5 11zm1.5-6.5C10 3.12 8.88 2 7.5 2S5 3.12 5 4.5 6.12 7 7.5 7 10 5.88 10 4.5z"/></svg>
            </div>
            <div>
              <strong>VR NANOLAB SIMULATION</strong>
              <p>Meta Quest 3 cleanroom and molecular environment taking science into schools and hospitals.</p>
            </div>
          </div>
          <div class="mini-proj-item">
            <div class="mini-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/></svg>
            </div>
            <div>
              <strong>LOGIC LOCK FRAMEWORK</strong>
              <p>Digital research methodology for automated paper discovery and citation mapping.</p>
            </div>
          </div>
          <div class="mini-proj-item">
            <div class="mini-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7z"/></svg>
            </div>
            <div>
              <strong>LANANO 2026 INCUBATOR</strong>
              <p>Mentorship program preparing original scientific manuscripts for IEEE Xplore indexing.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Column 2: Latest News -->
      <div class="bottom-col">
        <div class="col-header">
          <h2 class="col-title font-heading">LATEST NEWS</h2>
          <a href={getHref('/news/')} class="col-link">VIEW ALL &rarr;</a>
        </div>

        <div class="news-mini-list">
          <article class="mini-news-item">
            <img src={getHref('/assets/events/ieee_temscon_latam.jpg')} alt="IEEE NTC TEMSCON" width="60" height="44" class="mini-news-thumb" />
            <div>
              <span class="mini-news-date">JUNE 26, 2026</span>
              <h3 class="mini-news-title">Explainable AI in Medical Screening at IEEE TEMSCON LATAM</h3>
            </div>
          </article>

          <article class="mini-news-item">
            <img src={getHref('/assets/events/nanotalks_dominios_magneticos.png')} alt="NanoTalks CSIC Spain" width="60" height="44" class="mini-news-thumb" />
            <div>
              <span class="mini-news-date">JULY 16, 2026</span>
              <h3 class="mini-news-title">NanoTalks: Magnetic Domains Keynote by Dr. José García-Martín</h3>
            </div>
          </article>
        </div>
      </div>

      <!-- Column 3: Gallery Highlights -->
      <div class="bottom-col">
        <div class="col-header">
          <h2 class="col-title font-heading">GALLERY HIGHLIGHTS</h2>
          <a href={getHref('/gallery/')} class="col-link">VIEW ALL PHOTOS &rarr;</a>
        </div>

        <div class="gallery-mini-mosaic">
          <img src={getHref('/assets/gallery/foto_con_bandera.jpg')} alt="Gallery 1" width="100" height="70" class="mosaic-img" />
          <img src={getHref('/assets/gallery/actividad_colegio_1.jpg')} alt="Gallery 2" width="100" height="70" class="mosaic-img" />
          <img src={getHref('/assets/events/ieee_temscon_latam.jpg')} alt="Gallery 3" width="100" height="70" class="mosaic-img" />
          <img src={getHref('/assets/events/dia_del_nino_hospital.jpg')} alt="Gallery 4" width="100" height="70" class="mosaic-img" />
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Modal for IEEE Membership Step-by-Step Guide -->
  <dialog id="membership-guide-modal" class="membership-modal-dialog">
    <div class="membership-modal-inner">
      <button class="membership-modal-close" id="membership-modal-close-btn" aria-label="Close guide">&times;</button>
      
      <div class="modal-badge-top">OFFICIAL IEEE ONBOARDING</div>
      <h2 class="guide-modal-title font-heading">HOW TO OBTAIN YOUR IEEE & NTC MEMBERSHIP</h2>
      <p class="guide-modal-subtitle">
        Follow these 3 simple steps to access international IEEE privileges, digital libraries, and student grant opportunities.
      </p>

      <div class="guide-steps-list">
        <div class="step-card">
          <div class="step-number-box">1</div>
          <div class="step-content">
            <h4>Create Account on IEEE.org</h4>
            <p>
              Visit <a href="https://www.ieee.org/membership/join/index.html" target="_blank" rel="noopener noreferrer">ieee.org/join</a>. Select <strong>Student Membership</strong> and use your university email address to receive subsidized student regional fees (Region 9).
            </p>
          </div>
        </div>

        <div class="step-card">
          <div class="step-number-box">2</div>
          <div class="step-content">
            <h4>Add the Nanotechnology Council (NTC)</h4>
            <p>
              In the society and council selection section, check the <strong>IEEE Nanotechnology Council (NTC)</strong> to receive society publications, conference discounts, and seasonal school access.
            </p>
          </div>
        </div>

        <div class="step-card">
          <div class="step-number-box">3</div>
          <div class="step-content">
            <h4>Notify IEEE NTC Yachay Tech Secretariat</h4>
            <p>
              Once you receive your 8-digit IEEE Member Number, send it to us via our contact form or official email so we can formally register your local branch affiliation and invite you to our executive committees.
            </p>
          </div>
        </div>
      </div>

      <div class="guide-modal-actions">
        <a href="https://www.ieee.org/membership/join/index.html" target="_blank" rel="noopener noreferrer" class="btn btn-primary modal-action-btn">
          <span>GO TO IEEE.ORG JOIN PORTAL ↗</span>
        </a>
        <a href={getHref('/contact/?topic=membership#contact-form')} class="btn btn-outline-dark modal-action-btn">
          <span>CONTACT OUR SECRETARIAT &rarr;</span>
        </a>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  /* HERO SECTION */
  .hero-home {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 40%, #0d2847 70%, #152A47 100%);
    color: var(--color-white);
    padding: 3.5rem 0 4.5rem;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-pre-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(5, 135, 189, 0.18);
    border: 1px solid var(--color-cyan);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 1.2px;
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10B981;
    box-shadow: 0 0 8px #10B981;
  }

  .hero-title {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    color: var(--color-white);
    line-height: 1.12;
    margin-bottom: 1.25rem;
  }

  .highlight-cyan {
    color: var(--color-cyan);
  }

  .hero-description {
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 2rem;
    max-width: 560px;
  }

  .hero-cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-btn {
    padding: 0.85rem 1.75rem;
    font-size: 0.92rem;
    letter-spacing: 0.5px;
  }

  .hero-image-col {
    display: flex;
    justify-content: center;
  }

  .hero-img-wrapper {
    position: relative;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: 0 25px 50px -10px rgba(0, 0, 0, 0.6);
    border: 2px solid rgba(5, 135, 189, 0.6);
    max-width: 520px;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #0c2340;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 25%;
    transition: transform var(--transition-normal);
  }

  .hero-img-wrapper:hover .hero-img {
