<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('membership-guide-modal') as HTMLDialogElement | null;
    const openBtns = document.querySelectorAll('.open-membership-modal-btn');
    const closeBtn = document.getElementById('membership-modal-close-btn');

    openBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        modal?.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => {
      modal?.close();
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  });
</script>
