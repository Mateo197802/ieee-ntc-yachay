---
import Layout from '@/layouts/Layout.astro';
import { EVENTS_DATA } from '@/data/events';
import { PROJECTS_DATA } from '@/data/projects';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

const upcomingStripEvents = EVENTS_DATA.slice(0, 3);
---

<Layout 
  title="IEEE Nanotechnology Council - Yachay Tech Student Branch"
  description="Official website of the IEEE Nanotechnology Council Student Branch Chapter at Yachay Tech University. Empowering the next generation of nanoscience innovators."
>
  <!-- Hero Section -->
  <section class="hero-home">
    <div class="site-container hero-container">
      <div class="hero-text-col">
        <span class="hero-eyebrow">• IEEE NANOTECHNOLOGY COUNCIL · YACHAY TECH</span>
        <h1 class="hero-title font-heading">
          EMPOWERING THE NEXT GENERATION OF INNOVATORS THROUGH <span class="highlight-cyan">NANOTECHNOLOGY</span>
        </h1>
        <p class="hero-description">
          We connect students passionate about nanotechnology and related sciences to research, collaborate, innovate, and create real scientific and social impact.
        </p>

        <div class="hero-cta-group">
          <a href={getHref('/contact/')} class="btn btn-primary hero-btn">
            <span>JOIN OUR COMMUNITY</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href={getHref('/events/')} class="btn btn-outline-light hero-btn">
            <span>VIEW UPCOMING EVENTS</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
          </a>
        </div>
      </div>

      <div class="hero-image-col">
        <div class="hero-img-wrapper">
          <img 
            src={getHref('/assets/gallery/foto_con_bandera.jpg')} 
            alt="IEEE NTC Yachay Tech Student Branch Members" 
            width="600" 
            height="400" 
            class="hero-img"
            loading="eager"
          />
          <div class="hero-badge-pill">
            <span class="badge-dot"></span>
            <span>Yachay Tech Student Branch</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Curved/Swoosh Wave Transition -->
    <div class="hero-wave-bottom" aria-hidden="true">
      <svg viewBox="0 0 1440 60" preserveAspectRatio="none" fill="#FFFFFF">
        <path d="M0,0 C480,50 960,50 1440,0 L1440,60 L0,60 Z"></path>
      </svg>
    </div>
  </section>

  <!-- 5 Pillars Section -->
  <section class="pillars-section">
    <div class="site-container">
      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="pillar-icon-circle">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          </div>
          <h2 class="pillar-title font-heading">WHO WE ARE</h2>
          <p class="pillar-desc">We are the first IEEE Nanotechnology Council Student Branch Chapter in Ecuador, guided by curiosity and scientific excellence.</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-circle">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"/></svg>
          </div>
          <h2 class="pillar-title font-heading">OUR MISSION</h2>
          <p class="pillar-desc">To promote nanotechnology education, interdisciplinary research, and community service across Latin America.</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-circle">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
          </div>
          <h2 class="pillar-title font-heading">OUR VISION</h2>
          <p class="pillar-desc">To be a benchmark chapter in nanotechnology innovation, high-impact publications, and open scientific outreach.</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-circle">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M9.19 6.35c-2.04 2.29-3.44 5.58-3.57 9.15l2.12.6c.12-3.04 1.31-5.83 3.03-7.79l-1.58-1.96zM19 3l-6 6 2 2 6-6V3h-2zM4.93 4.93L3.52 6.34l3.54 3.54 1.41-1.41L4.93 4.93zM14.81 17.65c2.04-2.29 3.44-5.58 3.57-9.15l-2.12-.6c-.12 3.04-1.31 5.83-3.03 7.79l1.58 1.96z"/></svg>
          </div>
          <h2 class="pillar-title font-heading">OUR GOALS</h2>
          <p class="pillar-desc">To inspire, connect, and empower students to solve global technological challenges through nanoscience.</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-circle">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9 0c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4zm9 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V20h6v-2c0-2.66-5.33-4-8-4z"/></svg>
          </div>
          <h2 class="pillar-title font-heading">OUR COMMUNITY</h2>
          <p class="pillar-desc">A passionate and diverse community driving scientific change across Yachay Tech and IEEE Region 9.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dark Strip "Upcoming Events" -->
  <section class="events-strip-section">
    <div class="site-container">
      <div class="strip-header">
        <div class="strip-header-left">
          <span class="strip-eyebrow-dot"></span>
          <h2 class="strip-title">UPCOMING EVENTS</h2>
        </div>
        <a href={getHref('/events/')} class="strip-view-all">
          VIEW ALL EVENTS &rarr;
        </a>
      </div>

      <div class="strip-events-grid">
        {upcomingStripEvents.map((evt) => (
          <article class="strip-card">
            {evt.image ? (
              <div class="strip-card-img-box">
                <img src={getHref(evt.image)} alt={evt.imageAlt} width="160" height="90" loading="lazy" class="strip-img" />
              </div>
            ) : (
              <div class="strip-card-img-box strip-card-icon-box">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="#0587bd" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
              </div>
            )}
            <div class="strip-card-content">
              <span class="strip-date">{evt.date}</span>
              <h3 class="strip-card-title">{evt.title}</h3>
              <span class="strip-location">{evt.location}</span>
              <a href={getHref('/events/')} class="strip-card-link">VIEW DETAILS &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom Row: Projects, Latest News, Gallery Highlights -->
  <section class="home-bottom-row">
    <div class="site-container bottom-grid">
      <!-- Column 1: Projects & Initiatives -->
      <div class="bottom-col">
        <div class="col-header">
          <h2 class="col-title font-heading">PROJECTS & INITIATIVES</h2>
          <a href={getHref('/projects/')} class="col-link">VIEW ALL &rarr;</a>
        </div>

        <div class="projects-mini-grid">
          <div class="mini-proj-item">
            <div class="mini-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M19 19v2H5v-2h14zm-4-9l1.41-1.41-3.54-3.54-1.41 1.41 3.54 3.54zM8.5 11C7.12 11 6 9.88 6 8.5S7.12 6 8.5 6 11 7.12 11 8.5 9.88 11 8.5 11zm1.5-6.5C10 3.12 8.88 2 7.5 2S5 3.12 5 4.5 6.12 7 7.5 7 10 5.88 10 4.5z"/></svg>
            </div>
            <div>
              <strong>RESEARCH</strong>
              <p>Promoting research and publications in nanotechnology.</p>
            </div>
          </div>
          <div class="mini-proj-item">
            <div class="mini-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/></svg>
            </div>
            <div>
              <strong>OUTREACH</strong>
              <p>Bringing science and hands-on workshops to schools and communities.</p>
            </div>
          </div>
          <div class="mini-proj-item">
            <div class="mini-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7z"/></svg>
            </div>
            <div>
              <strong>INNOVATION</strong>
              <p>Developing Artificial Intelligence, Edge AI, and Virtual Reality.</p>
            </div>
          </div>
          <div class="mini-proj-item">
            <div class="mini-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            </div>
            <div>
              <strong>SERVICE</strong>
              <p>Generating social and humanitarian impact through technology.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Column 2: Latest News -->
      <div class="bottom-col">
        <div class="col-header">
          <h2 class="col-title font-heading">LATEST NEWS</h2>
          <a href={getHref('/news/')} class="col-link">VIEW ALL &rarr;</a>
        </div>

        <div class="news-mini-list">
          <article class="mini-news-item">
            <img src={getHref('/assets/events/ieee_temscon_latam.jpg')} alt="IEEE NTC TEMSCON" width="60" height="44" class="mini-news-thumb" />
            <div>
              <span class="mini-news-date">MAY 15, 2026</span>
              <h3 class="mini-news-title">IEEE NTC participates in TEMSCON LATAM 2026</h3>
            </div>
          </article>

          <article class="mini-news-item">
            <img src={getHref('/assets/events/visita_victor_manuel_guzman.jpg')} alt="School Visit to U.E. Victor Manuel Guzman" width="60" height="44" class="mini-news-thumb" />
            <div>
              <span class="mini-news-date">MAY 05, 2026</span>
              <h3 class="mini-news-title">School Visit to Unidad Educativa Víctor Manuel Guzmán</h3>
            </div>
          </article>
        </div>
      </div>

      <!-- Column 3: Gallery Highlights -->
      <div class="bottom-col">
        <div class="col-header">
          <h2 class="col-title font-heading">GALLERY HIGHLIGHTS</h2>
          <a href={getHref('/gallery/')} class="col-link">VIEW ALL PHOTOS &rarr;</a>
        </div>

        <div class="gallery-mini-mosaic">
          <img src={getHref('/assets/gallery/foto_con_bandera.jpg')} alt="Gallery 1" width="100" height="70" class="mosaic-img" />
          <img src={getHref('/assets/gallery/actividad_colegio_1.jpg')} alt="Gallery 2" width="100" height="70" class="mosaic-img" />
          <img src={getHref('/assets/events/ieee_temscon_latam.jpg')} alt="Gallery 3" width="100" height="70" class="mosaic-img" />
          <img src={getHref('/assets/events/dia_del_nino_hospital.jpg')} alt="Gallery 4" width="100" height="70" class="mosaic-img" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* HERO SECTION */
  .hero-home {
    background: linear-gradient(135deg, #071C34 0%, var(--color-navy) 40%, #0d2847 70%, #152A47 100%);
    color: var(--color-white);
    padding: 3.5rem 0 4rem;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-eyebrow {
    display: inline-block;
    color: var(--color-cyan);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .hero-title {
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    color: var(--color-white);
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .highlight-cyan {
    color: var(--color-cyan);
  }

  .hero-description {
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 2rem;
    max-width: 540px;
  }

  .hero-cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-btn {
    padding: 0.8rem 1.6rem;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
  }

  .hero-image-col {
    display: flex;
    justify-content: center;
  }

  .hero-img-wrapper {
    position: relative;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    border: 2px solid rgba(5, 135, 189, 0.4);
  }

  .hero-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .hero-badge-pill {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(7, 28, 52, 0.9);
    border: 1px solid var(--color-cyan);
    border-radius: 30px;
    padding: 0.4rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-white);
    backdrop-filter: blur(4px);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-cyan);
    box-shadow: 0 0 8px var(--color-cyan);
  }

  .hero-wave-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    line-height: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero-wave-bottom svg {
    width: 100%;
    height: 30px;
    display: block;
  }

  /* 5 PILLARS SECTION */
  .pillars-section {
    padding: 3.5rem 0 3.5rem;
    background-color: var(--color-white);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }

  .pillar-card {
    text-align: center;
    padding: 1.5rem 1rem;
    border-radius: var(--border-radius-sm);
    transition: transform 0.2s ease;
  }

  .pillar-card:hover {
    transform: translateY(-4px);
  }

  .pillar-icon-circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: rgba(5, 135, 189, 0.1);
    color: var(--color-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
  }

  .pillar-title {
    font-size: 0.95rem;
    color: var(--color-navy);
    margin-bottom: 0.6rem;
    letter-spacing: 0.5px;
  }

  .pillar-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* DARK STRIP EVENTS */
  .events-strip-section {
    background-color: #071C34;
    padding: 2.75rem 0;
    color: var(--color-white);
    border-top: 1px solid rgba(5, 135, 189, 0.3);
    border-bottom: 1px solid rgba(5, 135, 189, 0.3);
  }

  .strip-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.75rem;
  }

  .strip-header-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .strip-eyebrow-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--color-cyan);
  }

  .strip-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    color: var(--color-white);
    margin: 0;
    letter-spacing: 0.5px;
  }

  .strip-view-all {
    color: var(--color-cyan);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.5px;
  }

  .strip-view-all:hover {
    text-decoration: underline;
  }

  .strip-events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .strip-card {
    background-color: #0B2545;
    border-radius: var(--border-radius-sm);
    padding: 1.25rem;
    display: flex;
    gap: 1.25rem;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .strip-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-cyan);
  }

  .strip-card-img-box {
    width: 110px;
    height: 75px;
    border-radius: 4px;
    overflow: hidden;
    flex-shrink: 0;
    background-color: #071C34;
  }

  .strip-card-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed rgba(5, 135, 189, 0.4);
  }

  .strip-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .strip-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .strip-date {
    font-size: 0.75rem;
    color: var(--color-cyan);
    font-weight: 700;
  }

  .strip-card-title {
    font-size: 0.95rem;
    color: var(--color-white);
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .strip-location {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .strip-card-link {
    font-size: 0.78rem;
    color: var(--color-cyan);
    font-weight: 700;
    text-decoration: none;
    margin-top: 0.25rem;
  }

  /* BOTTOM ROW 3 COLUMNS */
  .home-bottom-row {
    padding: 4.5rem 0;
    background-color: var(--color-bg-light);
  }

  .bottom-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .bottom-col {
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: 1.75rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-light);
  }

  .col-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-bg-light);
    margin-bottom: 1.25rem;
  }

  .col-title {
    font-size: 1.05rem;
    color: var(--color-navy);
    margin: 0;
  }

  .col-link {
    font-size: 0.8rem;
    color: var(--color-cyan);
    font-weight: 700;
    text-decoration: none;
  }

  .col-link:hover {
    text-decoration: underline;
  }

  /* Projects Mini */
  .projects-mini-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mini-proj-item {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .mini-icon {
    color: var(--color-cyan);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .mini-proj-item strong {
    display: block;
    font-size: 0.85rem;
    color: var(--color-navy);
    margin-bottom: 0.2rem;
  }

  .mini-proj-item p {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin: 0;
  }

  /* News Mini */
  .news-mini-list {
    display: flex;
    flex-direction: column;
