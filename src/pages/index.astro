---
import Layout from '@/layouts/Layout.astro';
import { EVENTS_DATA } from '@/data/events';
import { PROJECTS_DATA } from '@/data/projects';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return baseUrl === '' ? '/' : baseUrl + '/';
  return `${baseUrl}${path}`;
}

const upcomingStripEvents = EVENTS_DATA.slice(0, 3);
---

<Layout 
  title="IEEE Nanotechnology Council - Rama Estudiantil Yachay Tech"
  description="Sitio web oficial del Capítulo Estudiantil del IEEE Nanotechnology Council en Yachay Tech University. Impulsando la próxima generación de científicos e innovadores en nanotecnología."
>
  <!-- Hero Section matching Reference Image 2 -->
  <section class="hero-home">
    <div class="site-container hero-container">
      <div class="hero-text-col">
        <span class="hero-eyebrow">• IEEE NANOTECHNOLOGY COUNCIL · YACHAY TECH</span>
        <h1 class="hero-title font-heading">
          IMPULSANDO A LA PRÓXIMA GENERACIÓN DE INNOVADORES A TRAVÉS DE LA <span class="highlight-cyan">NANOTECNOLOGÍA</span>
        </h1>
        <p class="hero-description">
          Conectamos a estudiantes apasionados por la nanotecnología y ciencias afines para investigar, colaborar, innovar y generar un impacto científico y social real.
        </p>

        <div class="hero-cta-group">
          <a href={getHref('/contact/')} class="btn btn-primary hero-btn">
            ÚNETE A NUESTRA COMUNIDAD
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href={getHref('/events/')} class="btn btn-outline-light hero-btn">
            VER PRÓXIMOS EVENTOS
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
          </a>
        </div>
      </div>

      <div class="hero-image-col">
        <div class="hero-img-wrapper">
          <img 
            src={getHref('/assets/gallery/foto_con_bandera.jpg')} 
            alt="Miembros del Capítulo Estudiantil IEEE NTC Yachay Tech" 
            width="600" 
            height="400" 
            class="hero-img"
            loading="eager"
          />
          <div class="hero-badge-pill">
            <span class="badge-dot"></span>
            Rama Estudiantil Yachay Tech
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Curved/Swoosh Wave Transition -->
    <div class="hero-wave-bottom" aria-hidden="true">
      <svg viewBox="0 0 1440 60" preserveAspectRatio="none" fill="#FFFFFF">
        <path d="M0,0 C480,50 960,50 1440,0 L1440,60 L0,60 Z"></path>
      </svg>
    </div>
  </section>

  <!-- 5 Pillars Section matching Reference Image 2 -->
  <section class="pillars-section">
    <div class="site-container">
      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="pillar-icon-circle">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          </div>
          <h2 class="pillar-title font-heading">QUIÉNES SOMOS</h2>
          <p class="pillar-desc">Somos el primer Capítulo Estudiantil del IEEE Nanotechnology Council en Ecuador, guiados por la curiosidad y la excelencia científica.</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-circle">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"/></svg>
          </div>
          <h2 class="pillar-title font-heading">NUESTRA MISIÓN</h2>
          <p class="pillar-desc">Promover la educación en nanotecnología, la investigación interdisciplinaria y el servicio comunitario en América Latina.</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-circle">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
          </div>
          <h2 class="pillar-title font-heading">NUESTRA VISIÓN</h2>
          <p class="pillar-desc">Ser un capítulo referente en innovación en nanotecnología, publicaciones de alto impacto y divulgación científica abierta.</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-circle">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M9.19 6.35c-2.04 2.29-3.44 5.58-3.57 9.15l2.12.6c.12-3.04 1.31-5.83 3.03-7.79l-1.58-1.96zM19 3l-6 6 2 2 6-6V3h-2zM4.93 4.93L3.52 6.34l3.54 3.54 1.41-1.41L4.93 4.93zM14.81 17.65c2.04-2.29 3.44-5.58 3.57-9.15l-2.12-.6c-.12 3.04-1.31 5.83-3.03 7.79l1.58 1.96z"/></svg>
          </div>
          <h2 class="pillar-title font-heading">NUESTROS OBJETIVOS</h2>
          <p class="pillar-desc">Inspirar, conectar y empoderar a los estudiantes para resolver desafíos tecnológicos globales mediante nanociencia.</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-circle">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9 0c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4zm9 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V20h6v-2c0-2.66-5.33-4-8-4z"/></svg>
          </div>
          <h2 class="pillar-title font-heading">NUESTRA COMUNIDAD</h2>
          <p class="pillar-desc">Una comunidad apasionada y diversa que impulsa el cambio científico en Yachay Tech y en toda la Región 9 de IEEE.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dark Strip "Próximos Eventos" -->
  <section class="events-strip-section">
    <div class="site-container">
      <div class="strip-header">
        <div class="strip-header-left">
          <span class="strip-eyebrow-dot"></span>
          <h2 class="strip-title">PRÓXIMOS EVENTOS</h2>
        </div>
        <a href={getHref('/events/')} class="strip-view-all">
          VER TODOS LOS EVENTOS &rarr;
        </a>
      </div>

      <div class="strip-events-grid">
        {upcomingStripEvents.map((evt) => (
          <article class="strip-card">
            {evt.image ? (
              <div class="strip-card-img-box">
                <img src={getHref(evt.image)} alt={evt.imageAlt} width="160" height="90" loading="lazy" class="strip-img" />
              </div>
            ) : (
              <div class="strip-card-img-box strip-card-icon-box">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="#0587bd" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
              </div>
            )}
            <div class="strip-card-content">
              <span class="strip-date">{evt.date}</span>
              <h3 class="strip-card-title">{evt.title}</h3>
              <span class="strip-location">{evt.location}</span>
              <a href={getHref('/events/')} class="strip-card-link">VER DETALLES &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Fila Inferior 3 Bloques: Proyectos, Últimas Noticias, Destacados de Galería -->
  <section class="home-bottom-row">
    <div class="site-container bottom-grid">
      <!-- Columna 1: Proyectos e Iniciativas -->
      <div class="bottom-col">
        <div class="col-header">
          <h2 class="col-title font-heading">PROYECTOS E INICIATIVAS</h2>
          <a href={getHref('/projects/')} class="col-link">VER TODOS &rarr;</a>
        </div>

        <div class="projects-mini-grid">
          <div class="mini-proj-item">
            <div class="mini-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M19 19v2H5v-2h14zm-4-9l1.41-1.41-3.54-3.54-1.41 1.41 3.54 3.54zM8.5 11C7.12 11 6 9.88 6 8.5S7.12 6 8.5 6 11 7.12 11 8.5 9.88 11 8.5 11zm1.5-6.5C10 3.12 8.88 2 7.5 2S5 3.12 5 4.5 6.12 7 7.5 7 10 5.88 10 4.5z"/></svg>
            </div>
            <div>
              <strong>INVESTIGACIÓN</strong>
              <p>Promoviendo la investigación y publicaciones en nanotecnología.</p>
            </div>
          </div>
          <div class="mini-proj-item">
            <div class="mini-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/></svg>
            </div>
            <div>
              <strong>VINCULACIÓN</strong>
              <p>Llevando la ciencia y talleres prácticos a colegios y comunidades.</p>
            </div>
          </div>
          <div class="mini-proj-item">
            <div class="mini-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7z"/></svg>
            </div>
            <div>
              <strong>INNOVACIÓN</strong>
              <p>Desarrollando Inteligencia Artificial, Edge AI y Realidad Virtual.</p>
            </div>
          </div>
          <div class="mini-proj-item">
            <div class="mini-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            </div>
            <div>
              <strong>SERVICIO</strong>
              <p>Generando impacto social y humanitario mediante la tecnología.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna 2: Últimas Noticias -->
      <div class="bottom-col">
        <div class="col-header">
          <h2 class="col-title font-heading">ÚLTIMAS NOTICIAS</h2>
          <a href={getHref('/news/')} class="col-link">VER TODAS &rarr;</a>
        </div>

        <div class="news-mini-list">
          <article class="mini-news-item">
            <img src={getHref('/assets/events/ieee_temscon_latam.jpg')} alt="IEEE NTC TEMSCON" width="60" height="44" class="mini-news-thumb" />
            <div>
              <span class="mini-news-date">15 DE MAYO, 2026</span>
              <h3 class="mini-news-title">IEEE NTC participa en TEMSCON LATAM 2026</h3>
            </div>
          </article>

          <article class="mini-news-item">
            <img src={getHref('/assets/events/visita_victor_manuel_guzman.jpg')} alt="Visita U.E. Victor Manuel Guzman" width="60" height="44" class="mini-news-thumb" />
            <div>
              <span class="mini-news-date">05 DE MAYO, 2026</span>
              <h3 class="mini-news-title">Visita a la Unidad Educativa Víctor Manuel Guzmán</h3>
            </div>
          </article>
        </div>
      </div>

      <!-- Columna 3: Destacados de Galería -->
      <div class="bottom-col">
        <div class="col-header">
          <h2 class="col-title font-heading">DESTACADOS DE GALERÍA</h2>
          <a href={getHref('/gallery/')} class="col-link">VER TODAS LAS FOTOS &rarr;</a>
        </div>

        <div class="gallery-mini-mosaic">
          <img src={getHref('/assets/gallery/foto_con_bandera.jpg')} alt="Galería 1" width="100" height="70" class="mosaic-img" />
          <img src={getHref('/assets/gallery/actividad_colegio_1.jpg')} alt="Galería 2" width="100" height="70" class="mosaic-img" />
          <img src={getHref('/assets/events/ieee_temscon_latam.jpg')} alt="Galería 3" width="100" height="70" class="mosaic-img" />
          <img src={getHref('/assets/events/dia_del_nino_hospital.jpg')} alt="Galería 4" width="100" height="70" class="mosaic-img" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Section matching Reference Image 2 */
  .hero-home {
    background: linear-gradient(135deg, #061b31 0%, #1F3E65 70%, #152A47 100%);
    color: #ffffff;
    position: relative;
    padding: 3.5rem 0 5rem;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-cyan);
    letter-spacing: 1.5px;
    margin-bottom: 0.75rem;
    display: inline-block;
  }

  .hero-title {
    font-size: clamp(2.4rem, 3.8vw, 4.2rem);
    line-height: 1.12;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .highlight-cyan {
    color: var(--color-cyan);
    text-shadow: 0 0 20px rgba(5, 135, 189, 0.4);
  }

  .hero-description {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    max-width: 540px;
    margin-bottom: 2rem;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-btn {
    font-size: 0.85rem;
    padding: 0.75rem 1.4rem;
  }

  .hero-img-wrapper {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
    border: 2px solid rgba(5, 135, 189, 0.4);
  }

  .hero-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .hero-badge-pill {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    background: rgba(7, 28, 52, 0.85);
    backdrop-filter: blur(6px);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.4rem 0.85rem;
    border-radius: 20px;
    border: 1px solid var(--color-cyan);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-cyan);
    border-radius: 50%;
  }

  .hero-wave-bottom {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 3;
  }

  .hero-wave-bottom svg {
    display: block;
    width: 100%;
    height: 48px;
  }

  /* 5 Pillars Section */
  .pillars-section {
    padding: 4rem 0 3.5rem;
    background-color: #ffffff;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 16px 12px;
    border-right: 1px solid rgba(0, 0, 0, 0.06);
  }

  .pillar-card:last-child {
    border-right: none;
  }

  .pillar-icon-circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: rgba(5, 135, 189, 0.1);
    color: var(--color-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
  }

  .pillar-title {
    font-size: 1.05rem;
    color: var(--color-navy);
    margin-bottom: 0.4rem;
  }

  .pillar-desc {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Dark Strip "Upcoming Events" */
  .events-strip-section {
    background-color: #061b31;
    color: #ffffff;
    padding: 3.5rem 0;
    border-top: 2px solid var(--color-cyan);
    border-bottom: 2px solid var(--color-cyan);
  }

  .strip-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .strip-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .strip-eyebrow-dot {
    width: 10px;
    height: 10px;
    background-color: var(--color-cyan);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-cyan);
  }

  .strip-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.5px;
  }

  .strip-view-all {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-cyan);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .strip-view-all:hover {
    color: #ffffff;
  }

  .strip-events-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .strip-card {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(5, 135, 189, 0.35);
    border-radius: 12px;
    padding: 18px;
    display: flex;
    gap: 16px;
    align-items: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .strip-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-cyan);
    background-color: rgba(255, 255, 255, 0.09);
  }

  .strip-card-img-box {
    width: 130px;
    height: 90px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    background-color: #0c233c;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .strip-card-icon-box {
    background: linear-gradient(135deg, #071c34 0%, #15325b 100%);
    border: 1px solid rgba(5, 135, 189, 0.4);
  }

  .strip-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .strip-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .strip-date {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-cyan);
  }

  .strip-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .strip-location {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.75);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .strip-card-link {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-cyan);
    text-decoration: none;
    margin-top: 0.3rem;
  }

  /* Bottom Row 3 Columns */
  .home-bottom-row {
    padding: 5rem 0 6rem;
    background-color: var(--color-bg-light);
  }

  .bottom-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 42px;
  }

  .bottom-col {
    display: flex;
    flex-direction: column;
  }

  .col-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 3px solid var(--color-cyan);
    margin-bottom: 2rem;
  }

  .col-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .col-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-cyan);
    text-decoration: none;
  }

  .projects-mini-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .mini-proj-item {
    background: #ffffff;
